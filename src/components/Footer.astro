---
import { SITE_CONFIG } from '../config';
import servicesData from '../content/services.json';
import locationsData from '../content/locations.json';

const primaryServices = servicesData.filter((s: any) => s.primary);
const secondaryServices = servicesData.filter((s: any) => !s.primary).slice(0, 4);
---

<footer class="bg-dark text-white py-16">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-12 mb-12">
      <!-- Company Info -->
      <div>
        <a href="/" class="flex items-center gap-2 mb-4">
          <div class="w-12 h-12 bg-primary rounded-full flex items-center justify-center text-white font-bold text-xl border-2 border-white">
            <i class="fa-solid fa-trowel-bricks"></i>
          </div>
          <div class="flex flex-col">
            <span class="text-white font-display font-bold text-xl leading-none tracking-wide">DEPTFORD</span>
            <span class="text-accent text-xs font-bold tracking-widest uppercase">CONCRETE</span>
          </div>
        </a>
        <p class="text-gray-400 text-sm mb-6">{SITE_CONFIG.tagline}</p>
        <div class="flex gap-3">
          <a href="#" class="w-10 h-10 bg-white/10 hover:bg-primary rounded-full flex items-center justify-center transition" aria-label="Facebook">
            <i class="fa-brands fa-facebook-f"></i>
          </a>
          <a href="#" class="w-10 h-10 bg-white/10 hover:bg-primary rounded-full flex items-center justify-center transition" aria-label="Instagram">
            <i class="fa-brands fa-instagram"></i>
          </a>
          <a href="#" class="w-10 h-10 bg-white/10 hover:bg-primary rounded-full flex items-center justify-center transition" aria-label="Google">
            <i class="fa-brands fa-google"></i>
          </a>
        </div>
      </div>

      <!-- Services -->
      <div>
        <h4 class="font-display font-bold text-lg mb-4 uppercase">Services</h4>
        <ul class="space-y-2 text-gray-400 text-sm">
          {primaryServices.map((service: any) => (
            <li>
              <a href={`/services/${service.slug}`} class="hover:text-accent transition flex items-center gap-2">
                <i class="fa-solid fa-chevron-right text-primary text-xs"></i>
                {service.name}
              </a>
            </li>
          ))}
          {secondaryServices.map((service: any) => (
            <li>
              <a href={`/services/${service.slug}`} class="hover:text-accent transition flex items-center gap-2">
                <i class="fa-solid fa-chevron-right text-primary text-xs"></i>
                {service.name}
              </a>
            </li>
          ))}
          <li>
            <a href="/services" class="hover:text-accent transition font-medium text-primary">
              View All Services <i class="fa-solid fa-arrow-right text-xs ml-1"></i>
            </a>
          </li>
        </ul>
      </div>

      <!-- Service Areas -->
      <div>
        <h4 class="font-display font-bold text-lg mb-4 uppercase">Service Areas</h4>
        <ul class="space-y-2 text-gray-400 text-sm">
          {locationsData.slice(0, 6).map((location: any) => (
            <li>
              <a href={`/locations/${location.slug}`} class="hover:text-accent transition flex items-center gap-2">
                <i class="fa-solid fa-location-dot text-primary text-xs"></i>
                {location.name}, NJ
              </a>
            </li>
          ))}
          <li>
            <a href="/locations" class="hover:text-accent transition font-medium text-primary">
              All Service Areas <i class="fa-solid fa-arrow-right text-xs ml-1"></i>
            </a>
          </li>
        </ul>
      </div>

      <!-- Contact -->
      <div>
        <h4 class="font-display font-bold text-lg mb-4 uppercase">Contact</h4>
        <ul class="space-y-3 text-gray-400 text-sm">
          {SITE_CONFIG.phone && (
            <li class="flex items-start gap-3">
              <i class="fa-solid fa-phone text-accent mt-1"></i>
              <a href={`tel:${SITE_CONFIG.phone}`} class="hover:text-accent transition">{SITE_CONFIG.phone}</a>
            </li>
          )}
          {SITE_CONFIG.email && (
            <li class="flex items-start gap-3">
              <i class="fa-solid fa-envelope text-accent mt-1"></i>
              <a href={`mailto:${SITE_CONFIG.email}`} class="hover:text-accent transition">{SITE_CONFIG.email}</a>
            </li>
          )}
          <li class="flex items-start gap-3">
            <i class="fa-solid fa-location-dot text-accent mt-1"></i>
            <span>Deptford, NJ<br />Gloucester County</span>
          </li>
          <li class="flex items-start gap-3">
            <i class="fa-solid fa-clock text-accent mt-1"></i>
            <span>Mon - Sat: 7AM - 6PM<br />Sun: Closed</span>
          </li>
        </ul>

        <a href="/contact" class="inline-flex items-center gap-2 bg-primary text-white px-5 py-2.5 rounded font-bold text-sm hover:bg-primary-dark transition mt-6">
          Get Free Estimate <i class="fa-solid fa-arrow-right"></i>
        </a>
      </div>
    </div>

    <div class="border-t border-white/10 pt-8 flex flex-col md:flex-row justify-between items-center gap-4 text-sm text-gray-400">
      <p>&copy; {new Date().getFullYear()} {SITE_CONFIG.name}. All rights reserved.</p>
      <div class="flex gap-6">
        <a href="/about" class="hover:text-accent transition">About Us</a>
        <a href="/contact" class="hover:text-accent transition">Contact</a>
        <a href="/gallery" class="hover:text-accent transition">Gallery</a>
      </div>
    </div>
  </div>
</footer>
