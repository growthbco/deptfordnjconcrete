---
import BaseLayout from '../layouts/BaseLayout.astro';
import ContactForm from '../components/ContactForm.astro';
import { SITE_CONFIG } from '../config';
import servicesData from '../content/services.json';
import locationsData from '../content/locations.json';
import { generateHomeAndConstructionBusinessSchema, generateBreadcrumbSchema } from '../utils/schema';

const primaryServices = servicesData.filter((s: any) => s.primary);
const otherServices = servicesData.filter((s: any) => !s.primary);

const localBusinessSchema = generateHomeAndConstructionBusinessSchema();

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [
    {
      '@type': 'Question',
      name: 'Do you specialize in pole barn foundations?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Yes, pole barn foundations are our primary specialty. We have extensive experience installing concrete foundations for pole barns and post-frame buildings throughout Deptford, NJ and surrounding areas.'
      }
    },
    {
      '@type': 'Question',
      name: 'How much does a pole barn foundation cost?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Pole barn foundation costs vary based on size, soil conditions, and local requirements. We provide free estimates for all pole barn foundation projects. Contact us for a detailed quote.'
      }
    },
    {
      '@type': 'Question',
      name: 'Do you install large commercial concrete slabs?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Yes, we specialize in large commercial and industrial concrete slab installation. We handle projects of all sizes, from small business foundations to large warehouse floors.'
      }
    },
    {
      '@type': 'Question',
      name: 'What areas do you serve?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: `We serve ${SITE_CONFIG.serviceAreas.join(', ')} and surrounding areas in New Jersey.`
      }
    },
    {
      '@type': 'Question',
      name: 'Do you offer free estimates?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Yes, we offer free, no-obligation estimates for all concrete projects. Contact us today to schedule your free estimate.'
      }
    }
  ]
};
---

<BaseLayout
  title="Pole Barn Foundation, Stamped Concrete & Large Slab Contractors in Deptford, NJ"
  description="Professional pole barn foundation specialists, stamped concrete experts, and commercial concrete contractors serving Deptford, NJ. Free estimates on all concrete projects."
  schema={[localBusinessSchema, faqSchema]}
  transparentHeader={true}
>
  <!-- Hero Section -->
  <section class="relative min-h-[800px] w-full bg-gray-900 overflow-hidden">
    <!-- Background Image -->
    <div class="absolute inset-0 z-0">
      <img
        src="/images/polebarns/IMG_9021.webp"
        class="w-full h-full object-cover opacity-60"
        alt="Pole barn foundation installation in Deptford, New Jersey"
        fetchpriority="high"
        width="1920"
        height="1080"
      />
      <div class="absolute inset-0 bg-gradient-to-r from-black/80 via-black/40 to-transparent"></div>
    </div>

    <div class="relative z-10 max-w-7xl mx-auto h-full px-4 sm:px-6 lg:px-8 flex items-center py-32">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 w-full items-center">

        <!-- Hero Content -->
        <div class="lg:col-span-7">
          <p class="text-accent font-bold tracking-wide mb-2 uppercase text-sm">
            <i class="fa-solid fa-star mr-1"></i> 5-Star Concrete Contractors in South Jersey
          </p>
          <h1 class="text-4xl lg:text-6xl xl:text-7xl font-bold text-white mb-6 uppercase leading-tight font-display">
            Concrete Contractors <br />
            <span class="text-transparent bg-clip-text bg-gradient-to-r from-primary to-amber-400">in Deptford, NJ</span>
          </h1>
          <p class="text-gray-200 text-lg mb-8 max-w-xl font-light">
            Deptford Concrete Contractors: Your trusted partner for pole barn foundations, commercial slabs, and beautiful stamped concrete in Gloucester County. Quality craftsmanship since 2019.
          </p>

          <div class="space-y-3 mb-10">
            <div class="flex items-center gap-3 text-white">
              <i class="fa-solid fa-circle-check text-accent"></i>
              <span class="font-medium">Pole Barn Foundation Specialists</span>
            </div>
            <div class="flex items-center gap-3 text-white">
              <i class="fa-solid fa-circle-check text-accent"></i>
              <span class="font-medium">Locally Owned & Operated</span>
            </div>
            <div class="flex items-center gap-3 text-white">
              <i class="fa-solid fa-circle-check text-accent"></i>
              <span class="font-medium">Fast and Reliable Installs</span>
            </div>
            <div class="flex items-center gap-3 text-white">
              <i class="fa-solid fa-circle-check text-accent"></i>
              <span class="font-medium">Free Estimates Within 24-48 Hours</span>
            </div>
          </div>

          {SITE_CONFIG.phone && (
            <a href={`tel:${SITE_CONFIG.phone}`} class="inline-flex items-center gap-3 bg-white text-gray-900 px-6 py-3 rounded font-bold hover:bg-gray-100 transition shadow-lg">
              <i class="fa-solid fa-phone text-primary"></i> {SITE_CONFIG.phone}
            </a>
          )}
        </div>

        <!-- Hero Form -->
        <div class="lg:col-span-5">
          <ContactForm title="Get Your Free Estimate" variant="hero" />
        </div>
      </div>
    </div>
  </section>

  <!-- Stats/Trust Bar -->
  <section class="bg-dark py-8 border-t border-white/10">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-2 md:grid-cols-4 gap-6 md:gap-8">
        <div class="flex items-center gap-4 justify-center">
          <div class="w-12 h-12 bg-primary/20 rounded-full flex items-center justify-center flex-shrink-0">
            <i class="fa-solid fa-hard-hat text-primary text-xl"></i>
          </div>
          <div>
            <div class="text-2xl font-bold text-white font-display">100+</div>
            <div class="text-gray-400 text-sm">Projects Completed</div>
          </div>
        </div>
        <div class="flex items-center gap-4 justify-center">
          <div class="w-12 h-12 bg-primary/20 rounded-full flex items-center justify-center flex-shrink-0">
            <i class="fa-solid fa-star text-primary text-xl"></i>
          </div>
          <div>
            <div class="text-2xl font-bold text-white font-display">5.0</div>
            <div class="text-gray-400 text-sm">Star Rating</div>
          </div>
        </div>
        <div class="flex items-center gap-4 justify-center">
          <div class="w-12 h-12 bg-primary/20 rounded-full flex items-center justify-center flex-shrink-0">
            <i class="fa-solid fa-shield-halved text-primary text-xl"></i>
          </div>
          <div>
            <div class="text-2xl font-bold text-white font-display">Fully</div>
            <div class="text-gray-400 text-sm">Licensed & Insured</div>
          </div>
        </div>
        <div class="flex items-center gap-4 justify-center">
          <div class="w-12 h-12 bg-primary/20 rounded-full flex items-center justify-center flex-shrink-0">
            <i class="fa-solid fa-calendar-check text-primary text-xl"></i>
          </div>
          <div>
            <div class="text-2xl font-bold text-white font-display">2019</div>
            <div class="text-gray-400 text-sm">Established</div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Services Section -->
  <section class="py-24 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-16">
        <span class="text-gray-500 font-medium uppercase tracking-wider text-sm">Our Services</span>
        <h2 class="text-4xl md:text-5xl font-bold text-gray-900 mt-2 uppercase font-display max-w-2xl mx-auto">
          Professional Concrete <br /> Services You Can Trust
        </h2>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        <!-- Service 1: Pole Barn Foundations -->
        <div class="group relative bg-white rounded-xl shadow-lg hover:shadow-2xl transition-all duration-300 overflow-hidden border border-gray-100">
          <div class="h-64 overflow-hidden relative">
            <img src="/images/polebarns/IMG_6480.webp" class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-500" alt="Pole Barn Foundation" width="800" height="600" />
            <div class="absolute top-4 left-4 w-12 h-12 bg-white rounded-full flex items-center justify-center text-primary text-xl shadow-md">
              <i class="fa-solid fa-warehouse"></i>
            </div>
          </div>
          <div class="p-8">
            <h3 class="text-2xl font-bold text-gray-900 mb-3 font-display uppercase">Pole Barn Foundations</h3>
            <p class="text-gray-600 mb-6">Our specialty! Expert foundation installation for pole barns and post-frame buildings throughout South Jersey.</p>
            <a href="/services/pole-barn-foundations" class="block w-full bg-primary text-white text-center py-3 rounded font-bold hover:bg-primary-dark transition uppercase text-sm">
              Learn More <i class="fa-solid fa-arrow-right ml-2"></i>
            </a>
          </div>
        </div>

        <!-- Service 2: Commercial Slabs -->
        <div class="group relative bg-white rounded-xl shadow-lg hover:shadow-2xl transition-all duration-300 overflow-hidden border border-gray-100">
          <div class="h-64 overflow-hidden relative">
            <img src="/images/projects/IMG_3907.webp" class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-500" alt="Commercial Concrete Slab" width="800" height="600" />
            <div class="absolute top-4 left-4 w-12 h-12 bg-white rounded-full flex items-center justify-center text-primary text-xl shadow-md">
              <i class="fa-solid fa-building"></i>
            </div>
          </div>
          <div class="p-8">
            <h3 class="text-2xl font-bold text-gray-900 mb-3 font-display uppercase">Commercial Slabs</h3>
            <p class="text-gray-600 mb-6">Large-scale concrete solutions for warehouses, manufacturing, and commercial properties.</p>
            <a href="/services/concrete-slabs" class="block w-full bg-primary text-white text-center py-3 rounded font-bold hover:bg-primary-dark transition uppercase text-sm">
              Learn More <i class="fa-solid fa-arrow-right ml-2"></i>
            </a>
          </div>
        </div>

        <!-- Service 3: Stamped Concrete -->
        <div class="group relative bg-white rounded-xl shadow-lg hover:shadow-2xl transition-all duration-300 overflow-hidden border border-gray-100">
          <div class="h-64 overflow-hidden relative">
            <img src="/images/projects/IMG_7653.webp" class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-500" alt="Stamped Concrete" width="800" height="600" />
            <div class="absolute top-4 left-4 w-12 h-12 bg-white rounded-full flex items-center justify-center text-primary text-xl shadow-md">
              <i class="fa-solid fa-palette"></i>
            </div>
          </div>
          <div class="p-8">
            <h3 class="text-2xl font-bold text-gray-900 mb-3 font-display uppercase">Stamped Concrete</h3>
            <p class="text-gray-600 mb-6">Beautiful decorative patterns for patios, driveways, and walkways that enhance curb appeal.</p>
            <a href="/services/stamped-concrete" class="block w-full bg-primary text-white text-center py-3 rounded font-bold hover:bg-primary-dark transition uppercase text-sm">
              Learn More <i class="fa-solid fa-arrow-right ml-2"></i>
            </a>
          </div>
        </div>
      </div>

      <!-- All Services Banner -->
      <div class="mt-20 bg-gray-50 rounded-2xl p-8 md:p-12 flex flex-col md:flex-row items-center justify-between gap-8 border border-gray-200">
        <div class="flex items-center gap-6">
          <div class="hidden md:block">
            <i class="fa-solid fa-medal text-6xl text-gray-300"></i>
          </div>
          <div>
            <div class="flex items-center gap-2 mb-2">
              <i class="fa-solid fa-award text-accent text-2xl"></i>
              <span class="font-bold text-gray-900 uppercase tracking-wide">Complete Concrete Solutions</span>
            </div>
            <p class="text-gray-600 max-w-2xl text-sm md:text-base leading-relaxed">
              From driveways and patios to retaining walls and pool decks, we offer comprehensive concrete services. Every project is backed by our commitment to quality craftsmanship and customer satisfaction.
            </p>
          </div>
        </div>
        <a href="/services" class="bg-primary hover:bg-primary-dark text-white px-8 py-3 rounded font-bold transition whitespace-nowrap uppercase text-sm flex items-center gap-2">
          Explore All <i class="fa-solid fa-arrow-right"></i>
        </a>
      </div>
    </div>
  </section>

  <!-- How It Works -->
  <section class="py-24 bg-gray-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-16">
        <span class="text-gray-500 font-medium uppercase tracking-wider text-sm">How It Works</span>
        <h2 class="text-4xl md:text-5xl font-bold text-gray-900 mt-2 uppercase font-display">
          3 Simple Steps
        </h2>
        <p class="text-gray-600 mt-4 max-w-2xl mx-auto text-lg">
          From your first call to the finished pour, we make the process straightforward and stress-free.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-8 relative">
        <!-- Connector line (desktop only) -->
        <div class="hidden md:block absolute top-16 left-[20%] right-[20%] h-0.5 bg-gray-200 z-0"></div>

        <!-- Step 1 -->
        <div class="relative text-center">
          <div class="w-32 h-32 bg-white rounded-full flex items-center justify-center mx-auto mb-6 shadow-lg border-4 border-primary relative z-10">
            <div class="text-center">
              <span class="text-4xl font-bold text-primary font-display">1</span>
            </div>
          </div>
          <h3 class="text-xl font-bold text-gray-900 mb-3 font-display uppercase">Request Your Free Estimate</h3>
          <p class="text-gray-600 max-w-xs mx-auto">Call us or fill out our contact form. We respond to every estimate request within 24-48 hours.</p>
        </div>

        <!-- Step 2 -->
        <div class="relative text-center">
          <div class="w-32 h-32 bg-white rounded-full flex items-center justify-center mx-auto mb-6 shadow-lg border-4 border-primary relative z-10">
            <div class="text-center">
              <span class="text-4xl font-bold text-primary font-display">2</span>
            </div>
          </div>
          <h3 class="text-xl font-bold text-gray-900 mb-3 font-display uppercase">Get Your Custom Plan</h3>
          <p class="text-gray-600 max-w-xs mx-auto">We visit your site, assess the project scope, and provide a detailed quote with honest, transparent pricing.</p>
        </div>

        <!-- Step 3 -->
        <div class="relative text-center">
          <div class="w-32 h-32 bg-white rounded-full flex items-center justify-center mx-auto mb-6 shadow-lg border-4 border-primary relative z-10">
            <div class="text-center">
              <span class="text-4xl font-bold text-primary font-display">3</span>
            </div>
          </div>
          <h3 class="text-xl font-bold text-gray-900 mb-3 font-display uppercase">We Build It Right</h3>
          <p class="text-gray-600 max-w-xs mx-auto">Our crew handles everything from site prep to finishing. On time, on budget, and built to last through New Jersey weather.</p>
        </div>
      </div>

      <div class="text-center mt-12">
        <a href="/contact" class="inline-flex items-center gap-2 bg-primary text-white px-8 py-4 rounded font-bold hover:bg-primary-dark transition uppercase text-sm shadow-lg">
          Get Your Free Estimate <i class="fa-solid fa-arrow-right"></i>
        </a>
      </div>
    </div>
  </section>

  <!-- Featured Gallery -->
  <section class="py-24 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-16">
        <span class="text-gray-500 font-medium uppercase tracking-wider text-sm">Our Work</span>
        <h2 class="text-4xl md:text-5xl font-bold text-gray-900 mt-2 uppercase font-display">
          Recent Projects
        </h2>
      </div>

      <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-4">
        <a href="/gallery" class="group relative aspect-square overflow-hidden rounded-lg">
          <img src="/images/polebarns/IMG_6471.webp" class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-500" alt="Pole barn foundation" loading="lazy" width="400" height="400" />
          <div class="absolute inset-0 bg-black/40 opacity-0 group-hover:opacity-100 transition-opacity flex items-center justify-center">
            <i class="fa-solid fa-expand text-white text-2xl"></i>
          </div>
        </a>
        <a href="/gallery" class="group relative aspect-square overflow-hidden rounded-lg">
          <img src="/images/projects/IMG_7649.webp" class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-500" alt="Stamped concrete patio" loading="lazy" width="400" height="400" />
          <div class="absolute inset-0 bg-black/40 opacity-0 group-hover:opacity-100 transition-opacity flex items-center justify-center">
            <i class="fa-solid fa-expand text-white text-2xl"></i>
          </div>
        </a>
        <a href="/gallery" class="group relative aspect-square overflow-hidden rounded-lg">
          <img src="/images/projects/IMG_5164.webp" class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-500" alt="Commercial concrete" loading="lazy" width="400" height="400" />
          <div class="absolute inset-0 bg-black/40 opacity-0 group-hover:opacity-100 transition-opacity flex items-center justify-center">
            <i class="fa-solid fa-expand text-white text-2xl"></i>
          </div>
        </a>
        <a href="/gallery" class="group relative aspect-square overflow-hidden rounded-lg">
          <img src="/images/projects/IMG_7656.webp" class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-500" alt="Decorative concrete" loading="lazy" width="400" height="400" />
          <div class="absolute inset-0 bg-black/40 opacity-0 group-hover:opacity-100 transition-opacity flex items-center justify-center">
            <i class="fa-solid fa-expand text-white text-2xl"></i>
          </div>
        </a>
        <a href="/gallery" class="group relative aspect-square overflow-hidden rounded-lg hidden md:block">
          <img src="/images/polebarns/IMG_6472.webp" class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-500" alt="Foundation work" loading="lazy" width="400" height="400" />
          <div class="absolute inset-0 bg-black/40 opacity-0 group-hover:opacity-100 transition-opacity flex items-center justify-center">
            <i class="fa-solid fa-expand text-white text-2xl"></i>
          </div>
        </a>
        <a href="/gallery" class="group relative aspect-square overflow-hidden rounded-lg hidden md:block">
          <img src="/images/projects/IMG_9889.webp" class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-500" alt="Concrete project" loading="lazy" width="400" height="400" />
          <div class="absolute inset-0 bg-black/40 opacity-0 group-hover:opacity-100 transition-opacity flex items-center justify-center">
            <i class="fa-solid fa-expand text-white text-2xl"></i>
          </div>
        </a>
        <a href="/gallery" class="group relative aspect-square overflow-hidden rounded-lg hidden lg:block">
          <img src="/images/projects/IMG_3401.webp" class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-500" alt="Concrete installation" loading="lazy" width="400" height="400" />
          <div class="absolute inset-0 bg-black/40 opacity-0 group-hover:opacity-100 transition-opacity flex items-center justify-center">
            <i class="fa-solid fa-expand text-white text-2xl"></i>
          </div>
        </a>
        <a href="/gallery" class="group relative aspect-square overflow-hidden rounded-lg hidden lg:flex bg-primary items-center justify-center">
          <div class="text-center text-white p-6">
            <i class="fa-solid fa-images text-4xl mb-3"></i>
            <p class="font-display font-bold uppercase">View All Projects</p>
          </div>
        </a>
      </div>
    </div>
  </section>

  <!-- Testimonials -->
  <section class="py-24 bg-gray-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-16">
        <span class="text-gray-500 font-medium uppercase tracking-wider text-sm">Testimonials</span>
        <h2 class="text-4xl md:text-5xl font-bold text-gray-900 mt-2 uppercase font-display">
          What Our Customers Say
        </h2>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        <!-- Testimonial 1 -->
        <div class="bg-white rounded-2xl shadow-lg p-8 relative">
          <div class="absolute -top-4 left-8">
            <div class="w-12 h-12 bg-primary rounded-full flex items-center justify-center text-white text-xl shadow-md">
              <i class="fa-solid fa-quote-left"></i>
            </div>
          </div>
          <div class="flex text-accent mb-4 mt-4">
            <i class="fa-solid fa-star"></i>
            <i class="fa-solid fa-star"></i>
            <i class="fa-solid fa-star"></i>
            <i class="fa-solid fa-star"></i>
            <i class="fa-solid fa-star"></i>
          </div>
          <p class="text-gray-700 mb-6 leading-relaxed">"Absolutely fantastic work on our pole barn foundation. The crew was professional, showed up on time, and the finished product exceeded our expectations. They really know their stuff when it comes to post-frame building foundations."</p>
          <div class="border-t pt-4">
            <div class="flex items-center gap-4">
              <div class="w-12 h-12 bg-gray-200 rounded-full flex items-center justify-center text-gray-500 font-bold text-lg">M</div>
              <div>
                <p class="font-bold text-gray-900">Mike R.</p>
                <p class="text-sm text-gray-500">Deptford, NJ</p>
                <p class="text-sm text-primary font-medium">Pole Barn Foundation</p>
              </div>
            </div>
          </div>
        </div>

        <!-- Testimonial 2 -->
        <div class="bg-white rounded-2xl shadow-lg p-8 relative">
          <div class="absolute -top-4 left-8">
            <div class="w-12 h-12 bg-primary rounded-full flex items-center justify-center text-white text-xl shadow-md">
              <i class="fa-solid fa-quote-left"></i>
            </div>
          </div>
          <div class="flex text-accent mb-4 mt-4">
            <i class="fa-solid fa-star"></i>
            <i class="fa-solid fa-star"></i>
            <i class="fa-solid fa-star"></i>
            <i class="fa-solid fa-star"></i>
            <i class="fa-solid fa-star"></i>
          </div>
          <p class="text-gray-700 mb-6 leading-relaxed">"We had a stamped concrete patio installed and it looks amazing! The team was very knowledgeable about the different patterns and colors available. Our neighbors keep asking who did the work."</p>
          <div class="border-t pt-4">
            <div class="flex items-center gap-4">
              <div class="w-12 h-12 bg-gray-200 rounded-full flex items-center justify-center text-gray-500 font-bold text-lg">J</div>
              <div>
                <p class="font-bold text-gray-900">Jennifer S.</p>
                <p class="text-sm text-gray-500">Washington Township, NJ</p>
                <p class="text-sm text-primary font-medium">Stamped Concrete Patio</p>
              </div>
            </div>
          </div>
        </div>

        <!-- Testimonial 3 -->
        <div class="bg-white rounded-2xl shadow-lg p-8 relative">
          <div class="absolute -top-4 left-8">
            <div class="w-12 h-12 bg-primary rounded-full flex items-center justify-center text-white text-xl shadow-md">
              <i class="fa-solid fa-quote-left"></i>
            </div>
          </div>
          <div class="flex text-accent mb-4 mt-4">
            <i class="fa-solid fa-star"></i>
            <i class="fa-solid fa-star"></i>
            <i class="fa-solid fa-star"></i>
            <i class="fa-solid fa-star"></i>
            <i class="fa-solid fa-star"></i>
          </div>
          <p class="text-gray-700 mb-6 leading-relaxed">"Needed a large concrete slab for our warehouse expansion. Deptford Concrete handled the entire project professionally from start to finish. The quality of work was excellent and they finished ahead of schedule."</p>
          <div class="border-t pt-4">
            <div class="flex items-center gap-4">
              <div class="w-12 h-12 bg-gray-200 rounded-full flex items-center justify-center text-gray-500 font-bold text-lg">R</div>
              <div>
                <p class="font-bold text-gray-900">Robert T.</p>
                <p class="text-sm text-gray-500">Glassboro, NJ</p>
                <p class="text-sm text-primary font-medium">Commercial Slab</p>
              </div>
            </div>
          </div>
        </div>
      </div>

