---
import BaseLayout from '../layouts/BaseLayout.astro';
import ContactForm from '../components/ContactForm.astro';
import { SITE_CONFIG } from '../config';
import servicesData from '../content/services.json';
import locationsData from '../content/locations.json';
import { generateHomeAndConstructionBusinessSchema } from '../utils/schema';

const primaryServices = servicesData.filter((s: any) => s.primary);
const otherServices = servicesData.filter((s: any) => !s.primary);

const localBusinessSchema = generateHomeAndConstructionBusinessSchema();

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [
    {
      '@type': 'Question',
      name: 'Do you specialize in pole barn foundations?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Yes, pole barn foundations are our primary specialty. We have extensive experience installing concrete foundations for pole barns and post-frame buildings throughout Deptford, NJ and surrounding areas.'
      }
    },
    {
      '@type': 'Question',
      name: 'How much does a pole barn foundation cost?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Pole barn foundation costs vary based on size, soil conditions, and local requirements. We provide free estimates for all pole barn foundation projects. Contact us for a detailed quote.'
      }
    },
    {
      '@type': 'Question',
      name: 'Do you install large commercial concrete slabs?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Yes, we specialize in large commercial and industrial concrete slab installation. We handle projects of all sizes, from small business foundations to large warehouse floors.'
      }
    },
    {
      '@type': 'Question',
      name: 'What areas do you serve?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: `We serve ${SITE_CONFIG.serviceAreas.join(', ')} and surrounding areas in New Jersey.`
      }
    },
    {
      '@type': 'Question',
      name: 'Do you offer free estimates?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Yes, we offer free, no-obligation estimates for all concrete projects. Contact us today to schedule your free estimate.'
      }
    }
  ]
};
---

<BaseLayout
  title="Pole Barn Foundation, Stamped Concrete & Large Slab Contractors in Deptford, NJ"
  description="Professional pole barn foundation specialists, stamped concrete experts, and commercial concrete contractors serving Deptford, NJ. Free estimates on all concrete projects."
  schema={localBusinessSchema}
  transparentHeader={true}
>
  <!-- Hero Section -->
  <section class="relative min-h-[800px] w-full bg-gray-900 overflow-hidden">
    <!-- Background Image -->
    <div class="absolute inset-0 z-0">
      <img
        src="/images/polebarns/IMG_9021.webp"
        class="w-full h-full object-cover opacity-60"
        alt="Pole barn foundation installation in Deptford, New Jersey"
        fetchpriority="high"
      />
      <div class="absolute inset-0 bg-gradient-to-r from-black/80 via-black/40 to-transparent"></div>
    </div>

    <div class="relative z-10 max-w-7xl mx-auto h-full px-4 sm:px-6 lg:px-8 flex items-center py-32">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 w-full items-center">

        <!-- Hero Content -->
        <div class="lg:col-span-7">
          <p class="text-accent font-bold tracking-wide mb-2 uppercase text-sm">
            <i class="fa-solid fa-star mr-1"></i> 5-Star Concrete Contractors in South Jersey
          </p>
          <h1 class="text-4xl lg:text-6xl xl:text-7xl font-bold text-white mb-6 uppercase leading-tight font-display">
            Your Trusted Local <br />
            <span class="text-transparent bg-clip-text bg-gradient-to-r from-primary to-amber-400">Concrete Contractor</span>
          </h1>
          <p class="text-gray-200 text-lg mb-8 max-w-xl font-light">
            Deptford Concrete Contractors: Your trusted partner for pole barn foundations, commercial slabs, and beautiful stamped concrete in Gloucester County. Quality craftsmanship since 2019.
          </p>

          <div class="space-y-3 mb-10">
            <div class="flex items-center gap-3 text-white">
              <i class="fa-solid fa-circle-check text-accent"></i>
              <span class="font-medium">Pole Barn Foundation Specialists</span>
            </div>
            <div class="flex items-center gap-3 text-white">
              <i class="fa-solid fa-circle-check text-accent"></i>
              <span class="font-medium">Locally Owned & Operated</span>
            </div>
            <div class="flex items-center gap-3 text-white">
              <i class="fa-solid fa-circle-check text-accent"></i>
              <span class="font-medium">Fast and Reliable Installs</span>
            </div>
            <div class="flex items-center gap-3 text-white">
              <i class="fa-solid fa-circle-check text-accent"></i>
              <span class="font-medium">Free Estimates Within 24-48 Hours</span>
            </div>
          </div>

          {SITE_CONFIG.phone && (
            <a href={`tel:${SITE_CONFIG.phone}`} class="inline-flex items-center gap-3 bg-white text-gray-900 px-6 py-3 rounded font-bold hover:bg-gray-100 transition shadow-lg">
              <i class="fa-solid fa-phone text-primary"></i> {SITE_CONFIG.phone}
            </a>
          )}
        </div>

        <!-- Hero Form -->
        <div class="lg:col-span-5">
          <ContactForm title="Get Your Free Estimate" variant="hero" />
        </div>
      </div>
    </div>
  </section>

  <!-- Services Section -->
  <section class="py-24 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-16">
        <span class="text-gray-500 font-medium uppercase tracking-wider text-sm">Our Services</span>
        <h2 class="text-4xl md:text-5xl font-bold text-gray-900 mt-2 uppercase font-display max-w-2xl mx-auto">
          Professional Concrete <br /> Services You Can Trust
        </h2>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        <!-- Service 1: Pole Barn Foundations -->
        <div class="group relative bg-white rounded-xl shadow-lg hover:shadow-2xl transition-all duration-300 overflow-hidden border border-gray-100">
          <div class="h-64 overflow-hidden relative">
            <img src="/images/polebarns/IMG_6480.webp" class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-500" alt="Pole Barn Foundation" />
            <div class="absolute top-4 left-4 w-12 h-12 bg-white rounded-full flex items-center justify-center text-primary text-xl shadow-md">
              <i class="fa-solid fa-warehouse"></i>
            </div>
          </div>
          <div class="p-8">
            <h3 class="text-2xl font-bold text-gray-900 mb-3 font-display uppercase">Pole Barn Foundations</h3>
            <p class="text-gray-600 mb-6">Our specialty! Expert foundation installation for pole barns and post-frame buildings throughout South Jersey.</p>
            <a href="/services/pole-barn-foundations" class="block w-full bg-primary text-white text-center py-3 rounded font-bold hover:bg-primary-dark transition uppercase text-sm">
              Learn More <i class="fa-solid fa-arrow-right ml-2"></i>
            </a>
          </div>
        </div>

        <!-- Service 2: Commercial Slabs -->
        <div class="group relative bg-white rounded-xl shadow-lg hover:shadow-2xl transition-all duration-300 overflow-hidden border border-gray-100">
          <div class="h-64 overflow-hidden relative">
            <img src="/images/projects/IMG_3907.webp" class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-500" alt="Commercial Concrete Slab" />
            <div class="absolute top-4 left-4 w-12 h-12 bg-white rounded-full flex items-center justify-center text-primary text-xl shadow-md">
              <i class="fa-solid fa-building"></i>
            </div>
          </div>
          <div class="p-8">
            <h3 class="text-2xl font-bold text-gray-900 mb-3 font-display uppercase">Commercial Slabs</h3>
            <p class="text-gray-600 mb-6">Large-scale concrete solutions for warehouses, manufacturing, and commercial properties.</p>
            <a href="/services/concrete-slabs" class="block w-full bg-primary text-white text-center py-3 rounded font-bold hover:bg-primary-dark transition uppercase text-sm">
              Learn More <i class="fa-solid fa-arrow-right ml-2"></i>
            </a>
          </div>
        </div>

        <!-- Service 3: Stamped Concrete -->
        <div class="group relative bg-white rounded-xl shadow-lg hover:shadow-2xl transition-all duration-300 overflow-hidden border border-gray-100">
          <div class="h-64 overflow-hidden relative">
            <img src="/images/projects/IMG_7653.webp" class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-500" alt="Stamped Concrete" />
            <div class="absolute top-4 left-4 w-12 h-12 bg-white rounded-full flex items-center justify-center text-primary text-xl shadow-md">
              <i class="fa-solid fa-palette"></i>
            </div>
          </div>
          <div class="p-8">
            <h3 class="text-2xl font-bold text-gray-900 mb-3 font-display uppercase">Stamped Concrete</h3>
            <p class="text-gray-600 mb-6">Beautiful decorative patterns for patios, driveways, and walkways that enhance curb appeal.</p>
            <a href="/services/stamped-concrete" class="block w-full bg-primary text-white text-center py-3 rounded font-bold hover:bg-primary-dark transition uppercase text-sm">
              Learn More <i class="fa-solid fa-arrow-right ml-2"></i>
            </a>
          </div>
        </div>
      </div>

      <!-- All Services Banner -->
      <div class="mt-20 bg-gray-50 rounded-2xl p-8 md:p-12 flex flex-col md:flex-row items-center justify-between gap-8 border border-gray-200">
        <div class="flex items-center gap-6">
          <div class="hidden md:block">
            <i class="fa-solid fa-medal text-6xl text-gray-300"></i>
          </div>
          <div>
            <div class="flex items-center gap-2 mb-2">
              <i class="fa-solid fa-award text-accent text-2xl"></i>
              <span class="font-bold text-gray-900 uppercase tracking-wide">Complete Concrete Solutions</span>
            </div>
            <p class="text-gray-600 max-w-2xl text-sm md:text-base leading-relaxed">
              From driveways and patios to retaining walls and pool decks, we offer comprehensive concrete services. Every project is backed by our commitment to quality craftsmanship and customer satisfaction.
            </p>
          </div>
        </div>
        <a href="/services" class="bg-primary hover:bg-primary-dark text-white px-8 py-3 rounded font-bold transition whitespace-nowrap uppercase text-sm flex items-center gap-2">
          Explore All <i class="fa-solid fa-arrow-right"></i>
        </a>
      </div>
    </div>
  </section>

  <!-- Featured Gallery -->
  <section class="py-24 bg-gray-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-16">
        <span class="text-gray-500 font-medium uppercase tracking-wider text-sm">Our Work</span>
        <h2 class="text-4xl md:text-5xl font-bold text-gray-900 mt-2 uppercase font-display">
          Recent Projects
        </h2>
      </div>

      <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-4">
        <a href="/gallery" class="group relative aspect-square overflow-hidden rounded-lg">
          <img src="/images/polebarns/IMG_6471.webp" class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-500" alt="Pole barn foundation" loading="lazy" />
          <div class="absolute inset-0 bg-black/40 opacity-0 group-hover:opacity-100 transition-opacity flex items-center justify-center">
            <i class="fa-solid fa-expand text-white text-2xl"></i>
          </div>
        </a>
        <a href="/gallery" class="group relative aspect-square overflow-hidden rounded-lg">
          <img src="/images/projects/IMG_7649.webp" class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-500" alt="Stamped concrete patio" loading="lazy" />
          <div class="absolute inset-0 bg-black/40 opacity-0 group-hover:opacity-100 transition-opacity flex items-center justify-center">
            <i class="fa-solid fa-expand text-white text-2xl"></i>
          </div>
        </a>
        <a href="/gallery" class="group relative aspect-square overflow-hidden rounded-lg">
          <img src="/images/projects/IMG_5164.webp" class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-500" alt="Commercial concrete" loading="lazy" />
          <div class="absolute inset-0 bg-black/40 opacity-0 group-hover:opacity-100 transition-opacity flex items-center justify-center">
            <i class="fa-solid fa-expand text-white text-2xl"></i>
          </div>
        </a>
        <a href="/gallery" class="group relative aspect-square overflow-hidden rounded-lg">
          <img src="/images/projects/IMG_7656.webp" class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-500" alt="Decorative concrete" loading="lazy" />
          <div class="absolute inset-0 bg-black/40 opacity-0 group-hover:opacity-100 transition-opacity flex items-center justify-center">
            <i class="fa-solid fa-expand text-white text-2xl"></i>
          </div>
        </a>
        <a href="/gallery" class="group relative aspect-square overflow-hidden rounded-lg hidden md:block">
          <img src="/images/polebarns/IMG_6472.webp" class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-500" alt="Foundation work" loading="lazy" />
          <div class="absolute inset-0 bg-black/40 opacity-0 group-hover:opacity-100 transition-opacity flex items-center justify-center">
            <i class="fa-solid fa-expand text-white text-2xl"></i>
          </div>
        </a>
        <a href="/gallery" class="group relative aspect-square overflow-hidden rounded-lg hidden md:block">
          <img src="/images/projects/IMG_9889.webp" class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-500" alt="Concrete project" loading="lazy" />
          <div class="absolute inset-0 bg-black/40 opacity-0 group-hover:opacity-100 transition-opacity flex items-center justify-center">
            <i class="fa-solid fa-expand text-white text-2xl"></i>
          </div>
        </a>
        <a href="/gallery" class="group relative aspect-square overflow-hidden rounded-lg hidden lg:block">
          <img src="/images/projects/IMG_3401.webp" class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-500" alt="Concrete installation" loading="lazy" />
          <div class="absolute inset-0 bg-black/40 opacity-0 group-hover:opacity-100 transition-opacity flex items-center justify-center">
            <i class="fa-solid fa-expand text-white text-2xl"></i>
          </div>
        </a>
        <a href="/gallery" class="group relative aspect-square overflow-hidden rounded-lg hidden lg:flex bg-primary items-center justify-center">
          <div class="text-center text-white p-6">
            <i class="fa-solid fa-images text-4xl mb-3"></i>
            <p class="font-display font-bold uppercase">View All Projects</p>
          </div>
        </a>
      </div>
    </div>
  </section>

  <!-- Why Choose Us -->
  <section class="py-24 bg-dark text-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-16">
        <span class="text-gray-400 font-medium uppercase tracking-wider text-sm">Why Choose Us</span>
        <h2 class="text-4xl md:text-5xl font-bold text-white mt-2 uppercase font-display">
          The Deptford Difference
        </h2>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        <div class="text-center p-8">
          <div class="w-20 h-20 bg-primary/20 rounded-full flex items-center justify-center mx-auto mb-6">
            <i class="fa-solid fa-medal text-primary text-3xl"></i>
          </div>
          <h3 class="text-xl font-bold mb-3 font-display uppercase">Pole Barn Specialists</h3>
          <p class="text-gray-400">Our primary specialty is pole barn foundations. We understand the unique requirements of post-frame construction.</p>
        </div>

        <div class="text-center p-8">
          <div class="w-20 h-20 bg-primary/20 rounded-full flex items-center justify-center mx-auto mb-6">
            <i class="fa-solid fa-map-location-dot text-primary text-3xl"></i>
          </div>
          <h3 class="text-xl font-bold mb-3 font-display uppercase">Locally Owned</h3>
          <p class="text-gray-400">Based in Gloucester County, we understand local soil conditions, weather patterns, and building codes.</p>
        </div>

        <div class="text-center p-8">
          <div class="w-20 h-20 bg-primary/20 rounded-full flex items-center justify-center mx-auto mb-6">
            <i class="fa-solid fa-clock text-primary text-3xl"></i>
          </div>
          <h3 class="text-xl font-bold mb-3 font-display uppercase">Fast Response</h3>
          <p class="text-gray-400">We respond to estimate requests within 24-48 hours. Clear communication from start to finish.</p>
        </div>

        <div class="text-center p-8">
          <div class="w-20 h-20 bg-primary/20 rounded-full flex items-center justify-center mx-auto mb-6">
            <i class="fa-solid fa-shield-halved text-primary text-3xl"></i>
          </div>
          <h3 class="text-xl font-bold mb-3 font-display uppercase">Fully Licensed & Insured</h3>
          <p class="text-gray-400">Professional coverage for all residential and commercial projects throughout our service area.</p>
        </div>

        <div class="text-center p-8">
          <div class="w-20 h-20 bg-primary/20 rounded-full flex items-center justify-center mx-auto mb-6">
            <i class="fa-solid fa-comments-dollar text-primary text-3xl"></i>
          </div>
          <h3 class="text-xl font-bold mb-3 font-display uppercase">Honest Pricing</h3>
          <p class="text-gray-400">Transparent quotes with no hidden fees. Free estimates on all projects.</p>
        </div>

        <div class="text-center p-8">
          <div class="w-20 h-20 bg-primary/20 rounded-full flex items-center justify-center mx-auto mb-6">
            <i class="fa-solid fa-hammer text-primary text-3xl"></i>
          </div>
          <h3 class="text-xl font-bold mb-3 font-display uppercase">Quality Craftsmanship</h3>
          <p class="text-gray-400">Built to last through New Jersey's freeze-thaw cycles, humidity, and seasonal weather changes.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Service Areas -->
  <section class="py-24 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-16">
        <span class="text-gray-500 font-medium uppercase tracking-wider text-sm">Service Areas</span>
        <h2 class="text-4xl md:text-5xl font-bold text-gray-900 mt-2 uppercase font-display">
          Serving Gloucester County
        </h2>
      </div>

      <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-4">
        {locationsData.map((location: any) => (
          <a href={`/locations/${location.slug}`} class="group flex items-center gap-3 p-4 bg-gray-50 rounded-lg hover:bg-primary hover:text-white transition-all duration-300">
            <i class="fa-solid fa-location-dot text-primary group-hover:text-white"></i>
            <span class="font-medium">{location.name}, NJ</span>
          </a>
        ))}
      </div>

      <div class="text-center mt-10">
        <a href="/locations" class="inline-flex items-center gap-2 text-primary font-bold hover:underline">
          View All Service Areas <i class="fa-solid fa-arrow-right"></i>
        </a>
      </div>
    </div>
  </section>

  <!-- FAQ Section -->
  <section class="py-24 bg-gray-50">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-16">
        <span class="text-gray-500 font-medium uppercase tracking-wider text-sm">FAQ</span>
        <h2 class="text-4xl md:text-5xl font-bold text-gray-900 mt-2 uppercase font-display">
          Common Questions
        </h2>
      </div>

      <div class="space-y-4">
        <div class="bg-white p-6 rounded-lg shadow-sm border border-gray-100">
          <h3 class="text-lg font-bold text-gray-900 mb-2 font-display">Do you specialize in pole barn foundations?</h3>
          <p class="text-gray-600">Yes, pole barn foundations are our primary specialty. We have extensive experience installing concrete foundations for pole barns and post-frame buildings throughout Deptford, NJ and surrounding areas.</p>
        </div>

        <div class="bg-white p-6 rounded-lg shadow-sm border border-gray-100">
          <h3 class="text-lg font-bold text-gray-900 mb-2 font-display">How much does a pole barn foundation cost?</h3>
          <p class="text-gray-600">Pole barn foundation costs vary based on size, soil conditions, and local requirements. We provide free estimates for all pole barn foundation projects. Contact us for a detailed quote.</p>
        </div>

        <div class="bg-white p-6 rounded-lg shadow-sm border border-gray-100">
          <h3 class="text-lg font-bold text-gray-900 mb-2 font-display">Do you install large commercial concrete slabs?</h3>
          <p class="text-gray-600">Yes, we specialize in large commercial and industrial concrete slab installation. We handle projects of all sizes, from small business foundations to large warehouse floors.</p>
        </div>

        <div class="bg-white p-6 rounded-lg shadow-sm border border-gray-100">
          <h3 class="text-lg font-bold text-gray-900 mb-2 font-display">What areas do you serve?</h3>
          <p class="text-gray-600">We serve {SITE_CONFIG.serviceAreas.join(', ')} and surrounding areas in New Jersey.</p>
        </div>

        <div class="bg-white p-6 rounded-lg shadow-sm border border-gray-100">
          <h3 class="text-lg font-bold text-gray-900 mb-2 font-display">Do you offer free estimates?</h3>
          <p class="text-gray-600">Yes, we offer free, no-obligation estimates for all concrete projects. Contact us today to schedule your free estimate.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA Section -->
  <section class="py-24 bg-primary">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="text-3xl md:text-4xl font-bold text-white mb-6 font-display uppercase">Ready to Start Your Project?</h2>
      <p class="text-white/80 text-lg mb-8 max-w-2xl mx-auto">
        Get your free estimate today. We respond within 24-48 hours and provide honest, transparent pricing.
      </p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a href="/contact" class="inline-flex items-center justify-center gap-2 bg-white text-gray-900 px-8 py-4 rounded font-bold hover:bg-gray-100 transition">
          Get Free Estimate <i class="fa-solid fa-arrow-right"></i>
        </a>
        {SITE_CONFIG.phone && (
          <a href={`tel:${SITE_CONFIG.phone}`} class="inline-flex items-center justify-center gap-2 bg-transparent text-white px-8 py-4 rounded font-bold border-2 border-white hover:bg-white hover:text-gray-900 transition">
            <i class="fa-solid fa-phone"></i> {SITE_CONFIG.phone}
          </a>
        )}
      </div>
    </div>
  </section>
</BaseLayout>
