---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ContactForm from '../../components/ContactForm.astro';
import RelatedServices from '../../components/RelatedServices.astro';
import ServiceAreasLink from '../../components/ServiceAreasLink.astro';
import { SITE_CONFIG } from '../../config';
import { generateServiceSchema, generateBreadcrumbSchema, generateFAQSchema } from '../../utils/schema';

const serviceSchema = generateServiceSchema('walkways', 'Professional concrete walkway and pathway installation in Deptford, NJ. Durable walkways with free estimates.');

const breadcrumbSchema = generateBreadcrumbSchema([
  { name: 'Home', url: 'https://deptfordnjconcrete.com/' },
  { name: 'Services', url: 'https://deptfordnjconcrete.com/services/' },
  { name: 'Concrete Walkways', url: 'https://deptfordnjconcrete.com/services/walkways/' }
]);

const galleryImages = [
  { src: '/images/projects/IMG_7654.webp', alt: 'Concrete walkway installation in Deptford, NJ', label: 'Stamped Walkway' },
  { src: '/images/projects/IMG_7655.webp', alt: 'Professional walkway project', label: 'Pathway Installation' },
  { src: '/images/projects/IMG_5168.webp', alt: 'Concrete walkway contractor work', label: 'Quality Workmanship' },
  { src: '/images/projects/IMG_5600.webp', alt: 'Residential walkway installation', label: 'Residential Walkway' },
  { src: '/images/projects/IMG_5602.webp', alt: 'Concrete pathway project', label: 'Concrete Pathway' },
  { src: '/images/projects/IMG_9885.webp', alt: 'Walkway installation service', label: 'Expert Installation' }
];

const faqs = [
  { q: 'How wide should a concrete walkway be?', a: 'Residential walkways are typically 3-4 feet wide, while commercial sidewalks may need to be wider to meet accessibility requirements. We\'ll recommend the appropriate width during your free estimate.' },
  { q: 'How long does walkway installation take?', a: 'Most walkway installations are completed within 1-2 days, depending on length and complexity. We\'ll provide a detailed timeline during your free estimate.' },
  { q: 'Do I need a permit for a new walkway?', a: 'Permit requirements vary by municipality. Public sidewalks typically require permits, while private walkways may not. We\'ll check local requirements and assist with permit applications if needed.' },
  { q: 'Can walkways be repaired instead of replaced?', a: 'Yes, we can often repair existing walkways if the damage is limited. We\'ll assess your walkway during the free estimate and recommend the best solution.' },
  { q: 'Are concrete walkways slippery in winter?', a: 'We use textured finishes that provide better traction than smooth surfaces. However, all surfaces can be slippery when icy, so proper snow removal is important.' }
];

const faqSchema = generateFAQSchema(faqs);
---

<BaseLayout
  title="Concrete Walkway Installation in Deptford, NJ"
  description="Professional concrete walkway contractors serving Deptford, NJ. Residential pathways, commercial sidewalks, and garden walkways. Quality installation and repairs available."
  schema={[serviceSchema, faqSchema, breadcrumbSchema]}
>
  <!-- Hero Section -->
  <section class="bg-dark py-20 md:py-28">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <p class="section-subheading text-primary mb-4">Walkway Services</p>
      <h1 class="text-4xl md:text-5xl lg:text-6xl font-bold text-white uppercase font-display mb-6">
        Concrete Walkway Installation
      </h1>
      <p class="text-xl text-gray-300 max-w-3xl mx-auto mb-8">
        Professional walkway installation services for residential and commercial properties. Enhance your property with durable concrete pathways.
      </p>
      <a href="#contact-form" class="btn-primary text-lg">
        Get Free Walkway Estimate
        <i class="fa-solid fa-arrow-right"></i>
      </a>
    </div>
  </section>

  <!-- Gallery Section -->
  <section class="py-16 md:py-24 bg-gray-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-12">
        <p class="section-subheading text-primary mb-4">Our Work</p>
        <h2 class="section-heading mb-6">Our Walkway Projects</h2>
        <p class="text-lg text-gray-600 max-w-3xl mx-auto">
          See our quality walkway installations throughout Deptford and surrounding areas.
        </p>
      </div>

      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
        {galleryImages.map(image => (
          <div class="group relative aspect-[4/3] rounded-xl overflow-hidden shadow-lg hover:shadow-2xl transition-all hover:-translate-y-2">
            <img src={image.src} alt={image.alt} loading="lazy" class="w-full h-full object-cover" width="800" height="600" />
            <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/20 to-transparent opacity-0 group-hover:opacity-100 transition-opacity flex items-end p-4">
              <p class="text-white font-semibold">{image.label}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Content Section -->
  <section class="py-16 md:py-24 bg-white">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-3xl md:text-4xl font-bold text-gray-900 font-display uppercase mb-8">
        Professional Walkway Services
      </h2>
      <p class="text-lg text-gray-600 mb-8">
        We install beautiful, durable concrete walkways that enhance your property's appearance and functionality. From front entry walkways to garden pathways, we create safe, attractive paths for your home or business.
      </p>

      <h3 class="text-2xl font-bold text-primary font-display uppercase mt-10 mb-4">What's Included in Our Walkway Service</h3>
      <div class="bg-orange-50 border-l-4 border-primary rounded-lg p-6 mb-8">
        <ul class="space-y-2">
          {[
            'Free Design Consultation - We discuss your needs and help design the perfect walkway path',
            'Custom Design - Walkway design tailored to your property and preferences',
            'Site Preparation - Proper excavation, grading, and base preparation',
            'Quality Materials - High-grade concrete mixes for New Jersey\'s climate',
            'Professional Installation - Expert installation by experienced professionals',
            'Proper Drainage - Correct slope to prevent water pooling and ice buildup',
            'Safety Features - Textured finishes for slip resistance',
            'Expansion Joints - Properly placed to prevent cracking',
            'Cleanup - Complete site cleanup after installation',
            'Code Compliance - All work meets local sidewalk and walkway requirements'
          ].map(item => (
            <li class="flex items-start gap-2">
              <i class="fa-solid fa-check-circle text-primary mt-1"></i>
              <span>{item}</span>
            </li>
          ))}
        </ul>
      </div>

      <h3 class="text-2xl font-bold text-primary font-display uppercase mt-10 mb-4">Our Walkway Installation Process</h3>
      <div class="space-y-4 mb-8">
        {[
          { num: '1', title: 'Design Consultation', desc: 'We discuss your needs and create a walkway design' },
          { num: '2', title: 'Site Evaluation', desc: 'We assess your property and drainage patterns' },
          { num: '3', title: 'Excavation & Base', desc: 'Professional excavation and base material installation' },
          { num: '4', title: 'Formwork', desc: 'Installation of forms to create your walkway shape' },
          { num: '5', title: 'Concrete Pouring', desc: 'Placement of high-quality concrete mix' },
          { num: '6', title: 'Finishing & Curing', desc: 'Textured finishing for slip resistance and proper curing' }
        ].map(step => (
          <div class="flex items-start gap-4 bg-gray-50 rounded-lg p-4">
            <div class="w-10 h-10 bg-primary text-white rounded-full flex items-center justify-center font-bold flex-shrink-0">{step.num}</div>
            <div>
              <h4 class="font-bold text-lg">{step.title}</h4>
              <p class="text-gray-600">{step.desc}</p>
            </div>
          </div>
        ))}
      </div>

      <h3 class="text-2xl font-bold text-primary font-display uppercase mt-10 mb-4">Common Issues Walkways Solve</h3>
      <div class="grid md:grid-cols-2 gap-4 mb-8">
        {[
          { icon: 'fa-cloud-rain', title: 'Mud and Mess', desc: 'Create clean, dry pathways that eliminate mud during wet weather' },
          { icon: 'fa-person-falling', title: 'Safety Concerns', desc: 'Provide safe, level walking surfaces that prevent trips and falls' },
          { icon: 'fa-door-open', title: 'Property Access', desc: 'Create clear pathways connecting driveways, patios, and entrances' },
          { icon: 'fa-file-contract', title: 'Code Compliance', desc: 'Meet local requirements for sidewalks and pedestrian pathways' },
          { icon: 'fa-home', title: 'Curb Appeal', desc: 'Well-designed walkways enhance property appearance and value' },
          { icon: 'fa-wheelchair', title: 'Accessibility', desc: 'Improve property accessibility for all users' }
        ].map(item => (
          <div class="flex items-start gap-4 p-4 bg-gray-50 rounded-lg">
            <div class="w-10 h-10 bg-primary/10 rounded-full flex items-center justify-center flex-shrink-0">
              <i class={`fa-solid ${item.icon} text-primary`}></i>
            </div>
            <div>
              <h4 class="font-bold">{item.title}</h4>
              <p class="text-gray-600 text-sm">{item.desc}</p>
            </div>
          </div>
        ))}
      </div>

      <h3 class="text-2xl font-bold text-primary font-display uppercase mt-10 mb-4">Walkway Styles & Options</h3>
      <div class="grid md:grid-cols-2 gap-4 mb-8">
        {[
          { title: 'Standard Concrete', desc: 'Durable, textured finish for most applications', link: null },
          { title: 'Stamped Concrete', desc: 'Decorative patterns and textures', link: '/services/stamped-concrete' },
          { title: 'Colored Concrete', desc: 'Custom colors to match your property', link: '/services/stained-concrete' },
          { title: 'Commercial Sidewalks', desc: 'Code-compliant sidewalks for businesses', link: null }
        ].map(style => (
          <div class="bg-gray-50 rounded-lg p-4 border-l-4 border-primary">
            <h4 class="font-bold mb-1">{style.title}</h4>
            <p class="text-gray-600 text-sm">{style.desc}</p>
            {style.link && <a href={style.link} class="text-primary text-sm font-semibold hover:underline">Learn more →</a>}
          </div>
        ))}
      </div>

      <h3 class="text-2xl font-bold text-primary font-display uppercase mt-10 mb-4">Areas We Serve</h3>
      <p class="text-gray-600 mb-6">
        We provide walkway installation services throughout <a href="/locations/deptford-nj" class="text-primary font-semibold hover:underline">Deptford</a>, <a href="/locations/west-deptford-nj" class="text-primary font-semibold hover:underline">West Deptford</a>, <a href="/locations/woodbury-nj" class="text-primary font-semibold hover:underline">Woodbury</a>, <a href="/locations/glassboro-nj" class="text-primary font-semibold hover:underline">Glassboro</a>, and <a href="/locations" class="text-primary font-semibold hover:underline">all surrounding Gloucester County communities</a>.
      </p>
    </div>
  </section>

  <RelatedServices currentService="walkways" />
  <ServiceAreasLink serviceName="Walkways" />

  <!-- Contact Form Section -->
  <section id="contact-form" class="py-16 md:py-24 bg-gray-50">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
      <ContactForm title="Get Your Free Walkway Estimate" service="walkways" />
    </div>
  </section>

  <!-- FAQ Section -->
  <section class="py-16 md:py-24 bg-white">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-12">
        <p class="section-subheading text-primary mb-4">Common Questions</p>
        <h2 class="section-heading">Walkway FAQs</h2>
      </div>
      <div class="space-y-4">
        {faqs.map(faq => (
          <div class="bg-gray-50 rounded-xl p-6 border-l-4 border-primary">
            <h3 class="font-bold text-lg text-gray-900 mb-2">{faq.q}</h3>
            <p class="text-gray-600">{faq.a}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA Section -->
  <section class="py-16 md:py-20 bg-primary">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="text-3xl md:text-4xl font-bold text-white font-display uppercase mb-6">
        Ready for a New Walkway?
      </h2>
      <p class="text-xl text-white/90 mb-8">
        Contact us today for a free estimate. No obligation, just honest pricing.
      </p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a href="#contact-form" class="btn-secondary">Get Your Free Estimate <i class="fa-solid fa-arrow-right"></i></a>
        {SITE_CONFIG.phone && <a href={`tel:${SITE_CONFIG.phone}`} class="btn-outline"><i class="fa-solid fa-phone"></i> {SITE_CONFIG.phone}</a>}
      </div>
    </div>
  </section>
</BaseLayout>
