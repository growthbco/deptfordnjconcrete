---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ContactForm from '../../components/ContactForm.astro';
import RelatedServices from '../../components/RelatedServices.astro';
import ServiceAreasLink from '../../components/ServiceAreasLink.astro';
import { SITE_CONFIG } from '../../config';
import { generateServiceSchema } from '../../utils/schema';

const serviceSchema = generateServiceSchema('patios', 'Custom concrete patio design and installation in Deptford, NJ. Professional patio contractors with free estimates.');

const galleryImages = [
  { src: '/images/projects/IMG_7649.webp', alt: 'Concrete patio installation in Deptford, NJ', label: 'Stamped Concrete Patio' },
  { src: '/images/projects/IMG_7655.webp', alt: 'Decorative patio project', label: 'Decorative Patio' },
  { src: '/images/projects/IMG_7656.webp', alt: 'Outdoor patio installation', label: 'Outdoor Living Space' },
  { src: '/images/projects/IMG_7657.webp', alt: 'Professional patio work', label: 'Professional Installation' },
  { src: '/images/projects/IMG_3401.webp', alt: 'Concrete patio project', label: 'Custom Patio Design' },
  { src: '/images/projects/IMG_3402.webp', alt: 'Patio installation service', label: 'Quality Workmanship' }
];

const faqs = [
  { q: 'How long does a concrete patio last?', a: 'A properly installed concrete patio can last 25-30 years or more with proper maintenance. Our patios are designed for New Jersey\'s climate.' },
  { q: 'How long does patio installation take?', a: 'Most patio installations are completed within 1-2 days, depending on size and complexity.' },
  { q: 'Can I add a patio to an existing deck or structure?', a: 'Yes, we can design and install patios that integrate with existing structures.' },
  { q: 'Do I need a permit for a new patio?', a: 'Permit requirements vary by municipality and patio size. We\'ll check local requirements and assist with permits if needed.' },
  { q: 'What\'s the difference between a standard and stamped concrete patio?', a: 'Standard concrete patios have a smooth or brushed finish. Stamped concrete patios feature decorative patterns that mimic stone, brick, or other materials.' }
];
---

<BaseLayout
  title="Concrete Patio Installation in Deptford, NJ | Custom Patios"
  description="Custom concrete patio design and installation experts in Deptford, NJ. Stamped, colored, and decorative patio options. Transform your outdoor living space."
  schema={serviceSchema}
>
  <!-- Hero Section -->
  <section class="bg-dark py-20 md:py-28">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <p class="section-subheading text-primary mb-4">Patio Services</p>
      <h1 class="text-4xl md:text-5xl lg:text-6xl font-bold text-white uppercase font-display mb-6">
        Custom Concrete Patio Installation
      </h1>
      <p class="text-xl text-gray-300 max-w-3xl mx-auto mb-8">
        Professional patio design and installation services. Create the perfect outdoor living space with our expert concrete patio contractors.
      </p>
      <a href="#contact-form" class="btn-primary text-lg">
        Get Free Patio Estimate
        <i class="fa-solid fa-arrow-right"></i>
      </a>
    </div>
  </section>

  <!-- Gallery Section -->
  <section class="py-16 md:py-24 bg-gray-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-12">
        <p class="section-subheading text-primary mb-4">Our Work</p>
        <h2 class="section-heading mb-6">Our Patio Projects</h2>
        <p class="text-lg text-gray-600 max-w-3xl mx-auto">
          See our beautiful concrete patio installations throughout Deptford and surrounding areas.
        </p>
      </div>

      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
        {galleryImages.map(image => (
          <div class="group relative aspect-[4/3] rounded-xl overflow-hidden shadow-lg hover:shadow-2xl transition-all hover:-translate-y-2">
            <img src={image.src} alt={image.alt} loading="lazy" class="w-full h-full object-cover" width="800" height="600" />
            <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/20 to-transparent opacity-0 group-hover:opacity-100 transition-opacity flex items-end p-4">
              <p class="text-white font-semibold">{image.label}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Content Section -->
  <section class="py-16 md:py-24 bg-white">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-3xl md:text-4xl font-bold text-gray-900 font-display uppercase mb-8">
        Custom Patio Services
      </h2>
      <p class="text-lg text-gray-600 mb-8">
        Transform your outdoor space with a beautiful, durable concrete patio. We design and install custom patios that complement your home and lifestyle.
      </p>

      <h3 class="text-2xl font-bold text-primary font-display uppercase mt-10 mb-4">What's Included in Our Patio Service</h3>
      <div class="bg-orange-50 border-l-4 border-primary rounded-lg p-6 mb-8">
        <ul class="space-y-2">
          {[
            'Free Design Consultation - We discuss your vision and help design the perfect patio',
            'Custom Design - Patio design tailored to your property and preferences',
            'Site Preparation - Proper excavation, grading, and base preparation',
            'Quality Materials - High-grade concrete mixes for outdoor use',
            'Professional Installation - Expert installation by experienced professionals',
            'Drainage Planning - Proper slope to prevent water pooling',
            'Finishing Options - Smooth, brushed, stamped, or decorative finishes',
            'Cleanup - Complete site cleanup after installation'
          ].map(item => (
            <li class="flex items-start gap-2">
              <i class="fa-solid fa-check-circle text-primary mt-1"></i>
              <span>{item}</span>
            </li>
          ))}
        </ul>
      </div>

      <h3 class="text-2xl font-bold text-primary font-display uppercase mt-10 mb-4">Our Patio Installation Process</h3>
      <div class="space-y-4 mb-8">
        {[
          { num: '1', title: 'Design Consultation', desc: 'We discuss your needs and create a custom patio design' },
          { num: '2', title: 'Site Evaluation', desc: 'We assess your property and drainage patterns' },
          { num: '3', title: 'Excavation & Base', desc: 'Professional excavation and base material installation' },
          { num: '4', title: 'Formwork', desc: 'Installation of forms to create your patio shape' },
          { num: '5', title: 'Concrete Pouring', desc: 'Placement of high-quality concrete mix' },
          { num: '6', title: 'Finishing & Curing', desc: 'Proper finishing based on your chosen style' }
        ].map(step => (
          <div class="flex items-start gap-4 bg-gray-50 rounded-lg p-4">
            <div class="w-10 h-10 bg-primary text-white rounded-full flex items-center justify-center font-bold flex-shrink-0">{step.num}</div>
            <div>
              <h4 class="font-bold text-lg">{step.title}</h4>
              <p class="text-gray-600">{step.desc}</p>
            </div>
          </div>
        ))}
      </div>

      <h3 class="text-2xl font-bold text-primary font-display uppercase mt-10 mb-4">Patio Styles & Options</h3>
      <div class="grid md:grid-cols-2 gap-4 mb-8">
        {[
          { title: 'Standard Concrete', desc: 'Durable, smooth or brushed finish', link: null },
          { title: 'Stamped Concrete', desc: 'Decorative patterns mimicking stone or brick', link: '/services/stamped-concrete' },
          { title: 'Stained Concrete', desc: 'Custom colors for enhanced design', link: '/services/stained-concrete' },
          { title: 'Multi-Level Patios', desc: 'Tiered designs for sloped properties', link: null }
        ].map(style => (
          <div class="bg-gray-50 rounded-lg p-4 border-l-4 border-primary">
            <h4 class="font-bold mb-1">{style.title}</h4>
            <p class="text-gray-600 text-sm">{style.desc}</p>
            {style.link && <a href={style.link} class="text-primary text-sm font-semibold hover:underline">Learn more →</a>}
          </div>
        ))}
      </div>

      <h3 class="text-2xl font-bold text-primary font-display uppercase mt-10 mb-4">Areas We Serve</h3>
      <p class="text-gray-600 mb-6">
        We provide patio installation services throughout <a href="/locations/deptford-nj" class="text-primary font-semibold hover:underline">Deptford</a>, <a href="/locations/west-deptford-nj" class="text-primary font-semibold hover:underline">West Deptford</a>, <a href="/locations/woodbury-nj" class="text-primary font-semibold hover:underline">Woodbury</a>, <a href="/locations/glassboro-nj" class="text-primary font-semibold hover:underline">Glassboro</a>, and <a href="/locations" class="text-primary font-semibold hover:underline">all surrounding Gloucester County communities</a>.
      </p>
    </div>
  </section>

  <RelatedServices currentService="patios" />
  <ServiceAreasLink serviceName="Patios" />

  <!-- Contact Form Section -->
  <section id="contact-form" class="py-16 md:py-24 bg-gray-50">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
      <ContactForm title="Get Your Free Patio Estimate" service="patios" />
    </div>
  </section>

  <!-- FAQ Section -->
  <section class="py-16 md:py-24 bg-white">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-12">
        <p class="section-subheading text-primary mb-4">Common Questions</p>
        <h2 class="section-heading">Patio FAQs</h2>
      </div>
      <div class="space-y-4">
        {faqs.map(faq => (
          <div class="bg-gray-50 rounded-xl p-6 border-l-4 border-primary">
            <h3 class="font-bold text-lg text-gray-900 mb-2">{faq.q}</h3>
            <p class="text-gray-600">{faq.a}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA Section -->
  <section class="py-16 md:py-20 bg-primary">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="text-3xl md:text-4xl font-bold text-white font-display uppercase mb-6">
        Ready for a New Patio?
      </h2>
      <p class="text-xl text-white/90 mb-8">
        Contact us today for a free estimate. No obligation, just honest pricing.
      </p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a href="#contact-form" class="btn-secondary">Get Your Free Estimate <i class="fa-solid fa-arrow-right"></i></a>
        {SITE_CONFIG.phone && <a href={`tel:${SITE_CONFIG.phone}`} class="btn-outline"><i class="fa-solid fa-phone"></i> {SITE_CONFIG.phone}</a>}
      </div>
    </div>
  </section>
</BaseLayout>
