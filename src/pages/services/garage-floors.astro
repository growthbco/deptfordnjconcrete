---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ContactForm from '../../components/ContactForm.astro';
import RelatedServices from '../../components/RelatedServices.astro';
import ServiceAreasLink from '../../components/ServiceAreasLink.astro';
import { SITE_CONFIG } from '../../config';
import { generateServiceSchema } from '../../utils/schema';

const serviceSchema = generateServiceSchema('garage-floors', 'Professional garage floor installation, repair, and resurfacing in Deptford, NJ. Perfect for winter projects. Durable garage floors with decorative options.');

const galleryImages = [
  { src: '/images/projects/IMG_3907.webp', alt: 'Garage floor installation in Deptford, NJ', label: 'Garage Floor' },
  { src: '/images/projects/IMG_3910.webp', alt: 'Professional garage floor project', label: 'Professional Installation' },
  { src: '/images/projects/IMG_3911.webp', alt: 'Garage floor repair work', label: 'Floor Repair' },
  { src: '/images/projects/IMG_5164.webp', alt: 'Resurfaced garage floor', label: 'Resurfacing' },
  { src: '/images/projects/IMG_5165.webp', alt: 'Decorative garage floor', label: 'Decorative Floor' },
  { src: '/images/projects/IMG_3403.webp', alt: 'Garage floor service', label: 'Quality Service' }
];

const faqs = [
  { q: 'How much does a garage floor cost?', a: 'Garage floor costs vary based on size, condition of existing floor, and finishing options. New installation typically ranges from $3-$7 per square foot, while resurfacing may cost $3-$6 per square foot. We provide free estimates for accurate pricing.' },
  { q: 'Can garage floors be installed in winter?', a: 'Yes! Garage floor installation is perfect for winter since garages are enclosed. Work proceeds regardless of outdoor weather conditions, making winter an ideal time for garage projects.' },
  { q: 'Can you repair an existing garage floor instead of replacing it?', a: 'Yes, we can often repair or resurface existing garage floors if the damage is limited. We\'ll assess your floor during the free estimate and recommend repair or replacement.' },
  { q: 'How long does garage floor installation take?', a: 'Most garage floor installations are completed within 1-2 days, depending on size and complexity. Resurfacing projects may take 1 day. We\'ll provide a timeline during your free estimate.' },
  { q: 'Do garage floors need special sealers?', a: 'Garage floors benefit from sealers that resist oil, chemicals, and wear. We use appropriate sealers designed for garage applications to protect your investment.' }
];
---

<BaseLayout
  title="Garage Floor Installation & Repair in Deptford, NJ | Winter Projects"
  description="Expert garage floor contractors in Deptford, NJ. Garage floor installation, repair, resurfacing, and decorative options. Perfect for winter projects. Free estimates."
  schema={serviceSchema}
>
  <!-- Hero Section -->
  <section class="bg-dark py-20 md:py-28">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <p class="section-subheading text-primary mb-4">Garage Floor Services</p>
      <h1 class="text-4xl md:text-5xl lg:text-6xl font-bold text-white uppercase font-display mb-6">
        Garage Floor Installation & Repair
      </h1>
      <p class="text-xl text-gray-300 max-w-3xl mx-auto mb-8">
        Professional garage floor services including installation, repair, resurfacing, and decorative options. Perfect for winter projects.
      </p>
      <a href="#contact-form" class="btn-primary text-lg">
        Get Free Garage Floor Estimate
        <i class="fa-solid fa-arrow-right"></i>
      </a>
    </div>
  </section>

  <!-- Winter Highlight Banner -->
  <section class="py-6 bg-orange-50 border-y-2 border-primary">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex items-start gap-4">
        <div class="w-12 h-12 bg-primary rounded-full flex items-center justify-center flex-shrink-0">
          <i class="fa-solid fa-snowflake text-white text-xl"></i>
        </div>
        <div>
          <h3 class="text-lg font-bold text-primary mb-1">Winter is Perfect for Garage Projects</h3>
          <p class="text-gray-700 mb-2">Garage floor work is ideal for winter months. Since garages are enclosed, work proceeds regardless of freezing temperatures, snow, or rain outside.</p>
          <p class="text-gray-600 text-sm"><strong>Benefits:</strong> No weather delays • Better scheduling availability • Faster project starts • Ideal time for garage improvements</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Gallery Section -->
  <section class="py-16 md:py-24 bg-gray-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-12">
        <p class="section-subheading text-primary mb-4">Our Work</p>
        <h2 class="section-heading mb-6">Our Garage Floor Projects</h2>
        <p class="text-lg text-gray-600 max-w-3xl mx-auto">
          See our quality garage floor installations throughout Deptford and surrounding areas.
        </p>
      </div>

      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
        {galleryImages.map(image => (
          <div class="group relative aspect-[4/3] rounded-xl overflow-hidden shadow-lg hover:shadow-2xl transition-all hover:-translate-y-2">
            <img src={image.src} alt={image.alt} loading="lazy" class="w-full h-full object-cover" width="800" height="600" />
            <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/20 to-transparent opacity-0 group-hover:opacity-100 transition-opacity flex items-end p-4">
              <p class="text-white font-semibold">{image.label}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Content Section -->
  <section class="py-16 md:py-24 bg-white">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-3xl md:text-4xl font-bold text-gray-900 font-display uppercase mb-8">
        Professional Garage Floor Services
      </h2>
      <p class="text-lg text-gray-600 mb-8">
        Your garage floor takes a lot of abuse - from vehicles to storage to workshop activities. We provide professional garage floor services including new installation, repair, resurfacing, and decorative options that stand up to heavy use.
      </p>

      <h3 class="text-2xl font-bold text-primary font-display uppercase mt-10 mb-4">Garage Floor Services We Provide</h3>
      <div class="bg-orange-50 border-l-4 border-primary rounded-lg p-6 mb-8">
        <ul class="space-y-2">
          {[
            'New Garage Floor Installation - Complete installation for new construction or additions',
            'Garage Floor Repair - Crack repair, spalling repair, and damage restoration',
            'Garage Floor Resurfacing - Resurface worn floors with overlay systems',
            'Garage Floor Leveling - Level uneven floors for better functionality',
            'Decorative Garage Floors - Stained or polished concrete for finished garages',
            'Garage Floor Sealing - Professional sealing against oil, chemicals, and wear',
            'Epoxy Coating - Durable epoxy coatings for high-performance floors'
          ].map(item => (
            <li class="flex items-start gap-2">
              <i class="fa-solid fa-check-circle text-primary mt-1"></i>
              <span>{item}</span>
            </li>
          ))}
        </ul>
      </div>

      <h3 class="text-2xl font-bold text-primary font-display uppercase mt-10 mb-4">Our Installation Process</h3>
      <div class="space-y-4 mb-8">
        {[
          { num: '1', title: 'Site Evaluation', desc: 'We assess your garage and existing floor condition' },
          { num: '2', title: 'Moisture Testing', desc: 'Evaluation of moisture levels if needed' },
          { num: '3', title: 'Surface Preparation', desc: 'Removal of old flooring and proper preparation' },
          { num: '4', title: 'Moisture Barrier', desc: 'Installation of vapor barrier if required' },
          { num: '5', title: 'Concrete Pouring', desc: 'Placement of high-quality concrete mix' },
          { num: '6', title: 'Finishing & Sealing', desc: 'Proper finishing and professional sealing' }
        ].map(step => (
          <div class="flex items-start gap-4 bg-gray-50 rounded-lg p-4">
            <div class="w-10 h-10 bg-primary text-white rounded-full flex items-center justify-center font-bold flex-shrink-0">{step.num}</div>
            <div>
              <h4 class="font-bold text-lg">{step.title}</h4>
              <p class="text-gray-600">{step.desc}</p>
            </div>
          </div>
        ))}
      </div>

      <h3 class="text-2xl font-bold text-primary font-display uppercase mt-10 mb-4">Common Problems We Fix</h3>
      <div class="grid md:grid-cols-2 gap-4 mb-8">
        {[
          { icon: 'fa-road-crack', title: 'Cracks', desc: 'Repair cracks before they worsen' },
          { icon: 'fa-layer-group', title: 'Spalling', desc: 'Fix surface flaking and deterioration' },
          { icon: 'fa-ruler-horizontal', title: 'Uneven Surfaces', desc: 'Level uneven floors' },
          { icon: 'fa-oil-can', title: 'Oil Stains', desc: 'Remove or cover oil and chemical stains' },
          { icon: 'fa-droplet', title: 'Moisture Issues', desc: 'Address moisture problems with vapor barriers' },
          { icon: 'fa-brush', title: 'Worn Surfaces', desc: 'Resurface worn floors' }
        ].map(item => (
          <div class="flex items-start gap-4 p-4 bg-gray-50 rounded-lg">
            <div class="w-10 h-10 bg-primary/10 rounded-full flex items-center justify-center flex-shrink-0">
              <i class={`fa-solid ${item.icon} text-primary`}></i>
            </div>
            <div>
              <h4 class="font-bold">{item.title}</h4>
              <p class="text-gray-600 text-sm">{item.desc}</p>
            </div>
          </div>
        ))}
      </div>

      <h3 class="text-2xl font-bold text-primary font-display uppercase mt-10 mb-4">Areas We Serve</h3>
      <p class="text-gray-600 mb-6">
        We provide garage floor services throughout <a href="/locations/deptford-nj" class="text-primary font-semibold hover:underline">Deptford</a>, <a href="/locations/west-deptford-nj" class="text-primary font-semibold hover:underline">West Deptford</a>, <a href="/locations/woodbury-nj" class="text-primary font-semibold hover:underline">Woodbury</a>, <a href="/locations/glassboro-nj" class="text-primary font-semibold hover:underline">Glassboro</a>, and <a href="/locations" class="text-primary font-semibold hover:underline">all surrounding Gloucester County communities</a>.
      </p>
    </div>
  </section>

  <RelatedServices currentService="garage-floors" />
  <ServiceAreasLink serviceName="Garage Floors" />

  <!-- Contact Form Section -->
  <section id="contact-form" class="py-16 md:py-24 bg-gray-50">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
      <ContactForm title="Get Your Free Garage Floor Estimate" service="garage-floors" />
    </div>
  </section>

  <!-- FAQ Section -->
  <section class="py-16 md:py-24 bg-white">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-12">
        <p class="section-subheading text-primary mb-4">Common Questions</p>
        <h2 class="section-heading">Garage Floor FAQs</h2>
      </div>
      <div class="space-y-4">
        {faqs.map(faq => (
          <div class="bg-gray-50 rounded-xl p-6 border-l-4 border-primary">
            <h3 class="font-bold text-lg text-gray-900 mb-2">{faq.q}</h3>
            <p class="text-gray-600">{faq.a}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA Section -->
  <section class="py-16 md:py-20 bg-primary">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="text-3xl md:text-4xl font-bold text-white font-display uppercase mb-6">
        Ready for a New Garage Floor?
      </h2>
      <p class="text-xl text-white/90 mb-8">
        Contact us today for a free estimate. No obligation, just honest pricing.
      </p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a href="#contact-form" class="btn-secondary">Get Your Free Estimate <i class="fa-solid fa-arrow-right"></i></a>
        {SITE_CONFIG.phone && <a href={`tel:${SITE_CONFIG.phone}`} class="btn-outline"><i class="fa-solid fa-phone"></i> {SITE_CONFIG.phone}</a>}
      </div>
    </div>
  </section>
</BaseLayout>
