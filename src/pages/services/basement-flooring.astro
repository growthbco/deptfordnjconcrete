---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ContactForm from '../../components/ContactForm.astro';
import RelatedServices from '../../components/RelatedServices.astro';
import ServiceAreasLink from '../../components/ServiceAreasLink.astro';
import { SITE_CONFIG } from '../../config';
import { generateServiceSchema, generateBreadcrumbSchema, generateFAQSchema } from '../../utils/schema';

const serviceSchema = generateServiceSchema('basement-flooring', 'Professional basement concrete floor installation and repair in Deptford, NJ. Durable basement flooring with free estimates.');

const breadcrumbSchema = generateBreadcrumbSchema([
  { name: 'Home', url: 'https://deptfordnjconcrete.com/' },
  { name: 'Services', url: 'https://deptfordnjconcrete.com/services/' },
  { name: 'Basement Flooring', url: 'https://deptfordnjconcrete.com/services/basement-flooring/' }
]);

const galleryImages = [
  { src: '/images/projects/IMG_3907.webp', alt: 'Basement concrete floor installation in Deptford, NJ', label: 'Basement Floor' },
  { src: '/images/projects/IMG_3910.webp', alt: 'Professional basement floor project', label: 'Professional Installation' },
  { src: '/images/projects/IMG_3911.webp', alt: 'Concrete basement floor contractor work', label: 'Quality Workmanship' },
  { src: '/images/projects/IMG_5164.webp', alt: 'Basement flooring project', label: 'Concrete Flooring' },
  { src: '/images/projects/IMG_5165.webp', alt: 'Basement floor installation', label: 'Expert Installation' },
  { src: '/images/projects/IMG_3403.webp', alt: 'Basement floor service', label: 'Quality Service' }
];

const faqs = [
  { q: 'Do I need a moisture barrier under my basement floor?', a: 'Moisture barriers are often recommended for basement floors to prevent moisture issues. We\'ll assess your basement\'s moisture levels during the free estimate and recommend the appropriate solution.' },
  { q: 'How long does basement floor installation take?', a: 'Most basement floor installations take 1-3 days depending on size, preparation needs, and whether existing flooring needs to be removed. We\'ll provide a detailed timeline during your free estimate.' },
  { q: 'Can you level an existing uneven basement floor?', a: 'Yes, we can level existing basement floors using self-leveling concrete or by installing a new floor over the existing one. We\'ll assess your situation during the free estimate and recommend the best approach.' },
  { q: 'Will a new basement floor help with moisture problems?', a: 'A properly installed basement floor with a vapor barrier can help reduce moisture issues, but it\'s important to address underlying moisture sources. We\'ll assess your situation and recommend the best solution.' },
  { q: 'Can I install flooring over a new concrete basement floor?', a: 'Yes, once properly cured, a concrete basement floor can serve as a base for various flooring types. We\'ll ensure the surface is properly prepared for your intended use.' }
];

const faqSchema = generateFAQSchema(faqs);
---

<BaseLayout
  title="Basement Concrete Floor Installation in Deptford, NJ"
  description="Basement concrete floor specialists in Deptford, NJ. New installation, repair, leveling, and moisture barrier services. Transform your basement with durable concrete flooring."
  schema={[serviceSchema, faqSchema, breadcrumbSchema]}
>
  <!-- Hero Section -->
  <section class="bg-dark py-20 md:py-28">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <p class="section-subheading text-primary mb-4">Basement Services</p>
      <h1 class="text-4xl md:text-5xl lg:text-6xl font-bold text-white uppercase font-display mb-6">
        Basement Concrete Floor Installation
      </h1>
      <p class="text-xl text-gray-300 max-w-3xl mx-auto mb-8">
        Professional basement floor installation and repair services. Transform your basement with durable concrete flooring.
      </p>
      <a href="#contact-form" class="btn-primary text-lg">
        Get Free Basement Floor Estimate
        <i class="fa-solid fa-arrow-right"></i>
      </a>
    </div>
  </section>

  <!-- Winter Highlight Banner -->
  <section class="py-6 bg-orange-50 border-y-2 border-primary">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex items-start gap-4">
        <div class="w-12 h-12 bg-primary rounded-full flex items-center justify-center flex-shrink-0">
          <i class="fa-solid fa-snowflake text-white text-xl"></i>
        </div>
        <div>
          <h3 class="text-lg font-bold text-primary mb-1">Winter is Ideal for Basement Projects</h3>
          <p class="text-gray-700 mb-2">While outdoor concrete work slows during New Jersey winters, basement flooring projects proceed regardless of weather. Winter is the perfect time to finish your basement or repair basement floors.</p>
          <p class="text-gray-600 text-sm"><strong>Benefits:</strong> No weather delays • Better scheduling availability • Faster project starts • Ideal for home improvement season</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Gallery Section -->
  <section class="py-16 md:py-24 bg-gray-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-12">
        <p class="section-subheading text-primary mb-4">Our Work</p>
        <h2 class="section-heading mb-6">Our Basement Flooring Projects</h2>
        <p class="text-lg text-gray-600 max-w-3xl mx-auto">
          See our quality basement floor installations throughout Deptford and surrounding areas.
        </p>
      </div>

      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
        {galleryImages.map(image => (
          <div class="group relative aspect-[4/3] rounded-xl overflow-hidden shadow-lg hover:shadow-2xl transition-all hover:-translate-y-2">
            <img src={image.src} alt={image.alt} loading="lazy" class="w-full h-full object-cover" width="800" height="600" />
            <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/20 to-transparent opacity-0 group-hover:opacity-100 transition-opacity flex items-end p-4">
              <p class="text-white font-semibold">{image.label}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Content Section -->
  <section class="py-16 md:py-24 bg-white">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-3xl md:text-4xl font-bold text-gray-900 font-display uppercase mb-8">
        Basement Flooring Services
      </h2>
      <p class="text-lg text-gray-600 mb-8">
        We provide professional basement concrete floor installation and repair services for residential and commercial properties. Whether you're finishing a basement, repairing an old floor, or leveling uneven surfaces, we deliver quality results.
      </p>

      <h3 class="text-2xl font-bold text-primary font-display uppercase mt-10 mb-4">What's Included in Our Service</h3>
      <div class="bg-orange-50 border-l-4 border-primary rounded-lg p-6 mb-8">
        <ul class="space-y-2">
          {[
            'Free Site Evaluation - We assess your basement and existing floor condition at no cost',
            'Moisture Assessment - Evaluation of moisture levels and vapor barrier recommendations',
            'Floor Design - Custom floor design for new installation or repair',
            'Site Preparation - Removal of old flooring and surface preparation',
            'Moisture Barrier Installation - Vapor barrier when required',
            'Quality Materials - High-grade concrete mixes for interior basement use',
            'Professional Installation - Expert installation by experienced professionals',
            'Leveling Services - Proper floor leveling for smooth, even surfaces',
            'Finishing Options - Smooth finish or other options based on your needs',
            'Cleanup - Complete site cleanup after installation'
          ].map(item => (
            <li class="flex items-start gap-2">
              <i class="fa-solid fa-check-circle text-primary mt-1"></i>
              <span>{item}</span>
            </li>
          ))}
        </ul>
      </div>

      <h3 class="text-2xl font-bold text-primary font-display uppercase mt-10 mb-4">Our Installation Process</h3>
      <div class="space-y-4 mb-8">
        {[
          { num: '1', title: 'Site Evaluation', desc: 'We assess your basement and existing floor condition' },
          { num: '2', title: 'Moisture Testing', desc: 'Evaluation of moisture levels to determine vapor barrier needs' },
          { num: '3', title: 'Surface Preparation', desc: 'Removal of old flooring and proper surface preparation' },
          { num: '4', title: 'Moisture Barrier', desc: 'Installation of vapor barrier when required' },
          { num: '5', title: 'Concrete Pouring', desc: 'Placement of high-quality concrete mix' },
          { num: '6', title: 'Leveling & Finishing', desc: 'Proper leveling and finishing for smooth surfaces' }
        ].map(step => (
          <div class="flex items-start gap-4 bg-gray-50 rounded-lg p-4">
            <div class="w-10 h-10 bg-primary text-white rounded-full flex items-center justify-center font-bold flex-shrink-0">{step.num}</div>
            <div>
              <h4 class="font-bold text-lg">{step.title}</h4>
              <p class="text-gray-600">{step.desc}</p>
            </div>
          </div>
        ))}
      </div>

      <h3 class="text-2xl font-bold text-primary font-display uppercase mt-10 mb-4">Common Issues We Solve</h3>
      <div class="grid md:grid-cols-2 gap-4 mb-8">
        {[
          { icon: 'fa-droplet', title: 'Moisture Problems', desc: 'Proper installation with moisture barriers prevents water damage and mold' },
          { icon: 'fa-ruler-horizontal', title: 'Uneven Surfaces', desc: 'Leveling services create smooth, even floors' },
          { icon: 'fa-hammer', title: 'Damaged Floors', desc: 'Repair or replacement of cracked, damaged basement floors' },
          { icon: 'fa-home', title: 'Unusable Space', desc: 'Quality flooring transforms basements into usable living space' },
          { icon: 'fa-temperature-low', title: 'Cold Floors', desc: 'Proper installation can help with temperature control' },
          { icon: 'fa-chart-line', title: 'Property Value', desc: 'Quality basement flooring enhances property value' }
        ].map(item => (
          <div class="flex items-start gap-4 p-4 bg-gray-50 rounded-lg">
            <div class="w-10 h-10 bg-primary/10 rounded-full flex items-center justify-center flex-shrink-0">
              <i class={`fa-solid ${item.icon} text-primary`}></i>
            </div>
            <div>
              <h4 class="font-bold">{item.title}</h4>
              <p class="text-gray-600 text-sm">{item.desc}</p>
            </div>
          </div>
        ))}
      </div>

      <h3 class="text-2xl font-bold text-primary font-display uppercase mt-10 mb-4">Areas We Serve</h3>
      <p class="text-gray-600 mb-6">
        We provide basement flooring services throughout <a href="/locations/deptford-nj" class="text-primary font-semibold hover:underline">Deptford</a>, <a href="/locations/west-deptford-nj" class="text-primary font-semibold hover:underline">West Deptford</a>, <a href="/locations/woodbury-nj" class="text-primary font-semibold hover:underline">Woodbury</a>, <a href="/locations/glassboro-nj" class="text-primary font-semibold hover:underline">Glassboro</a>, and <a href="/locations" class="text-primary font-semibold hover:underline">all surrounding Gloucester County communities</a>.
      </p>
    </div>
  </section>

  <RelatedServices currentService="basement-flooring" />
  <ServiceAreasLink serviceName="Basement Flooring" />

  <!-- Contact Form Section -->
  <section id="contact-form" class="py-16 md:py-24 bg-gray-50">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
      <ContactForm title="Get Your Free Basement Floor Estimate" service="basement-flooring" />
    </div>
  </section>

  <!-- FAQ Section -->
  <section class="py-16 md:py-24 bg-white">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-12">
        <p class="section-subheading text-primary mb-4">Common Questions</p>
        <h2 class="section-heading">Basement Flooring FAQs</h2>
      </div>
      <div class="space-y-4">
        {faqs.map(faq => (
          <div class="bg-gray-50 rounded-xl p-6 border-l-4 border-primary">
            <h3 class="font-bold text-lg text-gray-900 mb-2">{faq.q}</h3>
            <p class="text-gray-600">{faq.a}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA Section -->
  <section class="py-16 md:py-20 bg-primary">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="text-3xl md:text-4xl font-bold text-white font-display uppercase mb-6">
        Ready to Finish Your Basement?
      </h2>
      <p class="text-xl text-white/90 mb-8">
        Contact us today for a free estimate. No obligation, just honest pricing.
      </p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a href="#contact-form" class="btn-secondary">Get Your Free Estimate <i class="fa-solid fa-arrow-right"></i></a>
        {SITE_CONFIG.phone && <a href={`tel:${SITE_CONFIG.phone}`} class="btn-outline"><i class="fa-solid fa-phone"></i> {SITE_CONFIG.phone}</a>}
      </div>
    </div>
  </section>
</BaseLayout>
