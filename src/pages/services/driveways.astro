---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ContactForm from '../../components/ContactForm.astro';
import RelatedServices from '../../components/RelatedServices.astro';
import ServiceAreasLink from '../../components/ServiceAreasLink.astro';
import { SITE_CONFIG } from '../../config';
import { generateServiceSchema } from '../../utils/schema';

const serviceSchema = generateServiceSchema('driveways', 'Professional concrete driveway installation and repair services in Deptford, NJ. Residential and commercial driveways with free estimates.');

const galleryImages = [
  { src: '/images/projects/IMG_0973.webp', alt: 'Concrete driveway installation in Deptford, NJ', label: 'Driveway Installation' },
  { src: '/images/projects/IMG_0974.webp', alt: 'Professional driveway project', label: 'Professional Driveway' },
  { src: '/images/projects/IMG_2635.webp', alt: 'Concrete driveway contractor work', label: 'Quality Workmanship' },
  { src: '/images/projects/IMG_3403.webp', alt: 'Residential driveway installation', label: 'Residential Driveway' },
  { src: '/images/projects/IMG_3404.webp', alt: 'Concrete driveway project', label: 'Concrete Driveway' },
  { src: '/images/projects/IMG_3907.webp', alt: 'Driveway installation service', label: 'Expert Installation' }
];

const faqs = [
  { q: 'How long does a concrete driveway last?', a: 'A properly installed concrete driveway can last 25-30 years or more with proper maintenance. Our driveways are designed for New Jersey\'s climate and built to withstand freeze-thaw cycles.' },
  { q: 'How long does driveway installation take?', a: 'Most driveway installations are completed within 1-2 days, depending on size and complexity. We\'ll provide a detailed timeline during your free estimate.' },
  { q: 'Can you repair an existing driveway instead of replacing it?', a: 'Yes, we can often repair or resurface existing driveways if the damage is limited. We\'ll assess your driveway during the free estimate and recommend the best solution.' },
  { q: 'Do I need a permit for a new driveway?', a: 'Permit requirements vary by municipality. We\'ll check local requirements and assist with permit applications if needed.' },
  { q: 'What\'s the difference between standard and stamped concrete driveways?', a: 'Standard concrete driveways have a smooth or brushed finish. Stamped concrete driveways feature decorative patterns and textures that mimic stone, brick, or other materials.' }
];
---

<BaseLayout
  title="Concrete Driveway Installation & Repair in Deptford, NJ"
  description="Expert concrete driveway contractors in Deptford, NJ. New driveway installation, repairs, resurfacing, and decorative options. Serving Gloucester County with quality concrete driveways."
  schema={serviceSchema}
>
  <!-- Hero Section -->
  <section class="bg-dark py-20 md:py-28">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <p class="section-subheading text-primary mb-4">Driveway Services</p>
      <h1 class="text-4xl md:text-5xl lg:text-6xl font-bold text-white uppercase font-display mb-6">
        Concrete Driveway Installation & Repair
      </h1>
      <p class="text-xl text-gray-300 max-w-3xl mx-auto mb-8">
        Professional driveway installation and repair services for residential and commercial properties. Free estimates on all driveway projects.
      </p>
      <a href="#contact-form" class="btn-primary text-lg">
        Get Free Driveway Estimate
        <i class="fa-solid fa-arrow-right"></i>
      </a>
    </div>
  </section>

  <!-- Gallery Section -->
  <section class="py-16 md:py-24 bg-gray-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-12">
        <p class="section-subheading text-primary mb-4">Our Work</p>
        <h2 class="section-heading mb-6">Our Driveway Projects</h2>
        <p class="text-lg text-gray-600 max-w-3xl mx-auto">
          See our quality driveway installations throughout Deptford and surrounding areas.
        </p>
      </div>

      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
        {galleryImages.map(image => (
          <div class="group relative aspect-[4/3] rounded-xl overflow-hidden shadow-lg hover:shadow-2xl transition-all hover:-translate-y-2">
            <img src={image.src} alt={image.alt} loading="lazy" class="w-full h-full object-cover" width="800" height="600" />
            <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/20 to-transparent opacity-0 group-hover:opacity-100 transition-opacity flex items-end p-4">
              <p class="text-white font-semibold">{image.label}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Content Section -->
  <section class="py-16 md:py-24 bg-white">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-3xl md:text-4xl font-bold text-gray-900 font-display uppercase mb-8">
        Expert Driveway Services
      </h2>
      <p class="text-lg text-gray-600 mb-8">
        We provide professional concrete driveway installation and repair services throughout Deptford and surrounding areas. Our durable driveways enhance curb appeal and provide years of reliable service.
      </p>

      <h3 class="text-2xl font-bold text-primary font-display uppercase mt-10 mb-4">Driveway Services</h3>
      <div class="grid md:grid-cols-2 gap-4 mb-8">
        {['New driveway installation', 'Driveway repair and resurfacing', 'Driveway replacement', 'Decorative concrete driveways', 'Driveway expansion'].map(service => (
          <div class="flex items-center gap-3 p-3 bg-gray-50 rounded-lg">
            <i class="fa-solid fa-check text-primary"></i>
            <span>{service}</span>
          </div>
        ))}
      </div>

      <h3 class="text-2xl font-bold text-primary font-display uppercase mt-10 mb-4">What's Included in Our Driveway Service</h3>
      <div class="bg-orange-50 border-l-4 border-primary rounded-lg p-6 mb-8">
        <ul class="space-y-2">
          {[
            'Free On-Site Estimate - We visit your property to assess and provide a detailed written estimate',
            'Site Preparation - Proper excavation, grading, and base preparation',
            'Quality Materials - High-grade concrete mixes for New Jersey\'s climate',
            'Professional Installation - Expert installation with attention to detail',
            'Proper Drainage - Correct slope to prevent water damage and ice buildup',
            'Expansion Joints - Properly placed to prevent cracking',
            'Finishing Options - Smooth, brushed, or decorative finishes',
            'Cleanup - Complete site cleanup after installation'
          ].map(item => (
            <li class="flex items-start gap-2">
              <i class="fa-solid fa-check-circle text-primary mt-1"></i>
              <span>{item}</span>
            </li>
          ))}
        </ul>
      </div>

      <h3 class="text-2xl font-bold text-primary font-display uppercase mt-10 mb-4">Our Driveway Installation Process</h3>
      <div class="space-y-4 mb-8">
        {[
          { num: '1', title: 'Site Evaluation', desc: 'We assess your property, existing driveway, drainage patterns, and local requirements' },
          { num: '2', title: 'Design & Planning', desc: 'We create a driveway design that meets your needs and local codes' },
          { num: '3', title: 'Excavation & Base', desc: 'Professional excavation and proper base material installation' },
          { num: '4', title: 'Formwork', desc: 'Installation of forms and reinforcement as needed' },
          { num: '5', title: 'Concrete Pouring', desc: 'Placement of high-quality concrete mix' },
          { num: '6', title: 'Finishing & Curing', desc: 'Proper finishing, texturing, and curing for durability' }
        ].map(step => (
          <div class="flex items-start gap-4 bg-gray-50 rounded-lg p-4">
            <div class="w-10 h-10 bg-primary text-white rounded-full flex items-center justify-center font-bold flex-shrink-0">{step.num}</div>
            <div>
              <h4 class="font-bold text-lg">{step.title}</h4>
              <p class="text-gray-600">{step.desc}</p>
            </div>
          </div>
        ))}
      </div>

      <h3 class="text-2xl font-bold text-primary font-display uppercase mt-10 mb-4">Driveway Styles & Options</h3>
      <div class="grid md:grid-cols-2 gap-4 mb-8">
        {[
          { title: 'Standard Concrete', desc: 'Durable, smooth finish - excellent value', link: null },
          { title: 'Stamped Concrete', desc: 'Decorative patterns mimicking stone or brick', link: '/services/stamped-concrete' },
          { title: 'Colored Concrete', desc: 'Custom colors to match your home', link: null },
          { title: 'Brushed Finish', desc: 'Textured surface for better traction', link: null }
        ].map(style => (
          <div class="bg-gray-50 rounded-lg p-4 border-l-4 border-primary">
            <h4 class="font-bold mb-1">{style.title}</h4>
            <p class="text-gray-600 text-sm">{style.desc}</p>
            {style.link && <a href={style.link} class="text-primary text-sm font-semibold hover:underline">Learn more →</a>}
          </div>
        ))}
      </div>

      <h3 class="text-2xl font-bold text-primary font-display uppercase mt-10 mb-4">Areas We Serve</h3>
      <p class="text-gray-600 mb-6">
        We provide driveway installation and repair services throughout <a href="/locations/deptford-nj" class="text-primary font-semibold hover:underline">Deptford</a>, <a href="/locations/west-deptford-nj" class="text-primary font-semibold hover:underline">West Deptford</a>, <a href="/locations/woodbury-nj" class="text-primary font-semibold hover:underline">Woodbury</a>, <a href="/locations/glassboro-nj" class="text-primary font-semibold hover:underline">Glassboro</a>, and <a href="/locations" class="text-primary font-semibold hover:underline">all surrounding Gloucester County communities</a>.
      </p>
    </div>
  </section>

  <RelatedServices currentService="driveways" />
  <ServiceAreasLink serviceName="Driveways" />

  <!-- Contact Form Section -->
  <section id="contact-form" class="py-16 md:py-24 bg-gray-50">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
      <ContactForm title="Get Your Free Driveway Estimate" service="driveways" />
    </div>
  </section>

  <!-- FAQ Section -->
  <section class="py-16 md:py-24 bg-white">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-12">
        <p class="section-subheading text-primary mb-4">Common Questions</p>
        <h2 class="section-heading">Driveway FAQs</h2>
      </div>
      <div class="space-y-4">
        {faqs.map(faq => (
          <div class="bg-gray-50 rounded-xl p-6 border-l-4 border-primary">
            <h3 class="font-bold text-lg text-gray-900 mb-2">{faq.q}</h3>
            <p class="text-gray-600">{faq.a}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA Section -->
  <section class="py-16 md:py-20 bg-primary">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="text-3xl md:text-4xl font-bold text-white font-display uppercase mb-6">
        Ready for a New Driveway?
      </h2>
      <p class="text-xl text-white/90 mb-8">
        Contact us today for a free estimate. No obligation, just honest pricing.
      </p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a href="#contact-form" class="btn-secondary">Get Your Free Estimate <i class="fa-solid fa-arrow-right"></i></a>
        {SITE_CONFIG.phone && <a href={`tel:${SITE_CONFIG.phone}`} class="btn-outline"><i class="fa-solid fa-phone"></i> {SITE_CONFIG.phone}</a>}
      </div>
    </div>
  </section>
</BaseLayout>
