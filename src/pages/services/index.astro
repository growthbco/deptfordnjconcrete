---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ServiceCard from '../../components/ServiceCard.astro';
import { SITE_CONFIG } from '../../config';
import servicesData from '../../content/services.json';

const primaryServices = servicesData.filter(s => s.primary);
const otherServices = servicesData.filter(s => !s.primary);
---

<BaseLayout
  title="Concrete Services | Pole Barn Foundations, Slabs & More"
  description="Complete concrete services including pole barn foundations, large slabs, driveways, patios, and more. Serving Deptford, NJ and surrounding areas."
>
  <!-- Hero Section -->
  <section class="bg-dark py-20 md:py-28">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <p class="section-subheading text-primary mb-4">What We Do</p>
      <h1 class="text-4xl md:text-5xl lg:text-6xl font-bold text-white uppercase font-display mb-6">
        Our Concrete Services
      </h1>
      <p class="text-xl text-gray-300 max-w-3xl mx-auto">
        From pole barn foundations to residential driveways, we provide professional concrete services throughout Deptford and surrounding New Jersey communities.
      </p>
    </div>
  </section>

  <!-- Primary Services Section -->
  <section class="py-16 md:py-24 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-12">
        <p class="section-subheading text-primary mb-4">Our Specialty</p>
        <h2 class="section-heading mb-6">Primary Services</h2>
        <p class="text-lg text-gray-600 max-w-3xl mx-auto">
          Our specialty services focus on pole barn foundations and large commercial concrete projects. These are the areas where we truly excel.
        </p>
      </div>

      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
        {primaryServices.map(service => (
          <ServiceCard service={service} />
        ))}
      </div>
    </div>
  </section>

  <!-- Additional Services Section -->
  <section class="py-16 md:py-24 bg-gray-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-12">
        <p class="section-subheading text-primary mb-4">Full Service</p>
        <h2 class="section-heading mb-6">Additional Services</h2>
        <p class="text-lg text-gray-600 max-w-3xl mx-auto">
          We also provide comprehensive concrete services for residential and commercial projects of all sizes.
        </p>
      </div>

      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
        {otherServices.map(service => (
          <ServiceCard service={service} />
        ))}
      </div>
    </div>
  </section>

  <!-- Why Choose Us Section -->
  <section class="py-16 md:py-24 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid lg:grid-cols-2 gap-12 items-center">
        <div>
          <p class="section-subheading text-primary mb-4">Quality Guaranteed</p>
          <h2 class="text-3xl md:text-4xl font-bold text-gray-900 font-display uppercase mb-6">
            Why Choose Us For Your Concrete Project?
          </h2>
          <p class="text-lg text-gray-600 mb-8">
            When you choose Deptford Concrete Contractors, you're choosing quality workmanship, honest pricing, and professional service from start to finish.
          </p>

          <div class="space-y-4">
            <div class="flex items-start gap-4">
              <div class="w-10 h-10 bg-primary/10 rounded-lg flex items-center justify-center flex-shrink-0">
                <i class="fa-solid fa-check text-primary"></i>
              </div>
              <div>
                <h3 class="font-bold text-lg mb-1">Free, No-Obligation Estimates</h3>
                <p class="text-gray-600">Get honest pricing upfront with no hidden fees or surprises.</p>
              </div>
            </div>
            <div class="flex items-start gap-4">
              <div class="w-10 h-10 bg-primary/10 rounded-lg flex items-center justify-center flex-shrink-0">
                <i class="fa-solid fa-check text-primary"></i>
              </div>
              <div>
                <h3 class="font-bold text-lg mb-1">Licensed & Insured</h3>
                <p class="text-gray-600">Full protection and peace of mind on every project.</p>
              </div>
            </div>
            <div class="flex items-start gap-4">
              <div class="w-10 h-10 bg-primary/10 rounded-lg flex items-center justify-center flex-shrink-0">
                <i class="fa-solid fa-check text-primary"></i>
              </div>
              <div>
                <h3 class="font-bold text-lg mb-1">Quality Materials</h3>
                <p class="text-gray-600">We use only premium concrete and materials for lasting results.</p>
              </div>
            </div>
            <div class="flex items-start gap-4">
              <div class="w-10 h-10 bg-primary/10 rounded-lg flex items-center justify-center flex-shrink-0">
                <i class="fa-solid fa-check text-primary"></i>
              </div>
              <div>
                <h3 class="font-bold text-lg mb-1">24-48 Hour Response</h3>
                <p class="text-gray-600">We respond quickly to all estimate requests.</p>
              </div>
            </div>
          </div>
        </div>

        <div class="bg-gray-50 rounded-2xl p-8 lg:p-12">
          <h3 class="text-2xl font-bold font-display uppercase mb-6 text-center">Ready to Get Started?</h3>
          <p class="text-gray-600 text-center mb-8">
            Contact us today for a free estimate on your concrete project. We serve Deptford and all surrounding communities.
          </p>
          <div class="space-y-4">
            <a href="/contact" class="btn-primary w-full justify-center">
              Get Your Free Estimate
              <i class="fa-solid fa-arrow-right"></i>
            </a>
            {SITE_CONFIG.phone && (
              <a href={`tel:${SITE_CONFIG.phone}`} class="flex items-center justify-center gap-3 text-lg font-bold text-gray-900 hover:text-primary transition-colors">
                <i class="fa-solid fa-phone text-primary"></i>
                {SITE_CONFIG.phone}
              </a>
            )}
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Service Areas Section -->
  <section class="py-16 md:py-24 bg-gray-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-12">
        <p class="section-subheading text-primary mb-4">Where We Work</p>
        <h2 class="section-heading mb-6">Services In Your Area</h2>
        <p class="text-lg text-gray-600 max-w-3xl mx-auto">
          We provide all these concrete services throughout Gloucester County. Find services in your area.
        </p>
      </div>

      <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-6">
        <a href="/locations/deptford-nj" class="group card p-6 text-center hover:-translate-y-2">
          <div class="w-12 h-12 bg-primary/10 rounded-full flex items-center justify-center mx-auto mb-4 group-hover:bg-primary transition-colors">
            <i class="fa-solid fa-location-dot text-primary text-xl group-hover:text-white transition-colors"></i>
          </div>
          <h3 class="font-bold text-lg font-display uppercase mb-2 group-hover:text-primary transition-colors">Deptford, NJ</h3>
          <p class="text-primary text-sm font-semibold">View Services →</p>
        </a>

        <a href="/locations/west-deptford-nj" class="group card p-6 text-center hover:-translate-y-2">
          <div class="w-12 h-12 bg-primary/10 rounded-full flex items-center justify-center mx-auto mb-4 group-hover:bg-primary transition-colors">
            <i class="fa-solid fa-location-dot text-primary text-xl group-hover:text-white transition-colors"></i>
          </div>
          <h3 class="font-bold text-lg font-display uppercase mb-2 group-hover:text-primary transition-colors">West Deptford, NJ</h3>
          <p class="text-primary text-sm font-semibold">View Services →</p>
        </a>

        <a href="/locations/woodbury-nj" class="group card p-6 text-center hover:-translate-y-2">
          <div class="w-12 h-12 bg-primary/10 rounded-full flex items-center justify-center mx-auto mb-4 group-hover:bg-primary transition-colors">
            <i class="fa-solid fa-location-dot text-primary text-xl group-hover:text-white transition-colors"></i>
          </div>
          <h3 class="font-bold text-lg font-display uppercase mb-2 group-hover:text-primary transition-colors">Woodbury, NJ</h3>
          <p class="text-primary text-sm font-semibold">View Services →</p>
        </a>

        <a href="/locations" class="group bg-primary rounded-xl p-6 text-center hover:-translate-y-2 transition-all shadow-lg hover:shadow-2xl">
          <div class="w-12 h-12 bg-white/20 rounded-full flex items-center justify-center mx-auto mb-4">
            <i class="fa-solid fa-map-location-dot text-white text-xl"></i>
          </div>
          <h3 class="font-bold text-lg font-display uppercase mb-2 text-white">All Service Areas</h3>
          <p class="text-white/90 text-sm font-semibold">View All Locations →</p>
        </a>
      </div>
    </div>
  </section>

  <!-- CTA Section -->
  <section class="py-16 md:py-20 bg-primary">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="text-3xl md:text-4xl font-bold text-white font-display uppercase mb-6">
        Ready to Start Your Project?
      </h2>
      <p class="text-xl text-white/90 mb-8">
        Contact us today for a free estimate on any of our concrete services. No obligation, just honest pricing.
      </p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a href="/contact" class="btn-secondary">
          Get Your Free Estimate
          <i class="fa-solid fa-arrow-right"></i>
        </a>
        {SITE_CONFIG.phone && (
          <a href={`tel:${SITE_CONFIG.phone}`} class="btn-outline">
            <i class="fa-solid fa-phone"></i>
            {SITE_CONFIG.phone}
          </a>
        )}
      </div>
    </div>
  </section>
</BaseLayout>
