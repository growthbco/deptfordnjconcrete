---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ContactForm from '../../components/ContactForm.astro';
import RelatedServices from '../../components/RelatedServices.astro';
import ServiceAreasLink from '../../components/ServiceAreasLink.astro';
import { SITE_CONFIG } from '../../config';
import { generateServiceSchema } from '../../utils/schema';

const serviceSchema = generateServiceSchema('stamped-concrete', 'Decorative stamped concrete installation for patios, driveways, pool decks, and walkways in Deptford, NJ. Beautiful patterns and textures at a fraction of natural stone cost. Free estimates.');

const galleryImages = [
  { src: '/images/projects/IMG_7649.webp', alt: 'Stamped concrete patio in Deptford, NJ', label: 'Stamped Patio' },
  { src: '/images/projects/IMG_7653.webp', alt: 'Decorative stamped concrete project', label: 'Decorative Pattern' },
  { src: '/images/projects/IMG_7654.webp', alt: 'Stamped concrete walkway', label: 'Stamped Walkway' },
  { src: '/images/projects/IMG_7655.webp', alt: 'Professional stamped concrete', label: 'Professional Work' },
  { src: '/images/projects/IMG_7656.webp', alt: 'Stamped concrete installation', label: 'Quality Installation' },
  { src: '/images/projects/IMG_7657.webp', alt: 'Stamped concrete project', label: 'Expert Craftsmanship' }
];

const faqs = [
  { q: 'How long does stamped concrete last?', a: 'Properly installed and maintained stamped concrete can last 25-30 years or more. Regular resealing every 2-3 years helps maintain its appearance and durability.' },
  { q: 'How much does stamped concrete cost compared to natural stone?', a: 'Stamped concrete typically costs significantly less than natural stone or pavers while providing a similar appearance. The exact savings depend on the pattern and area size.' },
  { q: 'Can stamped concrete be repaired if it cracks?', a: 'Yes, minor cracks in stamped concrete can often be repaired to match the existing pattern. We\'ll assess any damage during maintenance and recommend the best repair approach.' },
  { q: 'How often does stamped concrete need to be resealed?', a: 'Stamped concrete should be resealed every 2-3 years to maintain its appearance and protect against wear, weather, and staining. We provide maintenance guidance after installation.' },
  { q: 'Is stamped concrete slippery when wet?', a: 'Properly sealed stamped concrete can be slippery when wet, but we can apply non-slip additives or use textured patterns for areas like pool decks where safety is a concern.' }
];
---

<BaseLayout
  title="Stamped Concrete Installation in Deptford, NJ | Decorative Concrete Patterns"
  description="Professional stamped concrete installation for patios, driveways, and walkways in Deptford, NJ. Beautiful decorative patterns with free estimates."
  schema={serviceSchema}
>
  <!-- Hero Section -->
  <section class="bg-dark py-20 md:py-28">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <p class="section-subheading text-primary mb-4">Decorative Concrete</p>
      <h1 class="text-4xl md:text-5xl lg:text-6xl font-bold text-white uppercase font-display mb-6">
        Stamped Concrete Installation
      </h1>
      <p class="text-xl text-gray-300 max-w-3xl mx-auto mb-8">
        Professional decorative stamped concrete for patios, driveways, and walkways. Transform your outdoor spaces with beautiful patterns and textures.
      </p>
      <a href="#contact-form" class="btn-primary text-lg">
        Get Free Stamped Concrete Estimate
        <i class="fa-solid fa-arrow-right"></i>
      </a>
    </div>
  </section>

  <!-- Gallery Section -->
  <section class="py-16 md:py-24 bg-gray-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-12">
        <p class="section-subheading text-primary mb-4">Our Work</p>
        <h2 class="section-heading mb-6">Our Stamped Concrete Projects</h2>
        <p class="text-lg text-gray-600 max-w-3xl mx-auto">
          See our beautiful stamped concrete installations throughout Deptford and surrounding areas.
        </p>
      </div>

      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
        {galleryImages.map(image => (
          <div class="group relative aspect-[4/3] rounded-xl overflow-hidden shadow-lg hover:shadow-2xl transition-all hover:-translate-y-2">
            <img src={image.src} alt={image.alt} loading="lazy" class="w-full h-full object-cover" width="800" height="600" />
            <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/20 to-transparent opacity-0 group-hover:opacity-100 transition-opacity flex items-end p-4">
              <p class="text-white font-semibold">{image.label}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Content Section -->
  <section class="py-16 md:py-24 bg-white">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-3xl md:text-4xl font-bold text-gray-900 font-display uppercase mb-8">
        What is Stamped Concrete?
      </h2>
      <p class="text-lg text-gray-600 mb-8">
        Stamped concrete is a decorative concrete technique that creates beautiful patterns and textures, mimicking the look of natural stone, brick, tile, or wood. This cost-effective solution transforms ordinary concrete into stunning surfaces that enhance the beauty and value of your property.
      </p>

      <h3 class="text-2xl font-bold text-primary font-display uppercase mt-10 mb-4">Stamped Concrete Applications</h3>
      <div class="grid md:grid-cols-2 gap-4 mb-8">
        {[
          { title: 'Stamped Patios', desc: 'Beautiful outdoor living spaces with decorative patterns', link: '/services/patios' },
          { title: 'Stamped Driveways', desc: 'Enhanced curb appeal with elegant driveway designs', link: '/services/driveways' },
          { title: 'Stamped Walkways', desc: 'Visual interest for pathways and sidewalks', link: '/services/walkways' },
          { title: 'Pool Decks', desc: 'Slip-resistant stamped concrete for pool areas', link: '/services/pool-decks' },
          { title: 'Outdoor Kitchens', desc: 'Durable stamped concrete for cooking areas', link: null },
          { title: 'Commercial Spaces', desc: 'Decorative concrete for businesses', link: null }
        ].map(app => (
          <div class="bg-gray-50 rounded-lg p-4 border-l-4 border-primary">
            <h4 class="font-bold mb-1">{app.title}</h4>
            <p class="text-gray-600 text-sm">{app.desc}</p>
            {app.link && <a href={app.link} class="text-primary text-sm font-semibold hover:underline">Learn more →</a>}
          </div>
        ))}
      </div>

      <h3 class="text-2xl font-bold text-primary font-display uppercase mt-10 mb-4">Popular Stamped Concrete Patterns</h3>
      <div class="grid grid-cols-2 md:grid-cols-3 gap-3 mb-8">
        {[
          'Ashlar Slate',
          'Herringbone',
          'Wood Plank',
          'Cobblestone',
          'Flagstone',
          'Random Stone'
        ].map(pattern => (
          <div class="flex items-center gap-2 p-3 bg-gray-50 rounded-lg">
            <i class="fa-solid fa-palette text-primary"></i>
            <span class="font-medium">{pattern}</span>
          </div>
        ))}
      </div>

      <h3 class="text-2xl font-bold text-primary font-display uppercase mt-10 mb-4">Benefits of Stamped Concrete</h3>
      <div class="grid md:grid-cols-2 gap-4 mb-8">
        {[
          { icon: 'fa-dollar-sign', title: 'Cost-Effective', desc: 'More affordable than natural stone or pavers' },
          { icon: 'fa-shield-halved', title: 'Durable', desc: 'Long-lasting and low-maintenance' },
          { icon: 'fa-palette', title: 'Versatile', desc: 'Wide variety of patterns and colors' },
          { icon: 'fa-wand-magic-sparkles', title: 'Customizable', desc: 'Match your home\'s style and color scheme' },
          { icon: 'fa-person-walking', title: 'Slip-Resistant', desc: 'Safe for pool decks and walkways' },
          { icon: 'fa-chart-line', title: 'Value-Adding', desc: 'Increases property value and curb appeal' }
        ].map(benefit => (
          <div class="flex items-start gap-4 p-4 bg-gray-50 rounded-lg">
            <div class="w-10 h-10 bg-primary/10 rounded-full flex items-center justify-center flex-shrink-0">
              <i class={`fa-solid ${benefit.icon} text-primary`}></i>
            </div>
            <div>
              <h4 class="font-bold">{benefit.title}</h4>
              <p class="text-gray-600 text-sm">{benefit.desc}</p>
            </div>
          </div>
        ))}
      </div>

      <h3 class="text-2xl font-bold text-primary font-display uppercase mt-10 mb-4">What's Included in Our Service</h3>
      <div class="bg-orange-50 border-l-4 border-primary rounded-lg p-6 mb-8">
        <ul class="space-y-2">
          {[
            'Free Design Consultation - We help you choose the perfect pattern and color',
            'Custom Design - Stamped concrete tailored to your property and preferences',
            'Site Preparation - Proper excavation, grading, and base preparation',
            'Quality Materials - High-grade concrete mixes and color additives',
            'Professional Installation - Expert installation with skilled stamping techniques',
            'Pattern Application - Precise stamping to create your chosen pattern',
            'Coloring Services - Integral color mixing or surface treatments',
            'Professional Sealing - Sealant application to protect and enhance appearance',
            'Expansion Joints - Properly placed to prevent cracking',
            'Cleanup - Complete site cleanup after installation'
          ].map(item => (
            <li class="flex items-start gap-2">
              <i class="fa-solid fa-check-circle text-primary mt-1"></i>
              <span>{item}</span>
            </li>
          ))}
        </ul>
      </div>

      <h3 class="text-2xl font-bold text-primary font-display uppercase mt-10 mb-4">Our Installation Process</h3>
      <div class="space-y-4 mb-8">
        {[
          { num: '1', title: 'Design Consultation', desc: 'We discuss your vision and show pattern options' },
          { num: '2', title: 'Site Evaluation', desc: 'We assess your property and drainage patterns' },
          { num: '3', title: 'Site Preparation', desc: 'Professional excavation and base installation' },
          { num: '4', title: 'Concrete Pouring', desc: 'Placement of concrete with color additives' },
          { num: '5', title: 'Stamping', desc: 'Precise application of stamping tools for your pattern' },
          { num: '6', title: 'Finishing & Sealing', desc: 'Proper curing and professional sealant application' }
        ].map(step => (
          <div class="flex items-start gap-4 bg-gray-50 rounded-lg p-4">
            <div class="w-10 h-10 bg-primary text-white rounded-full flex items-center justify-center font-bold flex-shrink-0">{step.num}</div>
            <div>
              <h4 class="font-bold text-lg">{step.title}</h4>
              <p class="text-gray-600">{step.desc}</p>
            </div>
          </div>
        ))}
      </div>

      <h3 class="text-2xl font-bold text-primary font-display uppercase mt-10 mb-4">Maintenance Tips</h3>
      <div class="bg-gray-50 rounded-lg p-6 mb-8">
        <ul class="space-y-3">
          {[
            'Regular cleaning with mild detergent and water',
            'Resealing every 2-3 years to maintain appearance',
            'Avoid harsh chemicals or de-icers that can damage sealant',
            'Protect from heavy impact or dragging heavy objects',
            'Prompt repair of any minor cracks to prevent water damage'
          ].map(tip => (
            <li class="flex items-start gap-2">
              <i class="fa-solid fa-lightbulb text-primary mt-1"></i>
              <span>{tip}</span>
            </li>
          ))}
        </ul>
      </div>

      <h3 class="text-2xl font-bold text-primary font-display uppercase mt-10 mb-4">Areas We Serve</h3>
      <p class="text-gray-600 mb-6">
        We provide stamped concrete installation services throughout <a href="/locations/deptford-nj" class="text-primary font-semibold hover:underline">Deptford</a>, <a href="/locations/west-deptford-nj" class="text-primary font-semibold hover:underline">West Deptford</a>, <a href="/locations/woodbury-nj" class="text-primary font-semibold hover:underline">Woodbury</a>, <a href="/locations/glassboro-nj" class="text-primary font-semibold hover:underline">Glassboro</a>, and <a href="/locations" class="text-primary font-semibold hover:underline">all surrounding Gloucester County communities</a>.
      </p>
    </div>
  </section>

  <RelatedServices currentService="stamped-concrete" />
  <ServiceAreasLink serviceName="Stamped Concrete" />

  <!-- Contact Form Section -->
  <section id="contact-form" class="py-16 md:py-24 bg-gray-50">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
      <ContactForm title="Get Your Free Stamped Concrete Estimate" service="stamped-concrete" />
    </div>
  </section>

  <!-- FAQ Section -->
  <section class="py-16 md:py-24 bg-white">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-12">
        <p class="section-subheading text-primary mb-4">Common Questions</p>
        <h2 class="section-heading">Stamped Concrete FAQs</h2>
      </div>
      <div class="space-y-4">
        {faqs.map(faq => (
          <div class="bg-gray-50 rounded-xl p-6 border-l-4 border-primary">
            <h3 class="font-bold text-lg text-gray-900 mb-2">{faq.q}</h3>
            <p class="text-gray-600">{faq.a}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA Section -->
  <section class="py-16 md:py-20 bg-primary">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="text-3xl md:text-4xl font-bold text-white font-display uppercase mb-6">
        Ready for Beautiful Stamped Concrete?
      </h2>
      <p class="text-xl text-white/90 mb-8">
        Contact us today for a free estimate. No obligation, just honest pricing.
      </p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a href="#contact-form" class="btn-secondary">Get Your Free Estimate <i class="fa-solid fa-arrow-right"></i></a>
        {SITE_CONFIG.phone && <a href={`tel:${SITE_CONFIG.phone}`} class="btn-outline"><i class="fa-solid fa-phone"></i> {SITE_CONFIG.phone}</a>}
      </div>
    </div>
  </section>
</BaseLayout>
