---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ContactForm from '../../components/ContactForm.astro';
import RelatedServices from '../../components/RelatedServices.astro';
import ServiceAreasLink from '../../components/ServiceAreasLink.astro';
import { SITE_CONFIG } from '../../config';
import { generateServiceSchema, generateBreadcrumbSchema, generateFAQSchema } from '../../utils/schema';

const serviceSchema = generateServiceSchema('retaining-walls', 'Professional concrete retaining wall construction in Deptford, NJ. Erosion control and landscaping solutions with free estimates.');

const breadcrumbSchema = generateBreadcrumbSchema([
  { name: 'Home', url: 'https://deptfordnjconcrete.com/' },
  { name: 'Services', url: 'https://deptfordnjconcrete.com/services/' },
  { name: 'Retaining Walls', url: 'https://deptfordnjconcrete.com/services/retaining-walls/' }
]);

const galleryImages = [
  { src: '/images/projects/IMG_9889.webp', alt: 'Concrete retaining wall installation in Deptford, NJ', label: 'Retaining Wall' },
  { src: '/images/projects/IMG_9890.webp', alt: 'Professional retaining wall project', label: 'Professional Installation' },
  { src: '/images/projects/IMG_2711.webp', alt: 'Concrete wall contractor work', label: 'Quality Workmanship' },
  { src: '/images/projects/IMG_5125 2.webp', alt: 'Erosion control wall', label: 'Erosion Control' },
  { src: '/images/projects/IMG_5125 3.webp', alt: 'Concrete wall project', label: 'Concrete Wall' },
  { src: '/images/projects/IMG_5168.webp', alt: 'Retaining wall installation service', label: 'Expert Service' }
];

const faqs = [
  { q: 'How tall can a concrete retaining wall be?', a: 'Retaining wall height depends on soil conditions, design, and local codes. Most residential walls are 3-4 feet, while taller walls may require engineering and permits. We\'ll assess your needs during the free estimate.' },
  { q: 'Do I need a permit for a retaining wall?', a: 'Permit requirements vary by municipality and wall height. Walls over 4 feet typically require permits. We\'ll check local requirements and assist with permit applications if needed.' },
  { q: 'How long does retaining wall installation take?', a: 'Most retaining wall installations take 2-4 days depending on height, length, and complexity. We\'ll provide a detailed timeline during your free estimate.' },
  { q: 'Do retaining walls need drainage?', a: 'Yes, proper drainage behind retaining walls is essential to prevent water pressure buildup that could cause wall failure. We include drainage systems in all our retaining wall installations.' },
  { q: 'Can a retaining wall be repaired instead of replaced?', a: 'It depends on the extent of damage. Minor issues can often be repaired, but significant structural problems may require replacement. We\'ll assess your wall during the free estimate and recommend the best solution.' }
];

const faqSchema = generateFAQSchema(faqs);
---

<BaseLayout
  title="Concrete Retaining Wall Installation in Deptford, NJ"
  description="Expert concrete retaining wall contractors in Deptford, NJ. Erosion control, drainage management, and landscaping walls. Professional installation for property protection."
  schema={[serviceSchema, faqSchema, breadcrumbSchema]}
>
  <!-- Hero Section -->
  <section class="bg-dark py-20 md:py-28">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <p class="section-subheading text-primary mb-4">Retaining Wall Services</p>
      <h1 class="text-4xl md:text-5xl lg:text-6xl font-bold text-white uppercase font-display mb-6">
        Concrete Retaining Wall Installation
      </h1>
      <p class="text-xl text-gray-300 max-w-3xl mx-auto mb-8">
        Professional retaining wall construction for erosion control and landscaping. Durable concrete walls that protect your property.
      </p>
      <a href="#contact-form" class="btn-primary text-lg">
        Get Free Retaining Wall Estimate
        <i class="fa-solid fa-arrow-right"></i>
      </a>
    </div>
  </section>

  <!-- Gallery Section -->
  <section class="py-16 md:py-24 bg-gray-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-12">
        <p class="section-subheading text-primary mb-4">Our Work</p>
        <h2 class="section-heading mb-6">Our Retaining Wall Projects</h2>
        <p class="text-lg text-gray-600 max-w-3xl mx-auto">
          See our quality retaining wall installations throughout Deptford and surrounding areas.
        </p>
      </div>

      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
        {galleryImages.map(image => (
          <div class="group relative aspect-[4/3] rounded-xl overflow-hidden shadow-lg hover:shadow-2xl transition-all hover:-translate-y-2">
            <img src={image.src} alt={image.alt} loading="lazy" class="w-full h-full object-cover" width="800" height="600" />
            <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/20 to-transparent opacity-0 group-hover:opacity-100 transition-opacity flex items-end p-4">
              <p class="text-white font-semibold">{image.label}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Content Section -->
  <section class="py-16 md:py-24 bg-white">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-3xl md:text-4xl font-bold text-gray-900 font-display uppercase mb-8">
        Professional Retaining Wall Services
      </h2>
      <p class="text-lg text-gray-600 mb-8">
        We build durable concrete retaining walls that control erosion, manage drainage, and enhance your property's appearance. Whether you need erosion control on a sloped property or want to create level landscaping areas, our retaining walls provide lasting solutions.
      </p>

      <h3 class="text-2xl font-bold text-primary font-display uppercase mt-10 mb-4">What's Included in Our Retaining Wall Service</h3>
      <div class="bg-orange-50 border-l-4 border-primary rounded-lg p-6 mb-8">
        <ul class="space-y-2">
          {[
            'Free Site Evaluation - We assess your property, soil conditions, and erosion issues at no cost',
            'Custom Wall Design - Design that meets structural requirements and addresses your specific needs',
            'Permit Assistance - We help navigate the permit process for taller walls',
            'Professional Excavation - Proper site preparation and excavation for wall foundation',
            'Quality Materials - High-grade concrete and reinforcement materials',
            'Expert Installation - Skilled installation by experienced concrete professionals',
            'Drainage Systems - Proper drainage behind the wall to prevent water pressure buildup',
            'Reinforcement - Appropriate reinforcement based on wall height and soil conditions',
            'Code Compliance - All work meets or exceeds local building codes',
            'Cleanup - Complete site cleanup after installation'
          ].map(item => (
            <li class="flex items-start gap-2">
              <i class="fa-solid fa-check-circle text-primary mt-1"></i>
              <span>{item}</span>
            </li>
          ))}
        </ul>
      </div>

      <h3 class="text-2xl font-bold text-primary font-display uppercase mt-10 mb-4">Our Retaining Wall Installation Process</h3>
      <div class="space-y-4 mb-8">
        {[
          { num: '1', title: 'Site Evaluation', desc: 'We assess soil conditions, drainage, erosion issues, and local requirements' },
          { num: '2', title: 'Design & Planning', desc: 'We create a wall design meeting structural requirements and local codes' },
          { num: '3', title: 'Permit Assistance', desc: 'We help secure necessary permits for taller walls' },
          { num: '4', title: 'Excavation', desc: 'Professional excavation to proper depth for wall foundation' },
          { num: '5', title: 'Foundation & Reinforcement', desc: 'Proper base preparation and rebar installation' },
          { num: '6', title: 'Concrete Pouring', desc: 'Placement of high-quality concrete mix' },
          { num: '7', title: 'Drainage & Finishing', desc: 'Installation of drainage systems and proper finishing' }
        ].map(step => (
          <div class="flex items-start gap-4 bg-gray-50 rounded-lg p-4">
            <div class="w-10 h-10 bg-primary text-white rounded-full flex items-center justify-center font-bold flex-shrink-0">{step.num}</div>
            <div>
              <h4 class="font-bold text-lg">{step.title}</h4>
              <p class="text-gray-600">{step.desc}</p>
            </div>
          </div>
        ))}
      </div>

      <h3 class="text-2xl font-bold text-primary font-display uppercase mt-10 mb-4">Common Issues Retaining Walls Solve</h3>
      <div class="grid md:grid-cols-2 gap-4 mb-8">
        {[
          { icon: 'fa-mountain', title: 'Erosion Control', desc: 'Prevent soil erosion on sloped properties, especially during heavy rainfall' },
          { icon: 'fa-droplet', title: 'Drainage Management', desc: 'Control water flow and prevent flooding or water damage' },
          { icon: 'fa-shield-halved', title: 'Property Protection', desc: 'Protect buildings and structures from soil movement' },
          { icon: 'fa-tree', title: 'Landscaping Enhancement', desc: 'Create level areas for patios, gardens, or other features' },
          { icon: 'fa-expand', title: 'Increased Usable Space', desc: 'Create flat, usable areas on sloped properties' },
          { icon: 'fa-triangle-exclamation', title: 'Safety', desc: 'Prevent dangerous slope failures that could cause injury' }
        ].map(item => (
          <div class="flex items-start gap-4 p-4 bg-gray-50 rounded-lg">
            <div class="w-10 h-10 bg-primary/10 rounded-full flex items-center justify-center flex-shrink-0">
              <i class={`fa-solid ${item.icon} text-primary`}></i>
            </div>
            <div>
              <h4 class="font-bold">{item.title}</h4>
              <p class="text-gray-600 text-sm">{item.desc}</p>
            </div>
          </div>
        ))}
      </div>

      <h3 class="text-2xl font-bold text-primary font-display uppercase mt-10 mb-4">Investment Factors</h3>
      <div class="bg-gray-50 rounded-lg p-6 mb-8">
        <p class="text-gray-600 mb-4">Understanding what affects your retaining wall investment:</p>
        <ul class="space-y-2">
          {[
            'Wall Height - Taller walls require more materials and deeper foundations',
            'Wall Length - Longer walls require more materials and labor',
            'Soil Conditions - Challenging soil may require additional reinforcement',
            'Drainage Requirements - Water issues may need more extensive drainage systems',
            'Reinforcement Needs - Taller walls require more reinforcement',
            'Accessibility - Difficult access may require special equipment'
          ].map(factor => (
            <li class="flex items-start gap-2">
              <i class="fa-solid fa-info-circle text-primary mt-1"></i>
              <span>{factor}</span>
            </li>
          ))}
        </ul>
      </div>

      <h3 class="text-2xl font-bold text-primary font-display uppercase mt-10 mb-4">Areas We Serve</h3>
      <p class="text-gray-600 mb-6">
        We provide retaining wall installation services throughout <a href="/locations/deptford-nj" class="text-primary font-semibold hover:underline">Deptford</a>, <a href="/locations/west-deptford-nj" class="text-primary font-semibold hover:underline">West Deptford</a>, <a href="/locations/woodbury-nj" class="text-primary font-semibold hover:underline">Woodbury</a>, <a href="/locations/glassboro-nj" class="text-primary font-semibold hover:underline">Glassboro</a>, and <a href="/locations" class="text-primary font-semibold hover:underline">all surrounding Gloucester County communities</a>.
      </p>
    </div>
  </section>

  <RelatedServices currentService="retaining-walls" />
  <ServiceAreasLink serviceName="Retaining Walls" />

  <!-- Contact Form Section -->
  <section id="contact-form" class="py-16 md:py-24 bg-gray-50">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
      <ContactForm title="Get Your Free Retaining Wall Estimate" service="retaining-walls" />
    </div>
  </section>

  <!-- FAQ Section -->
  <section class="py-16 md:py-24 bg-white">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-12">
        <p class="section-subheading text-primary mb-4">Common Questions</p>
        <h2 class="section-heading">Retaining Wall FAQs</h2>
      </div>
      <div class="space-y-4">
        {faqs.map(faq => (
          <div class="bg-gray-50 rounded-xl p-6 border-l-4 border-primary">
            <h3 class="font-bold text-lg text-gray-900 mb-2">{faq.q}</h3>
            <p class="text-gray-600">{faq.a}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA Section -->
  <section class="py-16 md:py-20 bg-primary">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="text-3xl md:text-4xl font-bold text-white font-display uppercase mb-6">
        Need a Retaining Wall?
      </h2>
      <p class="text-xl text-white/90 mb-8">
        Contact us today for a free estimate. No obligation, just honest pricing.
      </p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a href="#contact-form" class="btn-secondary">Get Your Free Estimate <i class="fa-solid fa-arrow-right"></i></a>
        {SITE_CONFIG.phone && <a href={`tel:${SITE_CONFIG.phone}`} class="btn-outline"><i class="fa-solid fa-phone"></i> {SITE_CONFIG.phone}</a>}
      </div>
    </div>
  </section>
</BaseLayout>
