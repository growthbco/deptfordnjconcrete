---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ContactForm from '../../components/ContactForm.astro';
import RelatedServices from '../../components/RelatedServices.astro';
import ServiceAreasLink from '../../components/ServiceAreasLink.astro';
import { SITE_CONFIG } from '../../config';
import { generateServiceSchema } from '../../utils/schema';

const serviceSchema = generateServiceSchema('pool-decks', 'Professional concrete pool deck installation and repair in Deptford, NJ. Slip-resistant pool decking with decorative options. Free estimates.');

const galleryImages = [
  { src: '/images/projects/IMG_7649.webp', alt: 'Concrete pool deck installation in Deptford, NJ', label: 'Pool Deck Installation' },
  { src: '/images/projects/IMG_7653.webp', alt: 'Stamped pool deck project', label: 'Stamped Pool Deck' },
  { src: '/images/projects/IMG_7654.webp', alt: 'Decorative pool decking', label: 'Decorative Decking' },
  { src: '/images/projects/IMG_7655.webp', alt: 'Professional pool deck work', label: 'Professional Installation' },
  { src: '/images/projects/IMG_7656.webp', alt: 'Slip-resistant pool deck', label: 'Slip-Resistant Surface' },
  { src: '/images/projects/IMG_7657.webp', alt: 'Pool deck repair service', label: 'Pool Deck Repair' }
];

const faqs = [
  { q: 'How much does a concrete pool deck cost?', a: 'Concrete pool deck costs typically range from $8-$15 per square foot, depending on size, design options, and complexity. Stamped or stained options cost more. We provide free estimates for accurate pricing.' },
  { q: 'Are concrete pool decks slip-resistant?', a: 'Yes! We use textured finishes specifically designed for pool areas to provide excellent slip resistance when wet. This is a critical safety feature for pool decks.' },
  { q: 'Can you repair an existing pool deck?', a: 'Yes, we can often repair or resurface existing pool decks. We\'ll assess your deck during the free estimate and recommend repair or replacement based on the condition.' },
  { q: 'How long does pool deck installation take?', a: 'Most pool deck installations are completed within 2-3 days, depending on size and design complexity. We\'ll provide a detailed timeline during your free estimate.' },
  { q: 'Do pool decks need special sealers?', a: 'Yes, pool decks benefit from sealers that resist water and pool chemicals. We use appropriate sealers designed for pool deck applications.' }
];
---

<BaseLayout
  title="Concrete Pool Deck Installation & Repair in Deptford, NJ"
  description="Expert concrete pool deck contractors in Deptford, NJ. Slip-resistant pool deck installation, repair, and resurfacing. Stamped and decorative pool deck options available."
  schema={serviceSchema}
>
  <!-- Hero Section -->
  <section class="bg-dark py-20 md:py-28">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <p class="section-subheading text-primary mb-4">Pool Deck Services</p>
      <h1 class="text-4xl md:text-5xl lg:text-6xl font-bold text-white uppercase font-display mb-6">
        Concrete Pool Deck Installation & Repair
      </h1>
      <p class="text-xl text-gray-300 max-w-3xl mx-auto mb-8">
        Professional pool deck installation and repair services. Durable, slip-resistant concrete pool decking perfect for your pool area.
      </p>
      <a href="#contact-form" class="btn-primary text-lg">
        Get Free Pool Deck Estimate
        <i class="fa-solid fa-arrow-right"></i>
      </a>
    </div>
  </section>

  <!-- Gallery Section -->
  <section class="py-16 md:py-24 bg-gray-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-12">
        <p class="section-subheading text-primary mb-4">Our Work</p>
        <h2 class="section-heading mb-6">Our Pool Deck Projects</h2>
        <p class="text-lg text-gray-600 max-w-3xl mx-auto">
          See our quality pool deck installations throughout Deptford and surrounding areas.
        </p>
      </div>

      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
        {galleryImages.map(image => (
          <div class="group relative aspect-[4/3] rounded-xl overflow-hidden shadow-lg hover:shadow-2xl transition-all hover:-translate-y-2">
            <img src={image.src} alt={image.alt} loading="lazy" class="w-full h-full object-cover" width="800" height="600" />
            <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/20 to-transparent opacity-0 group-hover:opacity-100 transition-opacity flex items-end p-4">
              <p class="text-white font-semibold">{image.label}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Content Section -->
  <section class="py-16 md:py-24 bg-white">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-3xl md:text-4xl font-bold text-gray-900 font-display uppercase mb-8">
        Professional Pool Deck Services
      </h2>
      <p class="text-lg text-gray-600 mb-8">
        Your pool deck is one of the most important features of your pool area. We provide professional concrete pool deck installation and repair services that combine safety, durability, and beautiful design. Our pool decks are slip-resistant, easy to maintain, and built to withstand years of pool use.
      </p>

      <h3 class="text-2xl font-bold text-primary font-display uppercase mt-10 mb-4">Why Choose Concrete for Pool Decks?</h3>
      <div class="grid md:grid-cols-2 gap-4 mb-8">
        {[
          { icon: 'fa-person-walking', title: 'Slip-Resistant', desc: 'Textured finishes provide excellent traction even when wet' },
          { icon: 'fa-shield-halved', title: 'Durable', desc: 'Withstands constant exposure to water, chemicals, and sun' },
          { icon: 'fa-broom', title: 'Low Maintenance', desc: 'Easy to clean and maintain compared to other materials' },
          { icon: 'fa-temperature-half', title: 'Cool Surface', desc: 'Concrete stays cooler than other materials in hot weather' },
          { icon: 'fa-palette', title: 'Design Options', desc: 'Choose from smooth, textured, stamped, or stained finishes' },
          { icon: 'fa-dollar-sign', title: 'Cost-Effective', desc: 'More affordable than natural stone or pavers' }
        ].map(benefit => (
          <div class="flex items-start gap-4 p-4 bg-gray-50 rounded-lg">
            <div class="w-10 h-10 bg-primary/10 rounded-full flex items-center justify-center flex-shrink-0">
              <i class={`fa-solid ${benefit.icon} text-primary`}></i>
            </div>
            <div>
              <h4 class="font-bold">{benefit.title}</h4>
              <p class="text-gray-600 text-sm">{benefit.desc}</p>
            </div>
          </div>
        ))}
      </div>

      <h3 class="text-2xl font-bold text-primary font-display uppercase mt-10 mb-4">Pool Deck Services We Provide</h3>
      <div class="bg-orange-50 border-l-4 border-primary rounded-lg p-6 mb-8">
        <ul class="space-y-2">
          {[
            'New Pool Deck Installation - Complete installation for new pools or deck replacement',
            'Pool Deck Repair - Repair cracks, spalling, and damage in existing decks',
            'Pool Deck Resurfacing - Resurface worn decks with overlay systems',
            'Stamped Pool Decks - Decorative stamped concrete with beautiful patterns',
            'Stained Pool Decks - Custom colors to match your pool and landscaping',
            'Pool Deck Expansion - Expand existing decks for more space',
            'Drainage Solutions - Proper drainage to prevent water pooling'
          ].map(item => (
            <li class="flex items-start gap-2">
              <i class="fa-solid fa-check-circle text-primary mt-1"></i>
              <span>{item}</span>
            </li>
          ))}
        </ul>
      </div>

      <h3 class="text-2xl font-bold text-primary font-display uppercase mt-10 mb-4">Our Installation Process</h3>
      <div class="space-y-4 mb-8">
        {[
          { num: '1', title: 'Design Consultation', desc: 'We discuss your vision and design your pool deck' },
          { num: '2', title: 'Site Evaluation', desc: 'Assessment of your pool area, drainage, and requirements' },
          { num: '3', title: 'Site Preparation', desc: 'Proper excavation and base preparation' },
          { num: '4', title: 'Concrete Pouring', desc: 'Placement of high-quality concrete mix' },
          { num: '5', title: 'Texturing', desc: 'Application of slip-resistant texture' },
          { num: '6', title: 'Sealing', desc: 'Professional sealing to protect your investment' }
        ].map(step => (
          <div class="flex items-start gap-4 bg-gray-50 rounded-lg p-4">
            <div class="w-10 h-10 bg-primary text-white rounded-full flex items-center justify-center font-bold flex-shrink-0">{step.num}</div>
            <div>
              <h4 class="font-bold text-lg">{step.title}</h4>
              <p class="text-gray-600">{step.desc}</p>
            </div>
          </div>
        ))}
      </div>

      <h3 class="text-2xl font-bold text-primary font-display uppercase mt-10 mb-4">Pool Deck Design Options</h3>
      <div class="grid md:grid-cols-2 gap-4 mb-8">
        {[
          { title: 'Standard Textured', desc: 'Brushed or broom finish for slip resistance', link: null },
          { title: 'Stamped Concrete', desc: 'Decorative patterns mimicking stone or tile', link: '/services/stamped-concrete' },
          { title: 'Stained Concrete', desc: 'Custom colors to match your pool area', link: '/services/stained-concrete' },
          { title: 'Exposed Aggregate', desc: 'Decorative aggregate finishes', link: null }
        ].map(style => (
          <div class="bg-gray-50 rounded-lg p-4 border-l-4 border-primary">
            <h4 class="font-bold mb-1">{style.title}</h4>
            <p class="text-gray-600 text-sm">{style.desc}</p>
            {style.link && <a href={style.link} class="text-primary text-sm font-semibold hover:underline">Learn more →</a>}
          </div>
        ))}
      </div>

      <h3 class="text-2xl font-bold text-primary font-display uppercase mt-10 mb-4">Areas We Serve</h3>
      <p class="text-gray-600 mb-6">
        We provide pool deck services throughout <a href="/locations/deptford-nj" class="text-primary font-semibold hover:underline">Deptford</a>, <a href="/locations/west-deptford-nj" class="text-primary font-semibold hover:underline">West Deptford</a>, <a href="/locations/woodbury-nj" class="text-primary font-semibold hover:underline">Woodbury</a>, <a href="/locations/glassboro-nj" class="text-primary font-semibold hover:underline">Glassboro</a>, and <a href="/locations" class="text-primary font-semibold hover:underline">all surrounding Gloucester County communities</a>.
      </p>
    </div>
  </section>

  <RelatedServices currentService="pool-decks" />
  <ServiceAreasLink serviceName="Pool Decks" />

  <!-- Contact Form Section -->
  <section id="contact-form" class="py-16 md:py-24 bg-gray-50">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
      <ContactForm title="Get Your Free Pool Deck Estimate" service="pool-decks" />
    </div>
  </section>

  <!-- FAQ Section -->
  <section class="py-16 md:py-24 bg-white">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-12">
        <p class="section-subheading text-primary mb-4">Common Questions</p>
        <h2 class="section-heading">Pool Deck FAQs</h2>
      </div>
      <div class="space-y-4">
        {faqs.map(faq => (
          <div class="bg-gray-50 rounded-xl p-6 border-l-4 border-primary">
            <h3 class="font-bold text-lg text-gray-900 mb-2">{faq.q}</h3>
            <p class="text-gray-600">{faq.a}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA Section -->
  <section class="py-16 md:py-20 bg-primary">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="text-3xl md:text-4xl font-bold text-white font-display uppercase mb-6">
        Ready for a New Pool Deck?
      </h2>
      <p class="text-xl text-white/90 mb-8">
        Contact us today for a free estimate. No obligation, just honest pricing.
      </p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a href="#contact-form" class="btn-secondary">Get Your Free Estimate <i class="fa-solid fa-arrow-right"></i></a>
        {SITE_CONFIG.phone && <a href={`tel:${SITE_CONFIG.phone}`} class="btn-outline"><i class="fa-solid fa-phone"></i> {SITE_CONFIG.phone}</a>}
      </div>
    </div>
  </section>
</BaseLayout>
