---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ContactForm from '../../components/ContactForm.astro';
import RelatedServices from '../../components/RelatedServices.astro';
import ServiceAreasLink from '../../components/ServiceAreasLink.astro';
import { SITE_CONFIG } from '../../config';
import { generateServiceSchema, generateBreadcrumbSchema, generateFAQSchema } from '../../utils/schema';

const serviceSchema = generateServiceSchema('concrete-slabs', 'Large commercial and industrial concrete slab installation in Deptford, NJ. Professional slab contractors for warehouses, manufacturing facilities, and commercial buildings. Free estimates.');

const breadcrumbSchema = generateBreadcrumbSchema([
  { name: 'Home', url: 'https://deptfordnjconcrete.com/' },
  { name: 'Services', url: 'https://deptfordnjconcrete.com/services/' },
  { name: 'Concrete Slabs', url: 'https://deptfordnjconcrete.com/services/concrete-slabs/' }
]);

const galleryImages = [
  { src: '/images/projects/IMG_3910.webp', alt: 'Commercial concrete slab installation in Deptford, NJ', label: 'Commercial Slab' },
  { src: '/images/projects/IMG_3911.webp', alt: 'Industrial concrete slab project', label: 'Industrial Slab' },
  { src: '/images/projects/IMG_5125.webp', alt: 'Large concrete slab installation', label: 'Large Slab Project' },
  { src: '/images/projects/IMG_5126.webp', alt: 'Concrete slab contractor work', label: 'Professional Installation' },
  { src: '/images/projects/IMG_5164.webp', alt: 'Commercial concrete floor', label: 'Commercial Floor' },
  { src: '/images/projects/IMG_5165.webp', alt: 'Concrete slab project', label: 'Quality Workmanship' }
];

const faqs = [
  { q: 'How thick should a commercial concrete slab be?', a: 'Slab thickness depends on load requirements, soil conditions, and local codes. Most commercial slabs range from 4-6 inches, while heavy-duty industrial slabs may be 6-8 inches or thicker. We\'ll determine the appropriate thickness during your free estimate.' },
  { q: 'How long does large slab installation take?', a: 'Large concrete slab projects typically take 3-7 days depending on size, complexity, and weather conditions. We\'ll provide a detailed timeline during your free estimate.' },
  { q: 'Do commercial slabs need reinforcement?', a: 'Most commercial and industrial slabs require reinforcement (rebar or wire mesh) to handle loads and prevent cracking. The type and amount of reinforcement depends on your specific application and load requirements.' },
  { q: 'What\'s the difference between a foundation slab and a floor slab?', a: 'Foundation slabs support the building structure and must meet specific structural requirements. Floor slabs are interior surfaces that may have different requirements. We\'ll design the appropriate slab type for your needs.' },
  { q: 'Do I need a vapor barrier under my concrete slab?', a: 'Vapor barriers are often required for interior slabs or in areas with high moisture. We\'ll assess your specific situation and install a vapor barrier if needed to prevent moisture issues.' }
];

const faqSchema = generateFAQSchema(faqs);
---

<BaseLayout
  title="Large Concrete Slab Installation in Deptford, NJ | Commercial & Industrial"
  description="Professional large concrete slab installation for commercial and industrial projects in Deptford, NJ. Free estimates on all slab projects."
  schema={[serviceSchema, faqSchema, breadcrumbSchema]}
>
  <!-- Hero Section -->
  <section class="bg-dark py-20 md:py-28">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <p class="section-subheading text-primary mb-4">Commercial & Industrial</p>
      <h1 class="text-4xl md:text-5xl lg:text-6xl font-bold text-white uppercase font-display mb-6">
        Large Concrete Slab Installation
      </h1>
      <p class="text-xl text-gray-300 max-w-3xl mx-auto mb-8">
        Commercial and industrial concrete slab specialists serving Deptford and surrounding areas. Free estimates on all large slab projects.
      </p>
      <a href="#contact-form" class="btn-primary text-lg">
        Get Free Slab Estimate
        <i class="fa-solid fa-arrow-right"></i>
      </a>
    </div>
  </section>

  <!-- Gallery Section -->
  <section class="py-16 md:py-24 bg-gray-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-12">
        <p class="section-subheading text-primary mb-4">Our Work</p>
        <h2 class="section-heading mb-6">Our Concrete Slab Projects</h2>
        <p class="text-lg text-gray-600 max-w-3xl mx-auto">
          See our quality commercial and industrial concrete slab installations throughout Deptford and surrounding areas.
        </p>
      </div>

      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
        {galleryImages.map(image => (
          <div class="group relative aspect-[4/3] rounded-xl overflow-hidden shadow-lg hover:shadow-2xl transition-all hover:-translate-y-2">
            <img src={image.src} alt={image.alt} loading="lazy" class="w-full h-full object-cover" width="800" height="600" />
            <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/20 to-transparent opacity-0 group-hover:opacity-100 transition-opacity flex items-end p-4">
              <p class="text-white font-semibold">{image.label}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Content Section -->
  <section class="py-16 md:py-24 bg-white">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-3xl md:text-4xl font-bold text-gray-900 font-display uppercase mb-8">
        Commercial & Industrial Concrete Slabs
      </h2>
      <p class="text-lg text-gray-600 mb-8">
        We specialize in large-scale concrete slab installation for commercial and industrial applications throughout Deptford, West Deptford, Woodbury, and surrounding Gloucester County communities. From warehouse floors to manufacturing facility foundations, we handle projects of all sizes with precision and efficiency.
      </p>

      <h3 class="text-2xl font-bold text-primary font-display uppercase mt-10 mb-4">Types of Concrete Slabs We Install</h3>
      <div class="grid md:grid-cols-2 gap-4 mb-8">
        {[
          { title: 'Commercial Building Slabs', desc: 'Foundation slabs for retail, office, and commercial structures' },
          { title: 'Industrial Floor Slabs', desc: 'Heavy-duty floors for warehouses and manufacturing' },
          { title: 'Warehouse Floors', desc: 'High-load capacity floors for storage and logistics' },
          { title: 'Garage Slabs', desc: 'Commercial garage and service bay concrete floors' },
          { title: 'Reinforced Slabs', desc: 'Rebar reinforcement for enhanced strength' }
        ].map(type => (
          <div class="bg-gray-50 rounded-lg p-4 border-l-4 border-primary">
            <h4 class="font-bold mb-1">{type.title}</h4>
            <p class="text-gray-600 text-sm">{type.desc}</p>
          </div>
        ))}
      </div>

      <h3 class="text-2xl font-bold text-primary font-display uppercase mt-10 mb-4">What's Included in Our Slab Service</h3>
      <div class="bg-orange-50 border-l-4 border-primary rounded-lg p-6 mb-8">
        <ul class="space-y-2">
          {[
            'Free Site Evaluation - We assess your property, soil conditions, and load requirements at no cost',
            'Custom Slab Design - Design that meets structural requirements and local building codes',
            'Permit Assistance - We help navigate the permit process for commercial projects',
            'Professional Site Preparation - Proper excavation, subgrade compaction, and base preparation',
            'Vapor Barrier Installation - When required, proper vapor barrier for moisture prevention',
            'Reinforcement Placement - Appropriate rebar or wire mesh based on load requirements',
            'Quality Concrete - High-grade concrete mixes for your specific application',
            'Expert Installation - Skilled installation by experienced concrete professionals',
            'Proper Finishing - Surface finishing appropriate for your intended use',
            'Code Compliance - All work meets or exceeds local building codes',
            'Cleanup - Complete site cleanup after installation'
          ].map(item => (
            <li class="flex items-start gap-2">
              <i class="fa-solid fa-check-circle text-primary mt-1"></i>
              <span>{item}</span>
            </li>
          ))}
        </ul>
      </div>

      <h3 class="text-2xl font-bold text-primary font-display uppercase mt-10 mb-4">Our Slab Installation Process</h3>
      <div class="space-y-4 mb-8">
        {[
          { num: '1', title: 'Site Evaluation', desc: 'We assess soil conditions, drainage, load requirements, and local building codes' },
          { num: '2', title: 'Design & Planning', desc: 'We create a slab design meeting structural requirements and local codes' },
          { num: '3', title: 'Permit Assistance', desc: 'We help secure necessary permits for commercial and industrial projects' },
          { num: '4', title: 'Site Preparation', desc: 'Professional excavation and subgrade preparation for proper foundation' },
          { num: '5', title: 'Reinforcement', desc: 'Placement of rebar or wire mesh based on load requirements' },
          { num: '6', title: 'Concrete Pouring', desc: 'Placement of high-quality concrete mix appropriate for your application' },
          { num: '7', title: 'Finishing & Curing', desc: 'Proper finishing and curing time for maximum strength and durability' }
        ].map(step => (
          <div class="flex items-start gap-4 bg-gray-50 rounded-lg p-4">
            <div class="w-10 h-10 bg-primary text-white rounded-full flex items-center justify-center font-bold flex-shrink-0">{step.num}</div>
            <div>
              <h4 class="font-bold text-lg">{step.title}</h4>
              <p class="text-gray-600">{step.desc}</p>
            </div>
          </div>
        ))}
      </div>

      <h3 class="text-2xl font-bold text-primary font-display uppercase mt-10 mb-4">Common Issues Large Slabs Solve</h3>
      <div class="grid md:grid-cols-2 gap-4 mb-8">
        {[
          { icon: 'fa-weight-hanging', title: 'Heavy Load Support', desc: 'Properly designed slabs support heavy equipment and storage loads' },
          { icon: 'fa-shield-halved', title: 'Durability', desc: 'Industrial applications require durable surfaces for constant use' },
          { icon: 'fa-ruler-horizontal', title: 'Level Surface', desc: 'Manufacturing and warehouse operations require level, stable surfaces' },
          { icon: 'fa-droplet-slash', title: 'Moisture Control', desc: 'Proper slab design prevents moisture damage to goods or equipment' },
          { icon: 'fa-file-contract', title: 'Code Compliance', desc: 'Commercial projects must meet strict building code requirements' },
          { icon: 'fa-dollar-sign', title: 'Long-Term Value', desc: 'Quality installation reduces maintenance costs over time' }
        ].map(item => (
          <div class="flex items-start gap-4 p-4 bg-gray-50 rounded-lg">
            <div class="w-10 h-10 bg-primary/10 rounded-full flex items-center justify-center flex-shrink-0">
              <i class={`fa-solid ${item.icon} text-primary`}></i>
            </div>
            <div>
              <h4 class="font-bold">{item.title}</h4>
              <p class="text-gray-600 text-sm">{item.desc}</p>
            </div>
          </div>
        ))}
      </div>

      <h3 class="text-2xl font-bold text-primary font-display uppercase mt-10 mb-4">Areas We Serve</h3>
      <p class="text-gray-600 mb-6">
        We provide large concrete slab installation services throughout <a href="/locations/deptford-nj" class="text-primary font-semibold hover:underline">Deptford</a>, <a href="/locations/west-deptford-nj" class="text-primary font-semibold hover:underline">West Deptford</a>, <a href="/locations/woodbury-nj" class="text-primary font-semibold hover:underline">Woodbury</a>, <a href="/locations/glassboro-nj" class="text-primary font-semibold hover:underline">Glassboro</a>, and <a href="/locations" class="text-primary font-semibold hover:underline">all surrounding Gloucester County communities</a>.
      </p>
    </div>
  </section>

  <RelatedServices currentService="concrete-slabs" />
  <ServiceAreasLink serviceName="Concrete Slabs" />

  <!-- Contact Form Section -->
  <section id="contact-form" class="py-16 md:py-24 bg-gray-50">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
      <ContactForm title="Get Your Free Concrete Slab Estimate" service="concrete-slabs" />
    </div>
  </section>

  <!-- FAQ Section -->
  <section class="py-16 md:py-24 bg-white">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-12">
        <p class="section-subheading text-primary mb-4">Common Questions</p>
        <h2 class="section-heading">Concrete Slab FAQs</h2>
      </div>
      <div class="space-y-4">
        {faqs.map(faq => (
          <div class="bg-gray-50 rounded-xl p-6 border-l-4 border-primary">
            <h3 class="font-bold text-lg text-gray-900 mb-2">{faq.q}</h3>
            <p class="text-gray-600">{faq.a}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA Section -->
  <section class="py-16 md:py-20 bg-primary">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="text-3xl md:text-4xl font-bold text-white font-display uppercase mb-6">
        Ready for Your Concrete Slab Project?
      </h2>
      <p class="text-xl text-white/90 mb-8">
        Contact us today for a free estimate. No obligation, just honest pricing.
      </p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a href="#contact-form" class="btn-secondary">Get Your Free Estimate <i class="fa-solid fa-arrow-right"></i></a>
        {SITE_CONFIG.phone && <a href={`tel:${SITE_CONFIG.phone}`} class="btn-outline"><i class="fa-solid fa-phone"></i> {SITE_CONFIG.phone}</a>}
      </div>
    </div>
  </section>
</BaseLayout>
