---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ContactForm from '../../components/ContactForm.astro';
import { SITE_CONFIG } from '../../config';
import servicesData from '../../content/services.json';
import locationDetails from '../../content/location-details.json';
import { generateLocationSchema } from '../../utils/schema';

const location = {
  name: 'Woodbury',
  fullName: 'Woodbury, New Jersey',
  state: 'New Jersey',
  slug: 'woodbury-nj'
};

const primaryServices = servicesData.filter(s => s.primary);
const details = locationDetails['woodbury-nj'];

const localSchema = generateLocationSchema(location.name, location.slug);

const iconMap: Record<string, string> = {
  'pole-barn-foundations': 'fa-warehouse',
  'concrete-slabs': 'fa-layer-group',
  'driveways': 'fa-road',
  'patios': 'fa-umbrella-beach',
  'stamped-concrete': 'fa-stamp',
  'walkways': 'fa-shoe-prints',
  'retaining-walls': 'fa-mountain',
  'basement-flooring': 'fa-house-flood-water'
};
---

<BaseLayout
  title={`Concrete Contractors ${location.name}, NJ | Pole Barn Foundations & More`}
  description={`Professional concrete contractors serving ${location.name}, New Jersey. Specializing in pole barn foundations, driveways, patios, and commercial slabs. Free estimates.`}
  schema={localSchema}
>
  <!-- Hero Section -->
  <section class="bg-dark py-20 md:py-28">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <p class="section-subheading text-primary mb-4">Local Concrete Experts</p>
      <h1 class="text-4xl md:text-5xl lg:text-6xl font-bold text-white uppercase font-display mb-6">
        Concrete Contractors {location.name}, New Jersey
      </h1>
      <p class="text-xl text-gray-300 max-w-3xl mx-auto mb-8">
        Expert concrete contractors specializing in pole barn foundations, commercial slabs, residential driveways, and comprehensive concrete services in {location.fullName}, Gloucester County's historic seat. Free estimates on all projects.
      </p>
      <a href="#contact-form" class="btn-primary text-lg">
        Get Free Estimate in {location.name}
        <i class="fa-solid fa-arrow-right"></i>
      </a>
    </div>
  </section>

  <!-- Introduction Section -->
  <section class="py-16 md:py-24 bg-white">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-3xl md:text-4xl font-bold text-gray-900 font-display uppercase mb-8">
        Professional Concrete Contractors Serving {location.name}, New Jersey
      </h2>

      <h3 class="text-2xl font-bold text-primary font-display uppercase mt-10 mb-4">Serving {location.name} Since 2019</h3>
      <p class="text-gray-600 mb-6">
        Deptford Concrete Contractors has been proudly serving homeowners and businesses throughout {location.name} and the surrounding Gloucester County area since 2019. As the county seat, {location.name} combines historic architecture with modern development needs, creating unique concrete contracting requirements. Our team specializes in durable, high-quality concrete installations built to handle New Jersey's seasonal weather while respecting the city's historic character.
      </p>

      <p class="text-gray-600 mb-8">
        As experienced concrete contractors in {location.name}, we specialize in pole barn foundation installation—our primary expertise—while providing comprehensive concrete services for residential and commercial properties throughout this historic Gloucester County community. {location.name}'s status as county seat means it hosts government buildings, the courthouse, and significant commercial districts that require professional concrete services.
      </p>

      <!-- Why Choose Us Box -->
      <div class="bg-orange-50 border-l-4 border-primary rounded-lg p-6 mb-8">
        <h3 class="text-xl font-bold text-primary font-display uppercase mb-4">Why {location.name} Homeowners Choose Deptford Concrete Contractors</h3>
        <ul class="space-y-3">
          {[
            { title: 'Locally Owned and Operated', desc: `Based in Gloucester County, we understand ${location.name}'s unique historic character and needs` },
            { title: 'Decades of Combined Experience', desc: "Our team has extensive experience with New Jersey soil and weather conditions" },
            { title: 'Historic District Awareness', desc: `We understand preservation considerations when working near ${location.name}'s historic areas` },
            { title: 'Responsive, Reliable Service', desc: 'We respond to estimate requests within 24-48 hours with honest pricing' },
            { title: 'Fully Licensed and Insured', desc: `Professional coverage for residential and commercial projects throughout ${location.name}` },
            { title: 'Pole Barn Foundation Specialists', desc: 'Our primary specialty ensures expert installation for post-frame buildings' }
          ].map(item => (
            <li class="flex items-start gap-3">
              <i class="fa-solid fa-check-circle text-primary mt-1"></i>
              <span><strong>{item.title}:</strong> {item.desc}</span>
            </li>
          ))}
        </ul>
      </div>

      <h3 class="text-2xl font-bold text-primary font-display uppercase mt-10 mb-4">Understanding {location.name}'s Geography and Development</h3>
      <p class="text-gray-600 mb-6">
        {location.name} features a historic downtown district along Broad Street, surrounded by residential neighborhoods and newer developments. As Gloucester County's seat, the city hosts important government buildings including the Gloucester County Courthouse. Major roadways include {details.majorRoads.join(', ')}, providing excellent connectivity for residents and businesses.
      </p>

      <p class="text-gray-600 mb-8">
        Major landmarks in {location.name} include {details.landmarks.join(', ')}. These historic and community centers create ongoing demand for concrete services ranging from foundation work for new construction to repair and restoration of existing concrete. As {location.name} concrete contractors, we're familiar with the city's development patterns and can coordinate projects around historic preservation requirements when applicable.
      </p>

      <h3 class="text-2xl font-bold text-primary font-display uppercase mt-10 mb-4">Traffic Patterns and Project Coordination in {location.name}</h3>
      <p class="text-gray-600 mb-6">
        {details.trafficPatterns} As experienced concrete contractors working throughout {location.name}, we carefully plan project schedules to minimize disruption. The historic downtown area requires special consideration for pedestrian traffic and community events. Broad Street's commercial corridor demands careful coordination with business owners to schedule concrete work during off-peak hours when possible.
      </p>

      <h3 class="text-2xl font-bold text-primary font-display uppercase mt-10 mb-4">Weather Considerations for Concrete Work in {location.name}</h3>
      <p class="text-gray-600 mb-6">
        {details.weatherImpacts} As professional concrete contractors in {location.name}, we understand these weather patterns and plan projects accordingly. Historic properties may require additional protective measures during concrete work to preserve surrounding structures. Freeze-thaw cycles are particularly important for concrete work in established neighborhoods with mature landscaping.
      </p>

      <h3 class="text-2xl font-bold text-primary font-display uppercase mt-10 mb-4">Soil Conditions and Foundation Requirements in {location.name}</h3>
      <p class="text-gray-600 mb-8">
        {details.soilConditions} Before beginning any pole barn foundation or concrete slab project in {location.name}, we conduct thorough site assessments to understand soil composition, drainage patterns, and load-bearing capacity. Historic properties may have older infrastructure requiring special consideration during foundation work.
      </p>
    </div>
  </section>

  <!-- Pole Barn Foundations Section -->
  <section class="py-16 md:py-24 bg-gray-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid lg:grid-cols-2 gap-12 items-center">
        <div>
          <p class="section-subheading text-primary mb-4">Our Specialty</p>
          <h2 class="text-3xl md:text-4xl font-bold text-gray-900 font-display uppercase mb-6">
            Pole Barn Foundation Contractors in {location.name}
          </h2>
          <p class="text-gray-600 mb-6">
            Pole barn foundations are our primary specialty, and we're the go-to concrete contractors for post-frame building projects throughout {location.name} and surrounding areas. While {location.name} is primarily residential and commercial, agricultural and storage pole barns are common in nearby rural areas. If you're planning a pole barn in or near {location.name}, we provide expert foundation installation that meets all structural requirements and local building codes.
          </p>

          <div class="space-y-3 mb-8">
            {[
              'Site Assessment - We evaluate your property\'s soil conditions, drainage, and access requirements',
              'Foundation Design - Custom design meeting Woodbury building codes and structural requirements',
              'Concrete Footing Installation - Professional installation accounting for local soil conditions',
              'Slab-on-Grade Foundations - Complete slab foundations for pole barns',
              'Permit Assistance - We handle all permit applications with Woodbury officials',
              'Reinforcement - Proper rebar installation and concrete mix design'
            ].map(item => (
              <div class="flex items-start gap-3">
                <i class="fa-solid fa-check text-primary mt-1"></i>
                <span class="text-gray-600">{item}</span>
              </div>
            ))}
          </div>

          <a href="/services/pole-barn-foundations" class="btn-primary">
            Learn More About Pole Barn Foundations
            <i class="fa-solid fa-arrow-right"></i>
          </a>
        </div>

        <div class="bg-white rounded-2xl p-8 shadow-xl">
          <h3 class="text-2xl font-bold font-display uppercase mb-6 text-center">Our Primary Services in {location.name}</h3>
          <div class="grid sm:grid-cols-2 gap-4">
            {primaryServices.map(service => (
              <a href={`/locations/${location.slug}/${service.slug}`} class="group flex items-center gap-3 p-4 bg-gray-50 rounded-lg hover:bg-primary/5 transition-colors border-l-4 border-primary">
                <i class={`fa-solid ${iconMap[service.slug] || 'fa-cube'} text-primary`}></i>
                <span class="font-semibold group-hover:text-primary transition-colors">{service.name}</span>
              </a>
            ))}
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Commercial & Residential Services -->
  <section class="py-16 md:py-24 bg-white">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <h3 class="text-2xl font-bold text-primary font-display uppercase mt-4 mb-4">Commercial Concrete Contractors in {location.name}</h3>
      <p class="text-gray-600 mb-6">
        We're experienced commercial concrete contractors handling projects for businesses throughout {location.name}. As Gloucester County's seat, {location.name} hosts government buildings, courthouse facilities, and commercial districts that require professional concrete services.
      </p>

      <div class="grid md:grid-cols-2 gap-4 mb-8">
        {[
          { title: 'Large Commercial Slabs', desc: 'Commercial concrete slabs for businesses' },
          { title: 'Parking Lot Installation', desc: 'Complete parking lot installation and repair' },
          { title: 'Commercial Foundations', desc: 'Structural foundations for commercial buildings' },
          { title: 'Historic District Work', desc: 'Careful concrete work preserving historic character' }
        ].map(item => (
          <div class="bg-gray-50 rounded-lg p-4 border-l-4 border-primary">
            <h4 class="font-bold mb-1">{item.title}</h4>
            <p class="text-gray-600 text-sm">{item.desc}</p>
          </div>
        ))}
      </div>

      <h3 class="text-2xl font-bold text-primary font-display uppercase mt-10 mb-4">Residential Concrete Contractors in {location.name}</h3>
      <p class="text-gray-600 mb-6">
        Our residential concrete contracting services help {location.name} homeowners enhance their properties with durable, beautiful concrete installations. {location.name} neighborhoods range from historic residential areas to newer developments, each with unique concrete needs and sometimes historic preservation considerations.
      </p>

      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-4 mb-8">
        {[
          { title: 'Driveways', link: '/services/driveways', icon: 'fa-road' },
          { title: 'Patios', link: '/services/patios', icon: 'fa-umbrella-beach' },
          { title: 'Stamped Concrete', link: '/services/stamped-concrete', icon: 'fa-stamp' },
          { title: 'Walkways', link: '/services/walkways', icon: 'fa-shoe-prints' },
          { title: 'Retaining Walls', link: '/services/retaining-walls', icon: 'fa-mountain' },
          { title: 'Basement Flooring', link: '/services/basement-flooring', icon: 'fa-house-flood-water' }
        ].map(item => (
          <a href={item.link} class="group flex items-center gap-3 p-4 bg-gray-50 rounded-lg hover:bg-primary/5 transition-colors">
            <i class={`fa-solid ${item.icon} text-primary`}></i>
            <span class="font-semibold group-hover:text-primary transition-colors">{item.title}</span>
            <i class="fa-solid fa-arrow-right text-primary text-sm ml-auto opacity-0 group-hover:opacity-100 transition-opacity"></i>
          </a>
        ))}
      </div>

      <h3 class="text-2xl font-bold text-primary font-display uppercase mt-10 mb-4">{location.name} Building Codes and Permits</h3>
      <p class="text-gray-600 mb-6">
        As {location.name} concrete contractors, we're well-versed in {location.name} building codes and permit requirements. As Gloucester County's seat, {location.name} may have specific requirements for certain projects, particularly those near historic areas. We assist with all permit applications and ensure compliance with city and county regulations.
      </p>

      <h3 class="text-2xl font-bold text-primary font-display uppercase mt-10 mb-4">Major Routes We Serve</h3>
      <p class="text-gray-600 mb-4">As {location.name} concrete contractors, we serve properties along major transportation corridors including:</p>
      <div class="grid md:grid-cols-2 gap-4 mb-8">
        {[
          'Broad Street',
          'Route 45',
          'Delaware Street',
          'Evergreen Avenue',
          'Cooper Street',
          'Downtown Historic District'
        ].map(route => (
          <div class="flex items-center gap-3 p-3 bg-gray-50 rounded-lg">
            <i class="fa-solid fa-road text-primary"></i>
            <span>{route}</span>
          </div>
        ))}
      </div>

      <h3 class="text-2xl font-bold text-primary font-display uppercase mt-10 mb-4">{location.name} & Nearby Areas We Serve</h3>
      <p class="text-gray-600 mb-4">While {location.name} is a primary service area, we also serve surrounding communities including:</p>
      <div class="flex flex-wrap gap-2 mb-8">
        {['Woodbury', 'Woodbury Heights', 'Deptford', 'West Deptford', 'Wenonah', 'Mantua', 'National Park', 'Westville'].map(area => (
          <span class="px-3 py-1 bg-gray-100 rounded-full text-sm font-medium">{area}</span>
        ))}
      </div>

      <h3 class="text-2xl font-bold text-primary font-display uppercase mt-10 mb-4">Contact {location.name} Concrete Contractors Today</h3>
      <p class="text-gray-600 mb-4">
        Ready to start your concrete project in {location.name}, New Jersey? Whether you need a pole barn foundation, a new driveway, a commercial slab, or any other concrete service, Deptford Concrete Contractors has the expertise and local knowledge to deliver exceptional results while respecting {location.name}'s historic character.
      </p>
      <p class="text-gray-600">
        <strong>Looking for a free quote?</strong> Call <a href="tel:856-934-4906" class="text-primary font-semibold hover:underline">856-934-4906</a> or fill out our contact form to schedule your estimate today.
      </p>
    </div>
  </section>

  <!-- Contact Form Section -->
  <section id="contact-form" class="py-16 md:py-24 bg-gray-50">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
      <ContactForm
        title={`Get Your Free Estimate in ${location.name}, NJ`}
        location={location.name}
        service="pole-barn-foundations"
      />
    </div>
  </section>

  <!-- CTA Section -->
  <section class="py-16 md:py-20 bg-primary">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="text-3xl md:text-4xl font-bold text-white font-display uppercase mb-6">
        Ready to Start Your {location.name} Project?
      </h2>
      <p class="text-xl text-white/90 mb-8">
        Contact us today for a free estimate. No obligation, just honest pricing and expert advice.
      </p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a href="#contact-form" class="btn-secondary">
          Get Your Free Estimate
          <i class="fa-solid fa-arrow-right"></i>
        </a>
        {SITE_CONFIG.phone && (
          <a href={`tel:${SITE_CONFIG.phone}`} class="btn-outline">
            <i class="fa-solid fa-phone"></i>
            {SITE_CONFIG.phone}
          </a>
        )}
      </div>
    </div>
  </section>
</BaseLayout>
