---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import ContactForm from '../../../components/ContactForm.astro';
import { SITE_CONFIG } from '../../../config';
import locationsData from '../../../content/locations.json';
import servicesData from '../../../content/services.json';
import locationDetails from '../../../content/location-details.json';
import serviceContentData from '../../../content/service-content.json';
import { generateLocationSchema } from '../../../utils/schema';

export async function getStaticPaths() {
  const locations = locationsData;
  const allServices = servicesData;

  return locations.flatMap(location =>
    allServices.map(service => ({
      params: {
        location: location.slug,
        service: service.slug
      },
      props: {
        location,
        service
      }
    }))
  );
}

const { location, service } = Astro.props;
const details = locationDetails[location.slug] || {};
const sContent = serviceContentData[service.id] || {};
const serviceNote = details.serviceNotes?.[service.id] || '';

// Get other services for interlinking (exclude current)
const otherServices = servicesData.filter(s => s.id !== service.id).slice(0, 6);

// Get nearby locations for interlinking (exclude current)
const nearbyLocations = locationsData.filter(l => l.slug !== location.slug).slice(0, 4);

const pageTitle = `${service.name} in ${location.name}, NJ | ${SITE_CONFIG.name}`;
const pageDescription = `Professional ${service.name.toLowerCase()} services in ${location.fullName}. Licensed & insured contractors serving ${location.name} with quality workmanship. Free estimates available.`;

const localServiceSchema = {
  ...generateLocationSchema(location.name, location.slug),
  name: `${SITE_CONFIG.name} - ${service.name} in ${location.name}`,
  description: `${service.name} services in ${location.fullName}`,
  serviceType: service.name,
  url: `${SITE_CONFIG.url}/locations/${location.slug}/${service.slug}`
};

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: SITE_CONFIG.url },
    { '@type': 'ListItem', position: 2, name: 'Service Areas', item: `${SITE_CONFIG.url}/locations` },
    { '@type': 'ListItem', position: 3, name: location.name, item: `${SITE_CONFIG.url}/locations/${location.slug}` },
    { '@type': 'ListItem', position: 4, name: service.name, item: `${SITE_CONFIG.url}/locations/${location.slug}/${service.slug}` }
  ]
};

// Use real FAQ content from service-content.json for richer schema
const faqs = sContent.faqs || [];
const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.slice(0, 4).map(faq => ({
    '@type': 'Question',
    name: faq.q,
    acceptedAnswer: {
      '@type': 'Answer',
      text: faq.a
    }
  }))
};

// Service-specific images mapping
const serviceImages = {
  'pole-barn-foundations': [
    { src: '/images/polebarns/IMG_6480.webp', alt: `Pole barn foundation installation in ${location.name}, NJ` },
    { src: '/images/polebarns/IMG_6471.webp', alt: `Concrete pole barn foundation in ${location.name}` },
    { src: '/images/polebarns/IMG_9021.webp', alt: `Professional pole barn foundation contractor ${location.name}` }
  ],
  'concrete-slabs': [
    { src: '/images/projects/IMG_3907.webp', alt: `Commercial concrete slab in ${location.name}, NJ` },
    { src: '/images/projects/IMG_5164.webp', alt: `Concrete slab installation ${location.name}` },
    { src: '/images/projects/IMG_3401.webp', alt: `Industrial slab contractor in ${location.name}` }
  ],
  'driveways': [
    { src: '/images/projects/IMG_0973.webp', alt: `Concrete driveway in ${location.name}, NJ` },
    { src: '/images/projects/IMG_0974.webp', alt: `Driveway installation ${location.name}` },
    { src: '/images/projects/IMG_2635.webp', alt: `Professional driveway contractor ${location.name}` }
  ],
  'stamped-concrete': [
    { src: '/images/projects/IMG_7649.webp', alt: `Stamped concrete in ${location.name}, NJ` },
    { src: '/images/projects/IMG_7653.webp', alt: `Decorative stamped concrete ${location.name}` },
    { src: '/images/projects/IMG_7656.webp', alt: `Stamped concrete patio in ${location.name}` }
  ],
  'patios': [
    { src: '/images/projects/IMG_7649.webp', alt: `Concrete patio in ${location.name}, NJ` },
    { src: '/images/projects/IMG_7653.webp', alt: `Patio installation ${location.name}` },
    { src: '/images/projects/IMG_5600.webp', alt: `Backyard patio contractor ${location.name}` }
  ],
  'default': [
    { src: '/images/projects/IMG_3907.webp', alt: `Concrete project in ${location.name}, NJ` },
    { src: '/images/projects/IMG_5164.webp', alt: `Professional concrete work ${location.name}` },
    { src: '/images/projects/IMG_9889.webp', alt: `Concrete contractor in ${location.name}` }
  ]
};

const images = serviceImages[service.id] || serviceImages['default'];
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  schema={localServiceSchema}
>
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

  <!-- Hero Section -->
  <section class="relative bg-dark py-20 md:py-28 overflow-hidden">
    <div class="absolute inset-0 z-0">
      <img
        src={images[0].src}
        alt={images[0].alt}
        class="w-full h-full object-cover opacity-30"
        fetchpriority="high"
      />
      <div class="absolute inset-0 bg-gradient-to-r from-dark via-dark/90 to-dark/70"></div>
    </div>
    <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <!-- Breadcrumb -->
      <nav class="text-sm mb-6">
        <ol class="flex items-center gap-2 text-gray-400">
          <li><a href="/" class="hover:text-white transition">Home</a></li>
          <li><i class="fa-solid fa-chevron-right text-xs"></i></li>
          <li><a href="/locations" class="hover:text-white transition">Locations</a></li>
          <li><i class="fa-solid fa-chevron-right text-xs"></i></li>
          <li><a href={`/locations/${location.slug}`} class="hover:text-white transition">{location.name}</a></li>
          <li><i class="fa-solid fa-chevron-right text-xs"></i></li>
          <li class="text-primary">{service.name}</li>
        </ol>
      </nav>

      <div class="max-w-4xl">
        <p class="text-primary font-bold tracking-wide mb-3 uppercase text-sm flex items-center gap-2">
          <i class="fa-solid fa-location-dot"></i> Serving {location.name}, New Jersey
        </p>
        <h1 class="text-4xl md:text-5xl lg:text-6xl font-bold text-white uppercase font-display mb-6 leading-tight">
          {service.name} in {location.name}, NJ
        </h1>
        <p class="text-xl text-gray-300 mb-8 max-w-2xl">
          Professional {service.name.toLowerCase()} installation and services for residential and commercial properties in {location.fullName}. Licensed, insured, and trusted by your neighbors.
        </p>

        <!-- Trust Signals -->
        <div class="flex flex-wrap gap-6 mb-8 text-white/80 text-sm">
          <div class="flex items-center gap-2">
            <i class="fa-solid fa-shield-halved text-primary"></i>
            <span>Licensed & Insured</span>
          </div>
          <div class="flex items-center gap-2">
            <i class="fa-solid fa-star text-accent"></i>
            <span>5-Star Rated</span>
          </div>
          <div class="flex items-center gap-2">
            <i class="fa-solid fa-clock text-primary"></i>
            <span>Free Estimates</span>
          </div>
        </div>

        <div class="flex flex-col sm:flex-row gap-4">
          <a href="#contact-form" class="inline-flex items-center justify-center gap-2 bg-primary text-white px-8 py-4 rounded font-bold hover:bg-primary-dark transition shadow-lg text-lg">
            Get Free Estimate <i class="fa-solid fa-arrow-right"></i>
          </a>
          {SITE_CONFIG.phone && (
            <a href={`tel:${SITE_CONFIG.phone}`} class="inline-flex items-center justify-center gap-2 bg-white/10 text-white px-8 py-4 rounded font-bold hover:bg-white/20 transition border border-white/20">
              <i class="fa-solid fa-phone"></i> {SITE_CONFIG.phone}
            </a>
          )}
        </div>
      </div>
    </div>
  </section>

  <!-- Local Service Introduction -->
  <section class="py-16 md:py-24 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid lg:grid-cols-2 gap-12 items-center">
        <div>
          <h2 class="text-3xl md:text-4xl font-bold text-gray-900 font-display uppercase mb-6">
            Your Local {service.name} Experts in {location.name}
          </h2>
          {sContent.intro && (
            <p class="text-lg text-gray-600 mb-6">
              {sContent.intro}
            </p>
          )}

          {serviceNote && (
            <div class="bg-orange-50 border-l-4 border-primary rounded-r-lg p-4 mb-6">
              <p class="text-gray-700">
                <strong class="text-primary">{service.name} in {location.name}:</strong> {serviceNote}
              </p>
            </div>
          )}

          {sContent.considerations && (
            <div class="bg-gray-50 border-l-4 border-gray-300 rounded-r-lg p-4 mb-6">
              <p class="text-gray-700">
                <strong class="text-gray-900">Before You Start:</strong> {sContent.considerations}
              </p>
            </div>
          )}

          <div class="grid sm:grid-cols-2 gap-4">
            {sContent.timeline && (
              <div class="flex items-start gap-3 p-3 bg-gray-50 rounded-lg">
                <i class="fa-solid fa-clock text-primary mt-1"></i>
                <div>
                  <span class="font-semibold text-gray-900 block text-sm">Timeline</span>
                  <span class="text-gray-600 text-sm">{sContent.timeline}</span>
                </div>
              </div>
            )}
            {sContent.materials && (
              <div class="flex items-start gap-3 p-3 bg-gray-50 rounded-lg">
                <i class="fa-solid fa-cubes text-primary mt-1"></i>
                <div>
                  <span class="font-semibold text-gray-900 block text-sm">Materials</span>
                  <span class="text-gray-600 text-sm">{sContent.materials}</span>
                </div>
              </div>
            )}
          </div>
        </div>

        <div class="grid grid-cols-2 gap-4">
          {images.slice(0, 2).map((img, i) => (
            <div class={`rounded-xl overflow-hidden shadow-lg ${i === 0 ? 'col-span-2' : ''}`}>
              <img src={img.src} alt={img.alt} loading="lazy" class="w-full h-full object-cover" />
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- Why Choose Us — Service-Specific Benefits -->
  <section class="py-16 md:py-24 bg-gray-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-12">
        <p class="text-primary font-bold tracking-wide mb-3 uppercase text-sm">Why Choose Us</p>
        <h2 class="text-3xl md:text-4xl font-bold text-gray-900 font-display uppercase">
          {service.name} Experts Serving {location.name}
        </h2>
      </div>

      <div class="grid md:grid-cols-2 gap-8">
        {/* Service-specific benefits from service-content.json */}
        {(sContent.benefits || []).map(benefit => (
          <div class="bg-white rounded-xl p-6 shadow-md">
            <div class="w-14 h-14 bg-primary/10 rounded-full flex items-center justify-center mb-4">
              <i class="fa-solid fa-circle-check text-primary text-2xl"></i>
            </div>
            <h3 class="text-xl font-bold mb-3 font-display">{benefit.title}</h3>
            <p class="text-gray-600">{benefit.desc}</p>
          </div>
        ))}

        {/* Location-specific cards */}
        <div class="bg-white rounded-xl p-6 shadow-md">
          <div class="w-14 h-14 bg-primary/10 rounded-full flex items-center justify-center mb-4">
            <i class="fa-solid fa-map-location-dot text-primary text-2xl"></i>
          </div>
          <h3 class="text-xl font-bold mb-3 font-display">Local {location.name} Knowledge</h3>
          <p class="text-gray-600">
            {details.soilConditions || `We understand ${location.name}'s soil conditions and local building codes.`} Our team regularly works near {details.landmarks?.[0] || 'local landmarks'} and throughout {location.name}.
          </p>
        </div>

        <div class="bg-white rounded-xl p-6 shadow-md">
          <div class="w-14 h-14 bg-primary/10 rounded-full flex items-center justify-center mb-4">
            <i class="fa-solid fa-cloud-sun text-primary text-2xl"></i>
          </div>
          <h3 class="text-xl font-bold mb-3 font-display">Built for {location.name} Weather</h3>
          <p class="text-gray-600">
            {details.weatherImpacts || `Our concrete work is designed to withstand New Jersey's freeze-thaw cycles, humid summers, and variable weather conditions.`}
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Our Process — Service-Specific Steps -->
  <section class="py-16 md:py-24 bg-white">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-12">
        <p class="text-primary font-bold tracking-wide mb-3 uppercase text-sm">How It Works</p>
        <h2 class="text-3xl md:text-4xl font-bold text-gray-900 font-display uppercase">
          Our {service.name} Process in {location.name}
        </h2>
      </div>

      <div class="space-y-6">
        {(sContent.process || [
          { title: 'Free Consultation', desc: `Contact us for a free estimate. We'll visit your ${location.name} property to assess your needs and provide a detailed quote.` },
          { title: 'Planning & Permits', desc: `We handle all planning details including permit research for ${location.name}.` },
          { title: 'Site Preparation', desc: `Professional excavation, grading, and base preparation for your ${service.name.toLowerCase()}.` },
          { title: 'Expert Installation', desc: `Our experienced crew installs your ${service.name.toLowerCase()} using quality materials and proven techniques.` },
          { title: 'Finishing & Cleanup', desc: `We complete all finishing work, ensure proper curing, and leave your ${location.name} property clean.` }
        ]).map((step, i) => (
          <div class="flex items-start gap-6 bg-gray-50 rounded-xl p-6">
            <div class="w-12 h-12 bg-primary text-white rounded-full flex items-center justify-center font-bold text-xl flex-shrink-0 font-display">{i + 1}</div>
            <div>
              <h3 class="font-bold text-xl mb-2">{step.title}</h3>
              <p class="text-gray-600">{step.desc}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Project Gallery -->
  <section class="py-16 md:py-24 bg-gray-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-12">
        <p class="text-primary font-bold tracking-wide mb-3 uppercase text-sm">Our Work</p>
        <h2 class="text-3xl md:text-4xl font-bold text-gray-900 font-display uppercase">
          {service.name} Projects
        </h2>
        <p class="text-gray-600 mt-4 max-w-2xl mx-auto">
          Browse our {service.name.toLowerCase()} work throughout Gloucester County including projects near {location.name}.
        </p>
      </div>

      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
        {images.map(img => (
          <div class="group relative aspect-[4/3] rounded-xl overflow-hidden shadow-lg hover:shadow-2xl transition-all hover:-translate-y-1">
            <img src={img.src} alt={img.alt} loading="lazy" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" />
            <div class="absolute inset-0 bg-gradient-to-t from-black/70 via-transparent to-transparent opacity-0 group-hover:opacity-100 transition-opacity flex items-end p-4">
              <p class="text-white font-medium text-sm">{img.alt}</p>
            </div>
          </div>
        ))}
      </div>

      <div class="text-center mt-8">
        <a href="/gallery" class="inline-flex items-center gap-2 text-primary font-bold hover:underline">
          View Full Gallery <i class="fa-solid fa-arrow-right"></i>
        </a>
      </div>
    </div>
  </section>

  <!-- FAQ Section — Service-Specific Questions -->
  <section class="py-16 md:py-24 bg-white">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-12">
        <p class="text-primary font-bold tracking-wide mb-3 uppercase text-sm">Common Questions</p>
        <h2 class="text-3xl md:text-4xl font-bold text-gray-900 font-display uppercase">
          {service.name} FAQs for {location.name}
        </h2>
      </div>

      <div class="space-y-4">
        {(sContent.faqs || []).map(faq => (
          <div class="bg-gray-50 rounded-xl p-6 border-l-4 border-primary">
            <h3 class="font-bold text-lg text-gray-900 mb-2">{faq.q}</h3>
            <p class="text-gray-600">{faq.a}</p>
          </div>
        ))}

        <div class="bg-gray-50 rounded-xl p-6 border-l-4 border-primary">
          <h3 class="font-bold text-lg text-gray-900 mb-2">What areas near {location.name} do you serve?</h3>
          <p class="text-gray-600">We serve {location.name} and all surrounding Gloucester County communities including {nearbyLocations.slice(0, 3).map(l => l.name).join(', ')}, and more. <a href="/locations" class="text-primary font-semibold hover:underline">View all service areas</a>.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Contact Form Section -->
  <section id="contact-form" class="py-16 md:py-24 bg-dark">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid lg:grid-cols-2 gap-12 items-center">
        <div class="text-white">
          <h2 class="text-3xl md:text-4xl font-bold font-display uppercase mb-6">
            Get Your Free {service.name} Estimate in {location.name}
          </h2>
          <p class="text-gray-300 text-lg mb-8">
            Ready to start your {service.name.toLowerCase()} project in {location.name}? Contact us today for a free, no-obligation estimate. We respond within 24-48 hours.
          </p>

          <div class="space-y-4 mb-8">
            <div class="flex items-center gap-4">
              <div class="w-12 h-12 bg-primary/20 rounded-full flex items-center justify-center">
                <i class="fa-solid fa-phone text-primary"></i>
              </div>
              <div>
                <p class="text-gray-400 text-sm">Call Us</p>
                {SITE_CONFIG.phone && <a href={`tel:${SITE_CONFIG.phone}`} class="text-white font-bold text-lg hover:text-primary transition">{SITE_CONFIG.phone}</a>}
              </div>
            </div>
            <div class="flex items-center gap-4">
              <div class="w-12 h-12 bg-primary/20 rounded-full flex items-center justify-center">
                <i class="fa-solid fa-envelope text-primary"></i>
              </div>
              <div>
                <p class="text-gray-400 text-sm">Email Us</p>
                {SITE_CONFIG.email && <a href={`mailto:${SITE_CONFIG.email}`} class="text-white font-bold hover:text-primary transition">{SITE_CONFIG.email}</a>}
              </div>
            </div>
            <div class="flex items-center gap-4">
              <div class="w-12 h-12 bg-primary/20 rounded-full flex items-center justify-center">
                <i class="fa-solid fa-location-dot text-primary"></i>
              </div>
              <div>
                <p class="text-gray-400 text-sm">Serving</p>
                <p class="text-white font-bold">{location.name} & Gloucester County, NJ</p>
              </div>
            </div>
          </div>

          <div class="flex items-center gap-4 text-white/60 text-sm">
            <div class="flex items-center gap-2">
              <i class="fa-solid fa-shield-halved text-primary"></i>
              <span>Licensed & Insured</span>
            </div>
            <div class="flex items-center gap-2">
              <i class="fa-solid fa-star text-accent"></i>
              <span>5-Star Reviews</span>
            </div>
          </div>
        </div>

        <div>
          <ContactForm
            title={`Request Your Free Estimate`}
            location={location.name}
            service={service.id}
          />
        </div>
      </div>
    </div>
  </section>

  <!-- Related Services -->
  <section class="py-16 md:py-24 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-12">
        <p class="text-primary font-bold tracking-wide mb-3 uppercase text-sm">More Services</p>
        <h2 class="text-3xl md:text-4xl font-bold text-gray-900 font-display uppercase">
          Other Services in {location.name}
        </h2>
      </div>

      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
        {otherServices.map(s => (
          <a href={`/locations/${location.slug}/${s.slug}`} class="group bg-gray-50 rounded-xl p-6 hover:bg-primary hover:text-white transition-all duration-300">
            <h3 class="font-bold text-lg mb-2 font-display">{s.name}</h3>
            <p class="text-gray-600 group-hover:text-white/80 text-sm mb-3">{s.description}</p>
            <span class="text-primary group-hover:text-white font-semibold text-sm flex items-center gap-1">
              Learn More <i class="fa-solid fa-arrow-right text-xs"></i>
            </span>
          </a>
        ))}
      </div>

      <div class="text-center mt-8">
        <a href="/services" class="inline-flex items-center gap-2 text-primary font-bold hover:underline">
          View All Services <i class="fa-solid fa-arrow-right"></i>
        </a>
      </div>
    </div>
  </section>

  <!-- Nearby Locations -->
  <section class="py-16 md:py-24 bg-gray-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-12">
        <p class="text-primary font-bold tracking-wide mb-3 uppercase text-sm">Service Areas</p>
        <h2 class="text-3xl md:text-4xl font-bold text-gray-900 font-display uppercase">
          {service.name} in Nearby Areas
        </h2>
      </div>

      <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-4">
        {nearbyLocations.map(loc => (
          <a href={`/locations/${loc.slug}/${service.slug}`} class="group flex items-center gap-3 p-4 bg-white rounded-lg hover:bg-primary hover:text-white transition-all duration-300 shadow-sm">
            <i class="fa-solid fa-location-dot text-primary group-hover:text-white"></i>
            <span class="font-medium">{loc.name}, NJ</span>
          </a>
        ))}
      </div>

      <div class="text-center mt-8">
        <a href="/locations" class="inline-flex items-center gap-2 text-primary font-bold hover:underline">
          View All Service Areas <i class="fa-solid fa-arrow-right"></i>
        </a>
      </div>
    </div>
  </section>

  <!-- Final CTA -->
  <section class="py-16 md:py-20 bg-primary">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="text-3xl md:text-4xl font-bold text-white font-display uppercase mb-6">
        Ready for {service.name} in {location.name}?
      </h2>
      <p class="text-xl text-white/90 mb-8">
        Get your free estimate today. No obligation, just honest pricing from your local concrete contractors.
      </p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a href="#contact-form" class="inline-flex items-center justify-center gap-2 bg-white text-gray-900 px-8 py-4 rounded font-bold hover:bg-gray-100 transition shadow-lg">
          Get Free Estimate <i class="fa-solid fa-arrow-right"></i>
        </a>
        {SITE_CONFIG.phone && (
          <a href={`tel:${SITE_CONFIG.phone}`} class="inline-flex items-center justify-center gap-2 bg-transparent text-white px-8 py-4 rounded font-bold border-2 border-white hover:bg-white hover:text-gray-900 transition">
            <i class="fa-solid fa-phone"></i> {SITE_CONFIG.phone}
          </a>
        )}
      </div>
    </div>
  </section>
</BaseLayout>
