---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ContactForm from '../../components/ContactForm.astro';
import SchemaMarkup from '../../components/SchemaMarkup.astro';
import { SITE_CONFIG } from '../../config';
import servicesData from '../../content/services.json';
import locationDetails from '../../content/location-details.json';
import { generateLocationSchema } from '../../utils/schema';

const location = {
  name: 'Mantua',
  fullName: 'Mantua Township, New Jersey',
  state: 'New Jersey',
  slug: 'mantua-nj'
};

const primaryServices = servicesData.filter(s => s.primary);
const details = locationDetails['mantua-nj'];

const localSchema = generateLocationSchema(location.name, location.slug);

const iconMap: Record<string, string> = {
  'pole-barn-foundations': 'fa-warehouse',
  'concrete-slabs': 'fa-layer-group',
  'driveways': 'fa-road',
  'patios': 'fa-umbrella-beach',
  'stamped-concrete': 'fa-stamp',
  'walkways': 'fa-shoe-prints',
  'retaining-walls': 'fa-mountain',
  'basement-flooring': 'fa-house-flood-water'
};
---

<BaseLayout
  title={`Concrete Contractors ${location.name} Township, NJ | Pole Barn Foundations & More`}
  description={`Professional concrete contractors serving ${location.name} Township, New Jersey. Mix of residential and agricultural areas with rural character. Specializing in pole barn foundations, driveways, patios, and commercial slabs. Free estimates.`}
  schema={localSchema}
>
  <!-- Hero Section -->
  <section class="bg-dark py-20 md:py-28">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <p class="section-subheading text-primary mb-4">Local Concrete Experts</p>
      <h1 class="text-4xl md:text-5xl lg:text-6xl font-bold text-white uppercase font-display mb-6">
        Concrete Contractors {location.name} Township, New Jersey
      </h1>
      <p class="text-xl text-gray-300 max-w-3xl mx-auto mb-8">
        Expert concrete contractors specializing in pole barn foundations, commercial slabs, residential driveways, and comprehensive concrete services in {location.fullName}. Serving this diverse mix of residential and rural properties.
      </p>
      <a href="#contact-form" class="btn-primary text-lg">
        Get Free Estimate in {location.name} Township
        <i class="fa-solid fa-arrow-right"></i>
      </a>
    </div>
  </section>

  <!-- Introduction Section -->
  <section class="py-16 md:py-24 bg-white">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-3xl md:text-4xl font-bold text-gray-900 font-display uppercase mb-8">
        Professional Concrete Contractors Serving {location.name} Township, New Jersey
      </h2>

      <h3 class="text-2xl font-bold text-primary font-display uppercase mt-10 mb-4">Serving {location.name} Township Since 2019</h3>
      <p class="text-gray-600 mb-6">
        Deptford Concrete Contractors has been proudly serving homeowners and businesses throughout {location.name} Township and the surrounding Gloucester County area since 2019. Our team specializes in durable, high-quality concrete installations built to handle New Jersey's seasonal weather—from freezing winters to humid summers. Whether it's a fresh driveway, decorative patio, pole barn foundation, or full-scale commercial slab, we deliver craftsmanship that lasts.
      </p>

      <p class="text-gray-600 mb-8">
        As experienced concrete contractors in {location.name} Township, we specialize in pole barn foundation installation—our primary expertise—while providing comprehensive concrete services for residential, agricultural, and commercial properties throughout this diverse Gloucester County community. {location.name} Township offers a unique mix of residential neighborhoods, agricultural properties, and rural areas, creating excellent opportunities for pole barn construction and diverse concrete contracting needs.
      </p>

      <!-- Why Choose Us Box -->
      <div class="bg-orange-50 border-l-4 border-primary rounded-lg p-6 mb-8">
        <h3 class="text-xl font-bold text-primary font-display uppercase mb-4">Why {location.name} Township Homeowners Choose Deptford Concrete Contractors</h3>
        <ul class="space-y-3">
          {[
            { title: 'Locally Owned and Operated', desc: `Based in Gloucester County, we understand ${location.name} Township's unique rural character and needs` },
            { title: 'Decades of Combined Experience', desc: "Our team has extensive experience with New Jersey soil and weather conditions" },
            { title: 'Responsive, Reliable Service', desc: 'We respond to estimate requests within 24-48 hours with honest pricing' },
            { title: 'Specialized Expertise', desc: 'Skilled in stamped, decorative, and structural concrete work' },
            { title: 'Fully Licensed and Insured', desc: `Professional coverage for residential, agricultural, and commercial projects throughout ${location.name} Township` },
            { title: 'Pole Barn Foundation Specialists', desc: 'Our primary specialty ensures expert installation for post-frame buildings' }
          ].map(item => (
            <li class="flex items-start gap-3">
              <i class="fa-solid fa-check-circle text-primary mt-1"></i>
              <span><strong>{item.title}:</strong> {item.desc}</span>
            </li>
          ))}
        </ul>
      </div>

      <h3 class="text-2xl font-bold text-primary font-display uppercase mt-10 mb-4">Understanding {location.name} Township's Geography and Development</h3>
      <p class="text-gray-600 mb-6">
        {location.name} Township encompasses a diverse mix of residential neighborhoods, agricultural properties, and rural areas. The township is strategically located with access via Route 45, Mantua Boulevard, and Tuckahoe Road. This mix of development types creates excellent opportunities for professional concrete contractors who understand both residential and agricultural project requirements.
      </p>

      <p class="text-gray-600 mb-8">
        Major landmarks in {location.name} Township include {details.landmarks.join(', ')}. The township's rural character and agricultural properties create exceptional demand for pole barn foundations, while growing residential development drives needs for driveways, patios, and other residential concrete services. As {location.name} Township concrete contractors, we're experienced working with diverse property types throughout the area.
      </p>

      <h3 class="text-2xl font-bold text-primary font-display uppercase mt-10 mb-4">Traffic Patterns and Project Coordination in {location.name} Township</h3>
      <p class="text-gray-600 mb-6">
        {details.trafficPatterns} As experienced concrete contractors working throughout {location.name} Township, we carefully plan project schedules to work efficiently in rural areas. For agricultural properties, we coordinate around farm operations and consider equipment access requirements.
      </p>

      <h3 class="text-2xl font-bold text-primary font-display uppercase mt-10 mb-4">Weather Considerations for Concrete Work in {location.name} Township</h3>
      <p class="text-gray-600 mb-6">
        {details.weatherImpacts} As professional concrete contractors in {location.name} Township, we understand these weather patterns and plan projects accordingly. Agricultural areas may have seasonal timing preferences, and we work with property owners to schedule projects during optimal periods.
      </p>

      <h3 class="text-2xl font-bold text-primary font-display uppercase mt-10 mb-4">Soil Conditions and Foundation Requirements in {location.name} Township</h3>
      <p class="text-gray-600 mb-8">
        {details.soilConditions} Before beginning any pole barn foundation or concrete slab project in {location.name} Township, we conduct thorough site assessments to understand soil composition, drainage patterns, and load-bearing capacity. Properties near Mantua Creek may have specific considerations that we address in our designs.
      </p>
    </div>
  </section>

  <!-- Pole Barn Foundations Section -->
  <section class="py-16 md:py-24 bg-gray-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid lg:grid-cols-2 gap-12 items-center">
        <div>
          <p class="section-subheading text-primary mb-4">Our Specialty</p>
          <h2 class="text-3xl md:text-4xl font-bold text-gray-900 font-display uppercase mb-6">
            Pole Barn Foundation Contractors in {location.name} Township
          </h2>
          <p class="text-gray-600 mb-6">
            Pole barn foundations are our primary specialty, and {location.name} Township is an ideal area for pole barn construction. The township's mix of agricultural properties and larger residential lots creates excellent opportunities for pole barns used for agricultural operations, equipment storage, workshops, hobby farms, and more. We provide expert foundation installation that meets all structural requirements and {location.name} Township building codes.
          </p>

          <div class="space-y-3 mb-8">
            {[
              'Site Assessment - We evaluate your property\'s soil conditions, drainage, and access requirements',
              'Foundation Design - Custom design meeting Mantua Township building codes',
              'Concrete Footing Installation - Professional installation accounting for local soil conditions',
              'Slab-on-Grade Foundations - Complete slab foundations for pole barns',
              'Permit Assistance - We handle all permit applications with Mantua Township',
              'Reinforcement - Proper rebar installation and concrete mix design'
            ].map(item => (
              <div class="flex items-start gap-3">
                <i class="fa-solid fa-check text-primary mt-1"></i>
                <span class="text-gray-600">{item}</span>
              </div>
            ))}
          </div>

          <a href="/services/pole-barn-foundations" class="btn-primary">
            Learn More About Pole Barn Foundations
            <i class="fa-solid fa-arrow-right"></i>
          </a>
        </div>

        <div class="bg-white rounded-2xl p-8 shadow-xl">
          <h3 class="text-2xl font-bold font-display uppercase mb-6 text-center">Our Primary Services in {location.name} Township</h3>
          <div class="grid sm:grid-cols-2 gap-4">
            {primaryServices.map(service => (
              <a href={`/locations/${location.slug}/${service.slug}`} class="group flex items-center gap-3 p-4 bg-gray-50 rounded-lg hover:bg-primary/5 transition-colors border-l-4 border-primary">
                <i class={`fa-solid ${iconMap[service.slug] || 'fa-cube'} text-primary`}></i>
                <span class="font-semibold group-hover:text-primary transition-colors">{service.name}</span>
              </a>
            ))}
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Commercial & Residential Services -->
  <section class="py-16 md:py-24 bg-white">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <h3 class="text-2xl font-bold text-primary font-display uppercase mt-4 mb-4">Agricultural and Commercial Concrete Contractors in {location.name} Township</h3>
      <p class="text-gray-600 mb-6">
        We're experienced concrete contractors handling agricultural and commercial projects throughout {location.name} Township. The township's rural character creates demand for agricultural concrete services, from pole barn foundations to equipment pads and farm structures.
      </p>

      <div class="grid md:grid-cols-2 gap-4 mb-8">
        {[
          { title: 'Agricultural Slabs', desc: 'Concrete slabs for agricultural buildings and operations' },
          { title: 'Equipment Pads', desc: 'Heavy-duty pads for farm and commercial equipment' },
          { title: 'Barn Foundations', desc: 'Complete foundation systems for agricultural structures' },
          { title: 'Concrete Repair', desc: 'Repair and resurfacing for agricultural concrete' }
        ].map(item => (
          <div class="bg-gray-50 rounded-lg p-4 border-l-4 border-primary">
            <h4 class="font-bold mb-1">{item.title}</h4>
            <p class="text-gray-600 text-sm">{item.desc}</p>
          </div>
        ))}
      </div>

      <h3 class="text-2xl font-bold text-primary font-display uppercase mt-10 mb-4">Residential Concrete Contractors in {location.name} Township</h3>
      <p class="text-gray-600 mb-6">
        Our residential concrete contracting services help {location.name} Township homeowners enhance their properties with durable, beautiful concrete installations. The township's mix of residential neighborhoods and larger properties creates diverse concrete needs, from driveways to expansive patios and walkways.
      </p>

      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-4 mb-8">
        {[
          { title: 'Driveways', link: '/services/driveways', icon: 'fa-road' },
          { title: 'Patios', link: '/services/patios', icon: 'fa-umbrella-beach' },
          { title: 'Stamped Concrete', link: '/services/stamped-concrete', icon: 'fa-stamp' },
          { title: 'Walkways', link: '/services/walkways', icon: 'fa-shoe-prints' },
          { title: 'Retaining Walls', link: '/services/retaining-walls', icon: 'fa-mountain' },
          { title: 'Basement Flooring', link: '/services/basement-flooring', icon: 'fa-house-flood-water' }
        ].map(item => (
          <a href={item.link} class="group flex items-center gap-3 p-4 bg-gray-50 rounded-lg hover:bg-primary/5 transition-colors">
            <i class={`fa-solid ${item.icon} text-primary`}></i>
            <span class="font-semibold group-hover:text-primary transition-colors">{item.title}</span>
            <i class="fa-solid fa-arrow-right text-primary text-sm ml-auto opacity-0 group-hover:opacity-100 transition-opacity"></i>
          </a>
        ))}
      </div>

      <h3 class="text-2xl font-bold text-primary font-display uppercase mt-10 mb-4">{location.name} Township Building Codes and Permits</h3>
      <p class="text-gray-600 mb-6">
        As {location.name} Township concrete contractors, we're well-versed in township building codes and permit requirements. Many concrete projects in {location.name} Township require permits, especially for pole barn foundations, agricultural structures, and new construction. We assist with all permit applications and ensure compliance with {location.name} Township and Gloucester County regulations.
      </p>

      <h3 class="text-2xl font-bold text-primary font-display uppercase mt-10 mb-4">Common Concrete Issues in South Jersey</h3>
      <p class="text-gray-600 mb-4">
        New Jersey's freeze-thaw cycles, humidity, and occasional flooding can cause concrete cracking, surface spalling, and water drainage problems. At Deptford Concrete Contractors, we use proper grading, expansion joints, and durable concrete mixes to help protect your surfaces year-round.
      </p>
      <div class="grid md:grid-cols-2 gap-4 mb-8">
        {[
          { title: 'Freeze-Thaw Cycles', desc: 'Proper mix design and sealing protect against expansion' },
          { title: 'High Humidity', desc: 'Moisture-resistant concrete formulations' },
          { title: 'Heavy Rainfall', desc: 'Proper grading and drainage to prevent water damage' },
          { title: 'Temperature Extremes', desc: 'Installation timing optimized for New Jersey climate' }
        ].map(item => (
          <div class="flex items-start gap-3">
            <i class="fa-solid fa-shield-check text-primary mt-1"></i>
            <div>
              <span class="font-bold">{item.title}:</span>
              <span class="text-gray-600"> {item.desc}</span>
            </div>
          </div>
        ))}
      </div>

      <h3 class="text-2xl font-bold text-primary font-display uppercase mt-10 mb-4">Major Routes We Serve</h3>
      <p class="text-gray-600 mb-4">As {location.name} Township concrete contractors, we serve properties along major transportation corridors including:</p>
      <div class="grid md:grid-cols-2 gap-4 mb-8">
        {[
          'Route 45',
          'Mantua Boulevard',
          'Tuckahoe Road',
          'Main Street',
          'Wenonah Avenue',
          'Lambs Road'
        ].map(route => (
          <div class="flex items-center gap-3 p-3 bg-gray-50 rounded-lg">
            <i class="fa-solid fa-road text-primary"></i>
            <span>{route}</span>
          </div>
        ))}
      </div>

      <h3 class="text-2xl font-bold text-primary font-display uppercase mt-10 mb-4">{location.name} Township & Nearby Areas We Serve</h3>
      <p class="text-gray-600 mb-4">While {location.name} Township is our primary service area, we also serve surrounding communities including:</p>
      <div class="flex flex-wrap gap-2 mb-8">
        {['Wenonah', 'Deptford', 'Woodbury', 'West Deptford', 'Pitman', 'Glassboro', 'Sewell', 'Washington Township', 'Turnersville', 'Blackwood', 'Mullica Hill', 'Swedesboro'].map(area => (
          <span class="px-3 py-1 bg-gray-100 rounded-full text-sm font-medium">{area}</span>
        ))}
      </div>

      <h3 class="text-2xl font-bold text-primary font-display uppercase mt-10 mb-4">Contact {location.name} Township Concrete Contractors Today</h3>
      <p class="text-gray-600 mb-4">
        Ready to start your concrete project in {location.name} Township, New Jersey? Whether you need a pole barn foundation, a new driveway, an agricultural slab, or any other concrete service, Deptford Concrete Contractors has the expertise and local knowledge to deliver exceptional results.
      </p>
      <p class="text-gray-600">
        <strong>Looking for a free quote?</strong> Call <a href="tel:856-934-4906" class="text-primary font-semibold hover:underline">856-934-4906</a> or fill out our contact form to schedule your estimate today.
      </p>
    </div>
  </section>

  <!-- Contact Form Section -->
  <section id="contact-form" class="py-16 md:py-24 bg-gray-50">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
      <ContactForm
        title={`Get Your Free Estimate in ${location.name} Township, NJ`}
        location={location.name}
        service="pole-barn-foundations"
      />
    </div>
  </section>

  <!-- CTA Section -->
  <section class="py-16 md:py-20 bg-primary">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="text-3xl md:text-4xl font-bold text-white font-display uppercase mb-6">
        Ready to Start Your {location.name} Township Project?
      </h2>
      <p class="text-xl text-white/90 mb-8">
        Contact us today for a free estimate. No obligation, just honest pricing and expert advice.
      </p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a href="#contact-form" class="btn-secondary">
          Get Your Free Estimate
          <i class="fa-solid fa-arrow-right"></i>
        </a>
        {SITE_CONFIG.phone && (
          <a href={`tel:${SITE_CONFIG.phone}`} class="btn-outline">
            <i class="fa-solid fa-phone"></i>
            {SITE_CONFIG.phone}
          </a>
        )}
      </div>
    </div>
  </section>
</BaseLayout>
